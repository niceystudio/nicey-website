---
import '@fontsource-variable/geist';
import { SITE, GA_ID } from '../lib/site';
import '@fontsource-variable/geist-mono';
import '@fontsource/geist-pixel/400.css';
// the Editorial style's display face; the file is only fetched once that style is picked
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import TokenSwitcher from '../components/ui/TokenSwitcher.astro';
import { styles, styleCss, STORAGE_KEY } from '../data/token-presets';
import { links } from '../data/links';
import { founder } from '../data/people';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
// display faces, preloaded so headlines don't re-wrap when the font swaps in (on phones they wrap differently from
// their fallbacks): Geist Pixel for the shipped style, Instrument Serif only when Editorial is remembered
import geistPixelLatin from '@fontsource/geist-pixel/files/geist-pixel-latin-400-normal.woff2?url';
import instrumentSerifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** the page's Markdown twin, for agents */
  markdownHref?: string;
  /** schema.org data for search and AI answers */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** share image, a path under public/ (1200×630); without one, links share as a plain card */
  ogImage?: string;
  /** og:type; articles and case studies pass 'article' */
  ogType?: 'website' | 'article';
}

const { title, description, noindex = false, markdownHref, jsonLd, ogImage, ogType = 'website' } = Astro.props;
// one canonical per page, on the production domain, without a trailing slash (the sitemap spells URLs the same way)
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1'), (Astro.site ?? SITE)).href;
const ogImageUrl = ogImage && new URL(ogImage, (Astro.site ?? SITE)).href;
// "Change the style": the CSS for every style, so the head script can apply a remembered one before first paint
const tokenCss = {
  key: STORAGE_KEY,
  style: Object.fromEntries(styles.slice(1).map((s) => [s.id, styleCss(s)])),
  // a remembered style's display face, when it isn't preloaded already (Product uses Geist Sans)
  font: { editorial: instrumentSerifLatin } as Record<string, string>,
};
const siteUrl = (Astro.site ?? SITE).href;
// Google Analytics (src/lib/track.ts): only on the production deployment and only once GA_ID is set, so previews,
// local builds and Lighthouse CI don't count
const gaId = process.env.VERCEL_ENV === 'production' ? GA_ID : '';
// who we are, said the same way as the footer and the home page; sameAs = the profiles in links.ts
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Nicey Studio',
  url: siteUrl,
  description:
    'A design systems studio for legacy products and teams scaling with agents. We turn drifted UI into one system of tokens, components and documentation that designers, engineers and coding agents read the same way.',
  logo: new URL('/favicon.svg', siteUrl).href,
  sameAs: [links.linkedin, links.github],
  founder: founder,
  knowsAbout: ['Design systems', 'Design tokens', 'Figma variables', 'AI-ready design systems', 'Product design'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Nicey Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistPixelLatin} as="font" type="font/woff2" crossorigin />
    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            // page_location without the query string (keeping utm_*): cal.com forwards the attendee's name and email
            // to /booked in the URL, and personal data must never reach Google Analytics
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            var q = new URLSearchParams(location.search);
            var keep = new URLSearchParams();
            q.forEach(function (v, k) {
              if (k.indexOf('utm_') === 0) keep.set(k, v);
            });
            var s = keep.toString();
            gtag('js', new Date());
            gtag('config', gaId, { page_location: location.origin + location.pathname + (s ? '?' + s : '') });
          </script>
        </>
      )
    }
    <!-- Theme before first paint: stored choice, else the system preference. -->
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('nicey-theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <!-- "Change the style" before first paint: a remembered style (src/data/token-presets.ts). -->
    <script is:inline define:vars={{ tokenCss }}>
      (function () {
        var v = null;
        try {
          v = JSON.parse(localStorage.getItem(tokenCss.key) || 'null');
        } catch (e) {}
        var css = (v && tokenCss.style[v.style]) || '';
        var el = document.createElement('style');
        el.id = 'token-override';
        el.textContent = css;
        document.head.appendChild(el);
        var font = v && tokenCss.font[v.style];
        if (font) {
          var l = document.createElement('link');
          l.rel = 'preload';
          l.as = 'font';
          l.type = 'font/woff2';
          l.crossOrigin = '';
          l.href = font;
          document.head.appendChild(l);
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <TokenSwitcher />
  </body>
</html>
