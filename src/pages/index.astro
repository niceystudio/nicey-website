---
/** The start page of this review branch: the five homepage design directions. Each opens on its own page
 *  (/lab/<letter>, noindex); the Direction switch bottom-right moves between them. */
import Base from '../layouts/Base.astro';

const directions = [
  { id: 'A', name: 'Select', href: '/lab/a', picked: true, note: 'Terminal, ASCII and dither. Pixel headings, square shapes, keyboard-key buttons.' },
  { id: 'B', name: 'Editorial', href: '/lab/b', note: 'Serif headings with italic turns, mono body, soft plates and film grain.' },
  { id: 'C', name: 'Human | Machine', href: '/lab/c', note: 'Condensed capitals, stepped pixel bands, a Human | Machine switch.' },
  { id: 'D', name: 'Clean', href: '/lab/d', note: 'A light, framed page with rounded cards and a sideways work scroller.' },
  { id: 'E', name: 'Colour', href: '/lab/e', note: 'Bold colour bands, client logos, quotes and the team.' },
];
---

<Base title="Nicey · Design directions (review)" description="Five homepage design directions for review." noindex>
  <main id="main" tabindex="-1" class="container-page dl">
    <p class="dl-k">Nicey · homepage review</p>
    <h1 class="dl-h">Design directions</h1>
    <p class="dl-lede">Five directions for the homepage. Same copy and section order, brand colours unchanged; only the look changes. Homepage only, no case study pages.</p>
    <ul class="dl-list">
      {directions.map((d) => (
        <li>
          <a href={d.href} class="dl-row">
            <span class="dl-id">{d.id}</span>
            <span class="dl-name">{d.name}{d.picked && <span class="dl-tag">Picked</span>}</span>
            <span class="dl-note">{d.note}</span>
            <span class="dl-arr" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .dl {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: clamp(48px, 10vw, 120px);
    padding-bottom: 96px;
  }
  .dl-k {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .dl-h {
    margin: 0;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }
  .dl-lede {
    margin: 0 0 24px;
    max-width: 56ch;
    color: var(--color-ink-2);
  }
  .dl-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line-strong);
  }
  .dl-row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) minmax(0, 1.4fr) 24px;
    align-items: baseline;
    gap: 16px;
    padding: 28px 8px;
    border-bottom: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    text-decoration: none;
  }
  .dl-id {
    font-family: var(--font-mono);
    color: var(--color-muted);
  }
  .dl-name {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -0.03em;
  }
  .dl-tag {
    padding: 3px 8px;
    background: var(--color-accent);
    color: var(--color-on-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dl-note {
    color: var(--color-ink-2);
  }
  .dl-arr {
    font-size: 22px;
  }
  .dl-row:hover,
  .dl-row:focus-visible {
    background: var(--color-surface-hover);
  }
  @media (max-width: 720px) {
    .dl-row {
      grid-template-columns: 32px minmax(0, 1fr) 20px;
    }
    .dl-note {
      grid-column: 2 / 3;
    }
    .dl-arr {
      grid-row: 1;
      grid-column: 3;
    }
  }
</style>
