---
/**
 * Direction A: "Book a call" with Goran, right after the free audit (Emir 23 Nov). Our own design, no embedded
 * scheduler: the button opens the booking page (links.bookCall, the cal.com intro the live site uses) in a new tab.
 * Copy is rough (Goran + Predrag polish).
 */
import { links } from '../../data/links';
import Button from '../../components/ui/Button.astro';
import Terminal from '../../components/ui/Terminal.astro';
---

<section aria-labelledby="call-head" class="container-page pb-section">
  <!-- 27 Nov ("two worlds"): the closer is a terminal window on the cream page, like the reference's last frame -->
  <Terminal class="bc world-dark" src="intro-call.md">
    <span slot="bar" class="bc-path">~/nicey</span>
    <div class="bc-in">
      <img class="bc-photo" src="/team/goran.jpg" alt="Goran, founder of Nicey" width="400" height="400" loading="lazy" decoding="async" />
      <div class="bc-text">
        <p class="bc-cmd m-0" aria-hidden="true"><span class="term-ps">&gt;</span> nicey book-call --with goran</p>
        <h2 id="call-head" class="bc-head m-0">Rather talk it through first?</h2>
        <p class="bc-line m-0">
          <span class="bc-name">Goran</span><span class="bc-role">Founder, Nicey</span>
        </p>
        <p class="bc-line m-0">Book a short intro call. Bring your Figma file or just the question.</p>
      </div>
      <Button href={links.bookCall} class="bc-btn" target="_blank" rel="noopener">
        Book a call
        <svg class="bc-ext" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" /></svg>
        <span class="sr-only"> (opens in a new tab)</span>
      </Button>
    </div>
  </Terminal>
</section>

<style>
  .bc-in {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-xl) var(--spacing-xl);
  }
  .bc-photo {
    display: block;
    width: 136px;
    height: 136px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  .bc-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .bc-ext {
    flex: none;
  }
  .bc-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .bc-cmd {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    color: var(--color-term-muted);
  }
  .bc-name {
    margin-right: var(--spacing-2xs);
    color: var(--color-term-ink);
  }
  .bc-role {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-term-muted);
  }
  .bc-head {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.05;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    color: var(--color-term-ink);
  }
  .bc-line {
    font-size: var(--text-body-sm);
    line-height: 1.45;
    color: var(--color-term-muted);
  }
  @media (max-width: 767px) {
    .bc-in {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: var(--spacing-md);
      padding: var(--spacing-md);
    }
    .bc-photo {
      width: 72px;
      height: 72px;
      align-self: start;
    }
    .bc-btn {
      grid-column: 1 / -1;
      justify-self: stretch;
      justify-content: center;
    }
  }
</style>
