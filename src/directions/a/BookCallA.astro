---
/**
 * Direction A: "Book a call" with Goran, right after the free audit (Emir 23 Nov). Our own design, no embedded
 * scheduler: the button opens the booking page (links.bookCall, the cal.com intro the live site uses) in a new tab.
 * Copy is rough (Goran + Predrag polish).
 * 27 Nov (after craft.wild.as): the band opens on pixel type (PixelMarqueeA, the Zero Drift story in two words), and
 * the button gets stepped pixel corners while the style is square (Terminal).
 */
import { links } from '../../data/links';
import Button from '../../components/ui/Button.astro';
import PixelMarqueeA from './PixelMarqueeA.astro';
---

<section aria-labelledby="call-head" class="container-page pb-section">
  <div class="panel bc">
    <PixelMarqueeA text="DRIFT → SYSTEM → " class="bc-mq" />
    <div class="bc-in">
      <img class="bc-photo" src="/team/goran.jpg" alt="Goran, founder of Nicey" width="400" height="400" loading="lazy" decoding="async" />
      <div class="bc-text">
        <p class="bc-who m-0"><span class="bc-name">Goran</span><span class="bc-role">Founder, Nicey</span></p>
        <h2 id="call-head" class="bc-head m-0">Rather talk it through first?</h2>
        <p class="bc-line m-0">Book a short intro call. Bring your Figma file or just the question.</p>
      </div>
      <Button href={links.bookCall} class="bc-btn" target="_blank" rel="noopener">
        Book a call
        <svg class="bc-ext" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" /></svg>
        <span class="sr-only"> (opens in a new tab)</span>
      </Button>
    </div>
  </div>
</section>

<style>
  .bc-in {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-lg) var(--spacing-lg);
    background: var(--color-surface);
  }
  .bc-photo {
    display: block;
    width: 136px;
    height: 136px;
    object-fit: cover;
  }
  .bc-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .bc :global(.bc-mq) {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-page);
  }
  /* stepped pixel corners, only while the corners are square (the Terminal style); the other styles keep their radius */
  @container style(--radius-pill: 0px) {
    .bc-btn {
      --step: 4px;
      clip-path: polygon(
        0 var(--step), var(--step) var(--step), var(--step) 0, calc(100% - var(--step)) 0,
        calc(100% - var(--step)) var(--step), 100% var(--step), 100% calc(100% - var(--step)),
        calc(100% - var(--step)) calc(100% - var(--step)), calc(100% - var(--step)) 100%, var(--step) 100%,
        var(--step) calc(100% - var(--step)), 0 calc(100% - var(--step))
      );
    }
  }
  .bc-ext {
    flex: none;
  }
  .bc-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .bc-who {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
  }
  .bc-name {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1;
    color: var(--color-ink);
  }
  .bc-role {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--color-muted);
  }
  .bc-head {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1.1;
  }
  .bc-line {
    font-size: var(--text-body-sm);
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  @media (max-width: 767px) {
    .bc-in {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: var(--spacing-md);
      padding: var(--spacing-md);
    }
    .bc-photo {
      width: 96px;
      height: 96px;
    }
    .bc-btn {
      grid-column: 1 / -1;
      justify-self: stretch;
      justify-content: center;
    }
  }
</style>
