---
/**
 * Direction A: the band after the ASCII band. 19 Nov (Goran via Emir): not a case-study list — the same square tiles,
 * filled with the logos of companies we have worked with (taken from nicey.studio, our own live site; SVGs in
 * /public/logos). Logos are one colour (ink; inverted in the dark theme).
 * Not links: the case studies live in Work, so no numbers and no hover (23 Nov interface review: accent-on-hover means
 * "clickable" everywhere else on the page).
 */
// w = h × the SVG's aspect ratio, so the browser reserves the space (Lighthouse: unsized images).
// heights are optical (Emir, 20 Nov audit): Colgate and UNIDO read smaller than the rest at the same height
const logos = [
  { name: 'Rakuten', src: '/logos/rakuten.svg', h: 30, w: 101 },
  { name: 'Colgate-Palmolive', src: '/logos/colgate.svg', h: 28, w: 214 },
  { name: 'Samsung Food', src: '/logos/samsung-food.svg', h: 24, w: 176 },
  { name: 'UNIDO', src: '/logos/unido.svg', h: 44, w: 248 },
  { name: 'Omnisafe', src: '/logos/omnisafe.svg', h: 22, w: 125 },
  { name: 'FLYR', src: '/logos/flyr.svg', h: 20, w: 85 },
  { name: 'Stripe', src: '/logos/stripe.svg', h: 30, w: 72 },
  { name: 'Repocket', src: '/logos/repocket.svg', h: 26, w: 110 },
];
---

<section class="sa" aria-labelledby="sa-head">
  <div class="container-page">
    <div class="sa-top">
      <h2 id="sa-head" class="caption a-path m-0 text-ink-2">Teams we have worked with</h2>
    </div>
    <ul class="panel sa-row">
      {
        logos.map((l) => (
          <li class="sa-tile">
            <img src={l.src} alt={l.name} width={l.w} height={l.h} style={`height:${l.h}px`} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* the page's one rhythm: every section ends on pb-section (it doubled up with Services' top padding before) */
  .sa {
    padding: var(--spacing-2xl) 0 var(--spacing-section);
  }
  .sa-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }
  .sa-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .sa-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 136px;
    padding: var(--spacing-lg) var(--spacing-md);
  }
  .sa-tile img {
    display: block;
    width: auto;
    max-width: 78%;
    filter: grayscale(1) brightness(0);
    opacity: 0.72;
  }
  @media (max-width: 767px) {
    .sa-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sa-tile {
      min-height: 112px;
    }
  }
</style>
