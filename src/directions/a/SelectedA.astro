---
/**
 * Direction A: the band after the ASCII band. 19 Nov (Goran via Emir): not a case-study list — the same square tiles,
 * filled with the logos of companies we have worked with (taken from nicey.studio, our own live site; SVGs in
 * /public/logos). Logos are one colour (ink; inverted in the dark theme) and show their own colours on hover.
 * Not links: the case studies live in Work.
 */
const logos = [
  { name: 'Rakuten', src: '/logos/rakuten.svg', h: 30 },
  { name: 'Colgate-Palmolive', src: '/logos/colgate.svg', h: 22 },
  { name: 'Samsung Food', src: '/logos/samsung-food.svg', h: 24 },
  { name: 'UNIDO', src: '/logos/unido.svg', h: 34 },
  { name: 'Omnisafe', src: '/logos/omnisafe.svg', h: 22 },
  { name: 'FLYR', src: '/logos/flyr.svg', h: 20 },
  { name: 'Geonode', src: '/logos/geonode.svg', h: 26 },
  { name: 'Repocket', src: '/logos/repocket.svg', h: 26 },
];
---

<section class="sa" aria-labelledby="sa-head">
  <div class="container-page">
    <div class="sa-top">
      <h2 id="sa-head" class="caption a-path m-0 text-ink-2">Teams we have worked with</h2>
    </div>
    <ul class="panel sa-row">
      {
        logos.map((l, i) => (
          <li class="sa-tile">
            <span class="sa-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <img src={l.src} alt={l.name} style={`height:${l.h}px`} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sa {
    padding: 64px 0 88px;
  }
  .sa-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .sa-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .sa-tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 136px;
    padding: 28px 24px;
  }
  .sa-n {
    position: absolute;
    top: 14px;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }
  .sa-tile img {
    display: block;
    width: auto;
    max-width: 78%;
    filter: grayscale(1) brightness(0);
    opacity: 0.72;
    transition:
      filter 200ms var(--ease-out),
      opacity 200ms var(--ease-out);
  }
  :global(:root[data-theme='dark']) .sa-tile img {
    filter: grayscale(1) brightness(0) invert(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .sa-tile:hover img {
      filter: none;
      opacity: 1;
    }
    .sa-tile:hover .sa-n {
      color: var(--color-accent);
    }
  }
  @media (max-width: 767px) {
    .sa-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sa-tile {
      min-height: 112px;
    }
  }
</style>
