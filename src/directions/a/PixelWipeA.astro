---
/**
 * Direction A · the pixel wipe around the terminal stretch (Goran, 27 Nov). The page is premium (sans, soft) until
 * How we work; there the screen breaks into square pixels that flip to the dark terminal look, along a ragged front
 * that rises from the bottom. On the way out (`exit`) the dark breaks up the same way and the light page comes back.
 *
 * The front: part smooth wave across the columns, part scatter per cell, so it has a shape you can follow and still
 * breaks up. Seeded (mulberry32, the brand field's generator), so it falls apart the same way on every load and runs
 * backwards cleanly when you scroll up. A few cells pass through the lavender and the accent on the way, so the
 * hand-off has some colour instead of a flat swap. Colours come from tokens.
 *
 * Built like the hill it replaces: one canvas pinned (sticky) in a tall runway that overlaps the light neighbour by
 * one screen, so there is no empty screen; it never takes clicks. Only with scripting on and motion allowed:
 * otherwise the page cuts straight to the dark section (the final state). Decorative: aria-hidden.
 *
 * It tells the header when the dark covers its strip (data-cover + 'nicey:cover'; see Header.astro).
 */
interface Props {
  /** the way out: dark → light */
  exit?: boolean;
}
const { exit = false } = Astro.props;
---

<div class:list={['pw', exit ? 'pw--out' : 'pw--in']} data-reveal data-exit={exit ? '1' : undefined} aria-hidden="true">
  <div class="pw-pin">
    <canvas class="pw-canvas"></canvas>
  </div>
</div>

<style>
  .pw {
    display: none;
  }
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .pw {
      position: relative;
      z-index: 1;
      display: block;
      /* the runway: the pinned screen plus the scroll it takes to flip every cell */
      height: 220vh;
      height: 220svh;
      pointer-events: none;
    }
    /* overlap the light neighbour by one screen; -1px so the dark frame and the dark section meet with no seam */
    .pw--in {
      margin-top: -100vh;
      margin-top: -100svh;
      margin-bottom: -1px;
    }
    .pw--out {
      margin-top: -1px;
      margin-bottom: -100vh;
      margin-bottom: -100svh;
    }
  }
  .pw-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .pw-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { mulberry32 } from '../../lib/pixel-field';

  /* how ragged the front is (0 = a straight line), how much of the scroll one cell takes to flip,
     and how many cells pass through the accent colours on the way */
  const RAGGED = 0.42;
  const FLIP = 0.1;
  const ACCENT_SHARE = 0.16;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((root) => {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    if (getComputedStyle(root).display === 'none') return; // reduced motion: the dark section is the final state
    const exit = root.dataset.exit === '1';
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // ---------- the grid: one threshold per cell (when in the scroll it flips), seeded ----------
    let W = 0, H = 0, dpr = 1, size = 28, cols = 0, rows = 0;
    let start = new Float32Array(0); // the progress at which each cell starts to flip
    let accent = new Uint8Array(0); // 0: straight to the other side; 1: via lavender; 2: via the accent
    // the progress by which 80% (way in) or half (way out) of the cells under the header have flipped
    let headIn = 1, headOut = 1;

    const build = () => {
      size = W < 640 ? 20 : 28;
      cols = Math.ceil(W / size);
      rows = Math.ceil(H / size);
      const n = cols * rows;
      start = new Float32Array(n);
      accent = new Uint8Array(n);
      const rand = mulberry32(exit ? 23 : 11);
      const phase = rand() * Math.PI * 2;
      for (let x = 0; x < cols; x++) {
        // the smooth part: two slow waves across the columns, in 0..1
        const wave = 0.5 + 0.3 * Math.sin(x * 0.29 + phase) + 0.2 * Math.sin(x * 0.11 + phase * 1.7);
        for (let y = 0; y < rows; y++) {
          // rows count from the bottom of the screen: the front rises, the bottom row goes first, the top row last
          const base = (y + 0.5) / rows;
          const t = clamp(base * (1 - RAGGED) + RAGGED * (0.55 * wave + 0.45 * rand()));
          const i = y * cols + x;
          start[i] = t * (1 - FLIP);
          const r = rand();
          accent[i] = r < ACCENT_SHARE / 2 ? 1 : r < ACCENT_SHARE ? 2 : 0;
        }
      }
      measureHead();
    };

    // when have the cells under the header flipped? Way in: 80% of them, so a stray cell doesn't hold the header
    // back. Way out: half of them, so the header turns light with the page under it.
    const measureHead = () => {
      const head = document.querySelector('[data-site-head]')?.getBoundingClientRect().bottom ?? 0;
      const headRows = Math.min(rows, Math.max(1, Math.ceil(head / size)));
      const ends: number[] = [];
      for (let y = rows - headRows; y < rows; y++)
        for (let x = 0; x < cols; x++) ends.push(start[y * cols + x] + FLIP);
      ends.sort((a, b) => a - b);
      headIn = ends[Math.floor(ends.length * 0.8)] ?? 1;
      headOut = ends[Math.floor(ends.length * 0.5)] ?? 1;
    };

    // ---------- colours from tokens ----------
    const colours = () => {
      const cs = getComputedStyle(root);
      return {
        dark: cs.getPropertyValue('--color-band').trim(),
        lavender: cs.getPropertyValue('--color-lavender').trim(),
        accent: cs.getPropertyValue('--color-accent').trim(),
      };
    };

    // ---------- progress through the runway ----------
    const progress = () => {
      const r = root.getBoundingClientRect();
      const run = r.height - innerHeight;
      return run > 0 ? clamp(-r.top / run) : 0;
    };

    let cover = false;
    const setCover = (on: boolean) => {
      if (cover === on) return;
      cover = on;
      root.dataset.cover = on ? '1' : '';
      dispatchEvent(new Event('nicey:cover'));
    };

    const draw = () => {
      if (!W) return;
      const p = progress();
      const c = colours();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      // s: how far a cell is through its flip, 0..1. Way in: 0 is light (clear), 1 dark. Way out: the other way round.
      const fill = (s: number, a: number): string | null => {
        const d = exit ? 1 - s : s; // how dark it is
        if (a && d > 0.02 && d < 0.98) return d < 0.5 ? c.lavender : a === 1 ? c.lavender : c.accent;
        return d >= 0.5 ? c.dark : null;
      };
      // batch by colour: one path per colour
      const paths = new Map<string, Path2D>();
      for (let y = 0; y < rows; y++)
        for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          const s = clamp((p - start[i]) / FLIP);
          const f = fill(s, accent[i]);
          if (!f) continue;
          let path = paths.get(f);
          if (!path) paths.set(f, (path = new Path2D()));
          // the front rises from the bottom, so rows are counted from the bottom of the screen
          path.rect(x * size, H - (y + 1) * size, size, size);
        }
      paths.forEach((path, f) => {
        ctx.fillStyle = f;
        ctx.fill(path);
      });
      // the header strip is at the top, so it flips last on the way in and first on the way out
      setCover(exit ? p < headOut : p >= headIn);
    };

    // ---------- size ----------
    const resize = () => {
      const r = canvas.getBoundingClientRect();
      if (r.width < 1 || r.height < 1) return;
      W = r.width;
      H = r.height;
      dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      build();
      draw();
    };

    // ---------- redraw on scroll, only while on screen ----------
    let visible = false, raf = 0;
    const kick = () => {
      if (visible && !raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          draw();
        });
    };
    new IntersectionObserver((e) => {
      visible = e[0].isIntersecting;
      kick();
    }).observe(root);
    addEventListener('scroll', kick, { passive: true });
    new ResizeObserver(resize).observe(canvas);
    resize();
  });
</script>
