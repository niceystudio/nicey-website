---
/**
 * Direction A: How we work. Emir 23 Nov: the illustration (HowDiagramA) alone carries the section; the five step
 * cards (Drift / Audit / System / Context / Proof) left the page — their full text stays in the Markdown twin for agents.
 */
import HowDiagramA from './HowDiagramA.astro';
---

<section id="how" aria-labelledby="how-head" class="ho">
  <div class="container-page">
    <div class="ho-intro">
      <span class="caption a-path text-ink-2">How we work</span>
      <h2 id="how-head" class="m-0 text-h2">From drift to a system that holds.</h2>
    </div>
    <HowDiagramA />
  </div>
</section>

<style>
  .ho {
    padding-bottom: var(--spacing-section);
  }
  .ho-intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 48px;
  }
</style>
