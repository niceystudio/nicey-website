---
/**
 * Direction A: Zero Drift, simplified (Emir 19 Nov: too much text and noise). D's structure — five step cards in one
 * row — in A's brand: pixel numbers, one accent. Each step = number, name, one sentence. The step pipeline strip and
 * the per-step windows (seeing / we do / proof figures) are gone; the full text stays in the Markdown twin for agents.
 * 23 Nov (Emir): the rail above the cards (HowDiagramB) — tangled lines straighten from Drift to Proof.
 * 23 Nov (Goran): no "You get" line and no rules between the steps — one container, spacing separates them.
 * 27 Nov (Goran): a dark section, reached through the hill reveal (RevealHillA) right above it. The section re-points
 * the page tokens to their dark-band values, so the cards, the diagram and the printed heading follow without edits.
 */
import { steps } from '../../data/zero-drift';
import HowDiagramB from './HowDiagramB.astro';
---

<section id="how" aria-labelledby="how-head" class="ho">
  <div class="container-page">
    <div class="ho-intro">
      <span class="caption a-path text-ink-2">How we work</span>
      <h2 id="how-head" class="m-0 text-h2"><span class="h-print">From drift to a system that holds.</span></h2>
    </div>
    <HowDiagramB />
    <ol class="ho-steps">
      {
        steps.map((s) => (
          <li class="ho-step" id={`step-${s.id}`}>
            <span class="ho-num" aria-hidden="true">{s.num}</span>
            <h3 class="ho-name m-0">{s.name}</h3>
            <p class="ho-line m-0">{s.heading}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ho {
    /* the dark band: page tokens re-pointed for everything inside (cards, diagram, printed heading) */
    --color-page: var(--color-band);
    --color-surface: color-mix(in srgb, var(--color-on-band) 5%, var(--color-band));
    --color-ink: var(--color-on-band);
    --color-ink-2: var(--color-on-band-2);
    --color-muted: var(--color-on-band-2);
    --color-line: var(--color-term-rule);
    --color-rule: var(--color-term-rule);
    --color-accent: var(--color-on-band-accent);
    --color-hot: var(--color-term-fail);
    --color-on-accent: var(--color-band);
    /* the A aliases resolve on .dir-a, so they are set again here */
    --a-rule: var(--color-term-rule);
    --a-block: var(--color-on-band-accent);
    --a-on-block: var(--color-band);
    padding-block: var(--spacing-section);
    background: var(--color-band);
    color: var(--color-ink);
  }
  .ho-intro {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xl);
  }
  /* one container, no rules inside: the steps are separated by space alone */
  /* one container, no rules inside: the steps are separated by space alone */
  /* Card proportions (Goran, 23 Nov: rebalanced): one dominant element per card — the step name. Sizes on a 4:3 scale
     from the 15px body (15 → 20 → 27), spacing on the 8px grid. The number is a marker, not a headline: it sits one
     step below the name, and further from it (24px) than the name is from its sentence (8px), so name + sentence
     read as one group. */
  .ho-steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--spacing-2xs) 0;
    margin: 0;
    padding: var(--spacing-2xs);
    list-style: none;
    border: 1px solid var(--a-rule);
    background: var(--color-surface);
  }
  .ho-step {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md);
  }
  .ho-num {
    margin-bottom: var(--spacing-md);
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1;
    color: var(--color-accent);
  }
  .ho-name {
    margin-bottom: var(--spacing-2xs);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 27px;
    line-height: 1.1;
  }
  .ho-line {
    font-size: var(--text-body-sm);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  @media (max-width: 1023px) {
    .ho-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 559px) {
    .ho-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
