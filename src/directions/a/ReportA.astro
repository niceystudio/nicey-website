---
/**
 * Direction A: the audit report as a terminal window with its three pages (p.1 Score, p.2 Drift map,
 * p.3 Fix first) instead of paper sheets. 19 Nov (Emir: more terminal, less capitals): each page opens with the
 * command and a # comment saying what the page holds; tabs and bar in sentence case. Marked "example": bars are drawn; scores, grade and days are sample values (Emir 23 Nov: fill them, it's an example).
 * 20 Nov (Emir: consistent with the design-systems.md terminal in "What we help with"): the same coloured stage with the
 * same dark window inside — soft-filled tabs, file name on the right, mono reading, blinking cursor (QBenchWork values).
 */
import PixelFieldA from './PixelFieldA.astro';
import Terminal from '../../components/ui/Terminal.astro';

const pillars = ['Figma inspect', 'Agentic readiness', 'Conventions', 'Component API', 'Zero drift'];
const bars = [9, 4, 7, 6, 3];
/* sample values for the example report (match the bars, out of 100) */
const scores = ['76/100', '34/100', '58/100', '51/100', '27/100'];
const days = ['2 days', '5 days', '1 day', '3 days', '4 days'];
const bar = (n: number) => '▇'.repeat(n) + '░'.repeat(12 - n);
const pages = [
  {
    id: 'score',
    tab: 'score',
    cmd: 'nicey audit your-file.fig --page score',
    note: 'A grade and a score per pillar.',
    lines: [
      ...pillars.map((p, i) => `${p.padEnd(19)} ${bar(bars[i])}  ${scores[i]}`),
      ''.padEnd(46, '─'),
      `${'grade'.padEnd(19)} C`,
    ],
  },
  {
    id: 'drift',
    tab: 'drift map',
    cmd: 'nicey audit your-file.fig --page drift',
    note: 'Where design and code disagree.',
    lines: [
      `${'figma'.padEnd(24)}   code`,
      ''.padEnd(46, '─'),
      `${'color.accent'.padEnd(24, '.')} ≠ purple-2`,
      `${'border/default'.padEnd(24, '.')} = border/default`,
      `${'text/default'.padEnd(24, '.')} ≠ col-7`,
      `${'border/primary/default'.padEnd(24, '.')} = border/primary/default`,
      `${'opacity/disabled'.padEnd(24, '.')} ≠ violet-final`,
    ],
  },
  {
    id: 'fix',
    tab: 'fix first',
    cmd: 'nicey audit your-file.fig --page fix',
    note: 'Top findings, each sized in days.',
    lines: pillars.map((p, i) => `${String(i + 1).padStart(2, '0')}  ${p.toLowerCase().padEnd(20, '.')} top finding  ${days[i]}`),
  },
];
---

<div class="ra-stage">
  <PixelFieldA mode="drift" still seed={11} />
  <Terminal class="ra" src="audit-report.md · example" tabsLabel="Report pages" data-ra>
    <Fragment slot="tabs">
      {
        pages.map((p, i) => (
          <button type="button" role="tab" class="term-tab" aria-selected={i === 0 ? 'true' : 'false'} data-ra-tab={i}>
            {p.tab}
          </button>
        ))
      }
    </Fragment>
    {
      pages.map((p, i) => (
        <pre class="term-body term-cursor ra-page" role="tabpanel" tabindex="0" aria-label={`audit report: ${p.tab}`} hidden={i !== 0} data-ra-page={i}><span><span class="term-ps">$</span> {p.cmd}</span>{'\n'}<span class="term-note"># {p.note}</span>{'\n\n'}{p.lines.join('\n')}</pre>
      ))
    }
  </Terminal>
</div>

<style>
  /* the stage: a still pixel field behind the window (the window itself is the shared Terminal) */
  .ra-stage {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 40px;
  }
  .ra-stage > :global(.term) {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 340px;
  }
  .ra-page {
    white-space: pre;
    overflow-x: auto;
  }
  .ra-page[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .ra-stage {
      padding: 20px;
    }
  }
  @media (max-width: 480px) {
    .ra-stage {
      padding: 8px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ra]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ra-tab]'));
    const pages = Array.from(root.querySelectorAll<HTMLElement>('[data-ra-page]'));
    let i = 0;
    let timer = 0;
    let took = false;
    const show = (k: number) => {
      i = k;
      tabs.forEach((t, n) => t.setAttribute('aria-selected', String(n === k)));
      pages.forEach((p, n) => (p.hidden = n !== k));
    };
    tabs.forEach((t, n) =>
      t.addEventListener('click', () => {
        took = true;
        window.clearInterval(timer);
        show(n);
      }),
    );
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // turns pages only while on screen and not under the pointer or focus (20 Nov review)
    let seen = false;
    let held = false;
    const run = () => {
      window.clearInterval(timer);
      if (seen && !held && !took) timer = window.setInterval(() => show((i + 1) % pages.length), 3600);
    };
    root.addEventListener('pointerenter', () => ((held = true), run()));
    root.addEventListener('pointerleave', () => ((held = false), run()));
    root.addEventListener('focusin', () => ((held = true), run()));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) (held = false), run();
    });
    new IntersectionObserver((es) => {
      seen = es[0].isIntersecting;
      run();
    }).observe(root);
  });
</script>
