---
/**
 * Direction A: the audit report as a terminal window with its three pages (p.1 Score, p.2 Drift map,
 * p.3 Fix first) instead of paper sheets. 19 Nov (Emir: more terminal, less capitals): each page opens with the
 * command and a # comment saying what the page holds; tabs and bar in sentence case. Marked "example": bars are drawn, scores and days stay [gaps].
 * 20 Nov (Emir: consistent with the design-systems.md terminal in "What we help with"): the same coloured stage with the
 * same dark window inside — soft-filled tabs, file name on the right, mono reading, blinking cursor (QBenchWork values).
 */
const pillars = ['Figma inspect', 'Agentic readiness', 'Conventions', 'Component API', 'Zero drift'];
const bars = [9, 4, 7, 6, 3];
const bar = (n: number) => '▇'.repeat(n) + '░'.repeat(12 - n);
const pages = [
  {
    id: 'score',
    tab: 'score',
    cmd: 'nicey audit your-file.fig --page score',
    note: 'A grade and a score per pillar.',
    lines: [
      ...pillars.map((p, i) => `${p.padEnd(19)} ${bar(bars[i])}  [score]`),
      ''.padEnd(46, '─'),
      `${'grade'.padEnd(19)} [grade]`,
    ],
  },
  {
    id: 'drift',
    tab: 'drift map',
    cmd: 'nicey audit your-file.fig --page drift',
    note: 'Where design and code disagree.',
    lines: [
      `${'figma'.padEnd(24)}   code`,
      ''.padEnd(46, '─'),
      `${'color.accent'.padEnd(24, '.')} ≠ purple-2`,
      `${'border/default'.padEnd(24, '.')} = border/default`,
      `${'text/default'.padEnd(24, '.')} ≠ col-7`,
      `${'border/primary/default'.padEnd(24, '.')} = border/primary/default`,
      `${'opacity/disabled'.padEnd(24, '.')} ≠ violet-final`,
    ],
  },
  {
    id: 'fix',
    tab: 'fix first',
    cmd: 'nicey audit your-file.fig --page fix',
    note: 'Top findings, each sized in days.',
    lines: pillars.map((p, i) => `${String(i + 1).padStart(2, '0')}  ${p.toLowerCase().padEnd(20, '.')} top finding  [days]`),
  },
];
---

<div class="ra-stage a-grain bg-lavender">
  <div class="ra" data-ra>
    <div class="ra-bar">
      <div class="ra-tabs" role="tablist" aria-label="Report pages">
        {
          pages.map((p, i) => (
            <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-ra-tab={i}>
              {p.tab}
            </button>
          ))
        }
      </div>
      <span class="ra-src">audit-report.md · example</span>
    </div>
    {
      pages.map((p, i) => (
        <pre class="ra-page" role="tabpanel" tabindex="0" aria-label={`audit report: ${p.tab}`} hidden={i !== 0} data-ra-page={i}><span class="ra-cmd"><span class="ra-ps">$</span> {p.cmd}</span>{'\n'}<span class="ra-note"># {p.note}</span>{'\n\n'}{p.lines.join('\n')}</pre>
      ))
    }
  </div>
</div>

<style>
  /* the stage: same as the design-systems.md pane in "What we help with" */
  .ra-stage {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    position: relative;
    isolation: isolate;
  }
  /* the window: same values as QBenchWork's terminal */
  .ra {
    width: 100%;
    min-height: 340px;
    display: flex;
    flex-direction: column;
    background: #26251f;
    color: #f3f0e9;
    overflow: hidden;
  }
  .ra-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding: 6px 18px;
    border-bottom: 1px solid rgba(243, 240, 233, 0.12);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: #b6b1a3;
  }
  .ra-tabs {
    display: flex;
    flex-wrap: wrap; /* 320: "fix first" was clipped (20 Nov review) */
    gap: 2px;
  }
  .ra-tabs button {
    min-height: 32px;
    padding: 0 12px;
    border: 0;
    background: transparent;
    color: #b6b1a3;
    font: inherit;
    letter-spacing: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out), transform 160ms var(--ease-out);
  }
  .ra-tabs button:active {
    transform: scale(0.97);
  }
  .ra-tabs button[aria-selected='true'] {
    background: rgba(243, 240, 233, 0.12);
    color: #f3f0e9;
  }
  @media (hover: hover) and (pointer: fine) {
    .ra-tabs button:hover {
      color: #f3f0e9;
    }
  }
  .ra-src {
    margin-left: auto;
  }
  .ra-page {
    flex: 1;
    margin: 0;
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    white-space: pre;
    overflow-x: auto;
    color: #f3f0e9;
  }
  .ra-page::after {
    content: '▍';
    color: #cbdac4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ra-page::after {
      animation: ra-blink 1s steps(1) infinite;
    }
  }
  @keyframes ra-blink {
    50% {
      opacity: 0;
    }
  }
  .ra-ps {
    color: #d9d2ef;
  }
  .ra-note {
    color: #b6b1a3;
  }
  .ra-page[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .ra-stage {
      padding: 20px;
    }
  }
  @media (max-width: 480px) {
    .ra-stage {
      padding: 8px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ra]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ra-tab]'));
    const pages = Array.from(root.querySelectorAll<HTMLElement>('[data-ra-page]'));
    let i = 0;
    let timer = 0;
    let took = false;
    const show = (k: number) => {
      i = k;
      tabs.forEach((t, n) => t.setAttribute('aria-selected', String(n === k)));
      pages.forEach((p, n) => (p.hidden = n !== k));
    };
    tabs.forEach((t, n) =>
      t.addEventListener('click', () => {
        took = true;
        window.clearInterval(timer);
        show(n);
      }),
    );
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // turns pages only while on screen and not under the pointer or focus (20 Nov review)
    let seen = false;
    let held = false;
    const run = () => {
      window.clearInterval(timer);
      if (seen && !held && !took) timer = window.setInterval(() => show((i + 1) % pages.length), 3600);
    };
    root.addEventListener('pointerenter', () => ((held = true), run()));
    root.addEventListener('pointerleave', () => ((held = false), run()));
    root.addEventListener('focusin', () => ((held = true), run()));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) (held = false), run();
    });
    new IntersectionObserver((es) => {
      seen = es[0].isIntersecting;
      run();
    }).observe(root);
  });
</script>
