---
/**
 * Direction A — "Select" (terminal, ASCII, dither). Homepage only, same copy and order as live.
 * New: hero, ASCII band, When to bring us in (ruled diagnostic rows), How we work (step windows).
 * Reused and restyled by a.css: Services, Work, free audit, FAQ, footer.
 */
import './a.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Services from '../../components/Services.astro';
import Work from '../../components/Work.astro';
import Process from '../../components/Process.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MachineView from '../../components/case-study/MachineView.astro';
import DirectionSwitch from '../DirectionSwitch.astro';
import HeroA from './HeroA.astro';
import AsciiBand from './AsciiBand.astro';
import WhenA from './WhenA.astro';
import HowA from './HowA.astro';
import { homeMarkdown } from '../../lib/home-markdown';

const markdown = await homeMarkdown(Astro.site ?? new URL('https://nicey-website.vercel.app'));
---

<Base
  title="Nicey · Direction A (review)"
  description="Design direction A for review: terminal, ASCII and dither."
  noindex
  markdownHref="/index.md"
>
  <div class="dir-a">
    <Header />
    <main id="main" tabindex="-1" data-human>
      <HeroA />
      <AsciiBand />
      <WhenA />
      <Services />
      <Work />
      <AsciiBand labels={['your file', 'one system', 'every reader']} rows={5} />
      <div class="a-gap" aria-hidden="true"></div>
      <HowA />
      <Process />
      <Faq />
    </main>
    <Footer />
    <MachineView markdown={markdown} mdHref="/index.md" what="homepage" />
    <SiteFooter mdHref="/index.md" />
  </div>
  <DirectionSwitch current="a" />
</Base>

<style>
  .a-gap {
    height: var(--spacing-section);
  }
</style>

<script>
  // keyboard keys on the hero buttons (A = free audit, B = book a call), never while typing
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement;
    if (t.closest('input, textarea, select, [contenteditable="true"]')) return;
    const k = e.key.toLowerCase();
    const a = document.querySelector<HTMLAnchorElement>(`[aria-keyshortcuts="${k}"]`);
    if (a) a.click();
  });
</script>
