---
/**
 * Direction A: "It starts with a free audit" — one panel, two paths (Emir + Goran, 24 Nov: two sections were misleading;
 * same seven checks, done by us or by the visitor's own agent):
 *   1. "We audit it for you": How it goes (4 steps) + Get a free audit on the report stage's bottom line, beside ReportA
 *   2. "Or let your agent check it first": SelfCheckA — What you'll see + Copy prompt, beside the live example run
 * Typography: capitals only in the small section caption; everything else sentence case.
 */
import SectionHead from '../../components/SectionHead.astro';
import ReportA from './ReportA.astro';
import { links } from '../../data/links';
import Button from '../../components/ui/Button.astro';
import Label from '../../components/ui/Label.astro';

import SelfCheckA from './SelfCheckA.astro';



// time placeholders removed in A (Emir, 20 Nov: we don't need them). 20 Nov: caption "Free audit" (same as the header button; "Process" left the nav);
// steps marked with → (How we work above is the only numbered process); the list fills the column beside the report
const steps = [
  { n: '01', title: 'Share your Figma file' },
  { n: '02', title: 'Get the report' },
  { n: '03', title: 'Talk it through' },
  { n: '04', title: 'Build, pilot, roll out' },
];
---

<section id="audit" aria-labelledby="start-head" class="container-page flex flex-col gap-12 pb-section">
  <SectionHead id="start-head" caption="Free audit" headingClass="max-w-[16ch]">
    It starts with a free audit.
  </SectionHead>

  <div class="panel pa-box">
    <div class="pa-body">
      <div class="pa-left">
        <div class="pa-head">
          <h3 class="pa-h m-0">We audit it for you</h3>
        </div>
        <Label variant="mono" as="p">How it goes</Label>
        <ol class="pa-steps">
          {
            steps.map((s) => (
              <li>
                <span class="pa-n" aria-hidden="true">→</span>
                <span class="pa-title">{s.title}</span>
              </li>
            ))
          }
        </ol>
        <Button href={links.startAudit} class="pa-cta">Get a free audit</Button>
      </div>
      <div class="pa-right">
        <Label variant="mono" as="p">What you get</Label>
        <ReportA />
      </div>
    </div>

    <SelfCheckA />
  </div>
</section>

<style>
  .pa-box {
    display: flex;
    flex-direction: column;
  }
  .pa-body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--spacing-xl);
    padding: var(--spacing-cell-lg);
  }
  @media (max-width: 1023px) {
    .pa-body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-xl);
    }
  }
  .pa-left,
  .pa-right {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    min-width: 0;
  }
  .pa-head {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xs);
    margin-bottom: var(--spacing-md);
  }
  .pa-h {
    font-size: var(--text-h3-card);
    line-height: 1.2;
    font-weight: 400;
    text-wrap: balance;
  }
  /* the button sits on the report stage's bottom line (Emir 24 Nov) */
  .pa-cta {
    align-self: flex-start;
    margin-top: auto;
  }
  /* no rules between the steps (Goran, 23 Nov: too many lines) — spacing alone separates them */
  .pa-steps {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin: 0;
    padding: var(--spacing-2xs) 0 0;
    list-style: none;
  }
  .pa-steps li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: baseline;
    gap: var(--spacing-xs);
  }
  .pa-n {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    color: var(--color-ink-2);
  }
  .pa-title {
    font-size: var(--text-cta);
    line-height: 1.3;
    color: var(--color-ink);
  }
  /* the action comes last, after the process */
  @media (max-width: 767px) {
    .pa-body {
      padding: var(--spacing-md);
    }
  }
</style>
