---
/**
 * Direction A: "It starts with a free audit" (Emir 19 Nov, second pass). Reading order inside one .panel:
 *   1. the four steps (step titles only — time placeholders removed 20 Nov) beside the report as a terminal (ReportA)
 *   2. the action, last: Get a free audit — people read the process first, then click; next to it the quieter
 *      path for visitors not ready to share their file (copy the prompt).
 * Typography: capitals only in the small section caption; everything else sentence case.
 * Removed: the CTA beside the headline, the "Free · read-only…" note, the legend that repeated the report tabs,
 * the auto-playing example run. Times stay [gaps] for Goran.
 */
import SectionHead from '../../components/SectionHead.astro';
import CopyPrompt from '../../components/CopyPrompt.astro';
import ReportA from './ReportA.astro';
import { links } from '../../data/links';

// time placeholders removed in A (Emir, 20 Nov: we don't need them). 20 Nov audit: caption = nav label "Process";
// steps marked with → (How we work above is the only numbered process); the list fills the column beside the report
const steps = [
  { n: '01', title: 'Share your Figma file' },
  { n: '02', title: 'Get the report' },
  { n: '03', title: 'Talk it through' },
  { n: '04', title: 'Build, pilot, roll out' },
];
---

<section id="audit" aria-labelledby="start-head" class="container-page flex flex-col gap-12 pb-section">
  <SectionHead id="start-head" caption="Process" headingClass="max-w-[16ch]">
    It starts with a free audit.
  </SectionHead>

  <div class="panel pa-box">
    <div class="pa-body">
      <div class="pa-left">
        <p class="pa-k m-0">How it goes</p>
        <ol class="pa-steps">
          {
            steps.map((s) => (
              <li>
                <span class="pa-n" aria-hidden="true">→</span>
                <span class="pa-title">{s.title}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="pa-right">
        <p class="pa-k m-0">What you get</p>
        <ReportA />
      </div>
    </div>

    <div class="pa-act">
      <a href={links.startAudit} class="pill pill-ink pill-lg">Get a free audit</a>
      <div class="pa-own">
        <p class="m-0 pa-own-p">
          Not ready to share your file? Let your agent run our seven checks, then bring the results to a call.
        </p>
        <CopyPrompt showFile={false} />
      </div>
    </div>
  </div>
</section>

<style>
  .pa-box {
    display: flex;
    flex-direction: column;
  }
  .pa-body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    padding: var(--spacing-cell-lg);
  }
  @media (max-width: 1023px) {
    .pa-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
  .pa-left,
  .pa-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  /* small labels: sentence case, mono, muted — no capitals */
  .pa-k {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-muted);
  }
  .pa-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--a-rule);
  }
  .pa-steps li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--a-rule);
  }
  .pa-n {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-2);
  }
  .pa-title {
    font-size: var(--text-cta);
    line-height: 1.3;
    color: var(--color-ink);
  }
  /* the steps column fills the report's height (the rows share it), so no empty block sits beside the report */
  @media (min-width: 1024px) {
    .pa-steps {
      display: flex;
      flex: 1;
      flex-direction: column;
    }
    .pa-steps li {
      flex: 1;
      align-items: center;
    }
  }
  /* the action comes last, after the process */
  .pa-act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 40px;
    padding: 28px var(--spacing-cell-lg);
  }
  .pa-own {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    flex: 1 1 420px;
    padding-left: 40px;
    border-left: 1px solid var(--a-rule);
  }
  .pa-own-p {
    flex: 1 1 320px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  @media (max-width: 767px) {
    .pa-body,
    .pa-act {
      padding: 24px;
    }
    .pa-own {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
