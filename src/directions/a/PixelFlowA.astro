---
/**
 * Direction A · How we work, drawn in cells (27 Nov, after craft.wild.as's "Explore, Generate, Refine, Scale" flow).
 * Replaces the tangled-lines rail (HowDiagramB). Left to right it is the Zero Drift story:
 *   Drift    scattered cells in eleven near-colours, drifting
 *   Audit    the same scatter, a scan passes and flags the off ones hot
 *   System   cells snap onto the grid and take the accent: one value, one name
 *   Context  the block gains ink rows: the written rules
 *   Proof    a solid, bordered block that holds
 * Cells fly in once when the section comes on screen; the pointer bends the stream; hovering (or focusing) a step
 * card below lights its column. Decorative: the steps are the text. Reduced motion: the settled picture, still.
 * Engine: src/lib/pixel-scenes.ts.
 */
---

<figure class="pfl m-0" aria-hidden="true">
  <canvas data-pfl></canvas>
</figure>

<style>
  .pfl {
    border: 1px solid var(--color-line);
    border-bottom: 0;
    background: var(--color-page);
  }
  .pfl canvas {
    display: block;
    width: 100%;
    height: 220px;
  }
  @media (max-width: 767px) {
    .pfl canvas {
      height: 168px;
    }
  }
</style>

<script>
  import { mountScene, mulberry32, easeOut, repel, cell as drawCell, type Colors, type Scene } from '../../lib/pixel-scenes';

  type Kind = 'drift' | 'accent' | 'ink';
  interface P {
    u: number;
    col: number;
    tx: number;
    ty: number;
    spread: number;
    kind: Kind;
    tone: number;
    x: number;
    y: number;
    ph: number;
    flag: boolean;
  }
  interface Flow extends Scene {
    size: number;
    cells: P[];
    focus: number;
  }

  const STEPS = ['drift', 'audit', 'system', 'context', 'proof'];

  document.querySelectorAll<HTMLCanvasElement>('[data-pfl]').forEach((canvas) => {
    const section = canvas.closest('section');
    const flow = mountScene<Flow>(
      canvas,
      {
        host: canvas.parentElement,
        threshold: 0.4,
        layout(s) {
          const r = mulberry32(11), z = s.size;
          const cols = Math.floor(s.W / z), mid = Math.round(s.H / 2 / z) * z;
          const half = Math.max(3, Math.round((s.H * 0.15) / z));
          s.cells = [];
          // every grid slot along the flow: the band narrows to a fixed block, density rises to solid at Proof
          for (let gx = 1; gx < cols - 1; gx++) {
            const u = gx / cols, col = Math.min(4, Math.floor(u * 5));
            const density = u < 0.4 ? 0.55 : Math.min(1, 0.35 + (u - 0.4) * 1.9);
            for (let gy = -half; gy <= half; gy++) {
              if (r() > density) continue;
              const spread = Math.pow(1 - Math.min(1, u / 0.42), 1.5);
              const x = gx * z, y = mid + gy * z;
              const sy = mid + (r() - 0.5) * s.H * 0.88, sx = x + (r() - 0.5) * 40 * spread;
              const kind: Kind = u < 0.4 ? 'drift' : (col === 3 && gy % 3 === 0) || (col >= 3 && Math.abs(gy) === half) ? 'ink' : 'accent';
              s.cells.push({
                u, col, spread, kind, tone: Math.floor(r() * 7),
                tx: sx + (x - sx) * (1 - spread), ty: sy + (y - sy) * (1 - spread),
                x: r() * s.W, y: r() * s.H, ph: r() * 6.283, flag: col === 1 && r() < 0.3,
              });
            }
          }
          if (s.reduced) s.cells.forEach((p) => ((p.x = p.tx), (p.y = p.ty)));
        },
        draw(s, c: Colors, t) {
          const { ctx } = s, z = s.size;
          const drift = [c.hot, c.peachDeep, c.butterDeep, c.sageDeep, c.lavenderDeep, c.accent, c.mauveDeep];
          ctx.clearRect(0, 0, s.W, s.H);
          const wide = s.W >= 900;
          if (wide) {
            ctx.fillStyle = c.faint;
            for (let k = 1; k < 5; k++) ctx.fillRect(Math.round((k * s.W) / 5), 0, 1, s.H);
          }
          if (s.focus >= 0) {
            ctx.fillStyle = c.faint;
            ctx.fillRect((s.focus * s.W) / 5, 0, s.W / 5, s.H);
          }
          // the audit scan sweeps its column every few seconds
          const scanX = s.W / 5 + ((t * 60) % (s.W / 5));
          let moving = false;
          for (const p of s.cells) {
            const k = s.reduced ? 1 : easeOut((t - p.u * 1.2) / 1.1);
            let tx = p.tx, ty = p.ty;
            if (!s.reduced) {
              tx += Math.sin(t * 0.9 + p.ph) * 6 * p.spread;
              ty += Math.cos(t * 0.7 + p.ph) * 8 * p.spread;
              [tx, ty] = repel(s, tx, ty, 70, 26);
            }
            if (k < 1) {
              moving = true;
              p.x += (tx - p.x) * k;
              p.y += (ty - p.y) * k;
            } else {
              const nx = p.x + (tx - p.x) * 0.18, ny = p.y + (ty - p.y) * 0.18;
              if (Math.abs(nx - p.x) > 0.2 || Math.abs(ny - p.y) > 0.2) moving = true;
              p.x = nx;
              p.y = ny;
            }
            let fill = p.kind === 'ink' ? c.ink : p.kind === 'accent' ? c.accent : drift[p.tone];
            if (p.flag && Math.abs(p.tx - scanX) < 40) fill = c.hot;
            ctx.globalAlpha = s.focus >= 0 && p.col !== s.focus ? 0.22 : 1;
            ctx.fillStyle = fill;
            drawCell(ctx, p.x, p.y, z);
          }
          ctx.globalAlpha = 1;
          // the drift and the scan never stop (they're slow); the rest settles
          return moving || !s.reduced;
        },
      },
      { size: 8, cells: [], focus: -1 },
    );
    if (!flow || !section) return;
    STEPS.forEach((id, i) => {
      const card = section.querySelector<HTMLElement>(`#step-${id}`);
      if (!card) return;
      const on = () => ((flow.focus = i), (flow.dirty = true));
      const off = () => ((flow.focus = -1), (flow.dirty = true));
      card.addEventListener('pointerenter', on);
      card.addEventListener('pointerleave', off);
      card.addEventListener('focusin', on);
      card.addEventListener('focusout', off);
    });
  });
</script>
