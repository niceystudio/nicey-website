---
/**
 * The machine side (27 Nov, "two worlds"): a field of mono words on the dark band, after the Content Architecture's
 * ASCII portrait, told in our own words. Each row reads left to right from what a legacy product carries (drifted
 * values), through the tokens they collapse into, to what a coding agent reads. The brand noise (src/lib/pixel-field.ts)
 * decides how bright each character is, so the words gather into slow clouds instead of a flat wall.
 *
 * Decorative (aria-hidden): whatever it says is said in words next to it. Canvas text, DPR-aware (capped at 2),
 * ~12fps, paused offscreen. Pointer only: characters near the cursor light up. Reduced motion: one still frame.
 *
 *   <WordFieldA />                 the hero's agent side
 *   <WordFieldA quiet />           a dimmer texture (the footer)
 */
interface Props {
  /** dimmer, no pointer light: for a texture behind text */
  quiet?: boolean;
  class?: string;
}
const { quiet = false, class: cls } = Astro.props;
---

<div class:list={['wf', cls]} data-wf data-quiet={quiet ? '' : undefined} aria-hidden="true">
  <canvas class="wf-c"></canvas>
</div>

<style>
  .wf {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .wf-c {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { createDrift, mulberry32 } from '../../lib/pixel-field';

  // the three worlds a row passes through, left to right
  const LEGACY = ['#6b5fbe', 'purple-2', 'col-7', 'brand/purple/30', 'btn-new-final', '#7266c4', 'violet-final', 'margin:13px', 'Button_v2_OLD', '!important', 'z-index:9999', 'grey-light-2', '#665ab8', 'h2-copy'];
  const SYSTEM = ['color.accent', 'text/default', 'space.4', 'radius.panel', 'border/default', 'Button', 'Input', 'surface/hover', 'font.display', 'opacity/disabled', 'Field', 'text/placeholder'];
  const AGENT = ['AGENTS.md', 'tokens.json', 'button.md', 'ok', 'input.md', 'theme.css', 'ok', 'library.json', 'field.md', 'synced', 'llms.txt', 'ok'];

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  document.querySelectorAll<HTMLElement>('[data-wf]').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const quiet = root.hasAttribute('data-quiet');
    const css = getComputedStyle(document.documentElement);
    const col = (n: string, f: string) => css.getPropertyValue(n).trim() || f;
    const C = {
      ink: col('--color-term-ink', '#f3f0e9'),
      muted: col('--color-term-muted', '#b6b1a3'),
      legacy: col('--color-term-fail', '#e8805c'),
      system: col('--color-term-accent', '#d9d2ef'),
      agent: col('--color-term-ok', '#cbdac4'),
    };
    const field = createDrift({ cols: 7, rows: 6, driftSpeed: 1.4, seed: 11 });
    // the noise sits roughly in 0.25..0.75; stretch it so the clouds have dense cores and clear gaps
    const sample = (x: number, y: number, tt: number) => Math.min(1, Math.max(0, (field.sample(x, y, tt) - 0.25) * 2));

    let W = 0, H = 0, cw = 0, ch = 0, cols = 0, rows = 0, size = 12;
    // per row: the characters and the world (0 legacy, 1 system, 2 agent) each one belongs to
    let lines: { s: string; w: Uint8Array; off: number; speed: number }[] = [];
    let t = 0, frame = 0, timer = 0, visible = false;
    let px = -1e4, py = -1e4;

    // a row as long as the field is wide, plus a run-out for scrolling; the world shifts left to right with jitter
    const buildRow = (r: number) => {
      let s = '';
      const w: number[] = [];
      // seeded per row: the same field on every load, but no two rows alike
      const rnd = mulberry32(r * 101 + 7);
      const len = cols * 2;
      while (s.length < len) {
        const x = (s.length % cols) / cols + (rnd() - 0.5) * 0.16;
        const world = x < 0.36 ? 0 : x < 0.68 ? 1 : 2;
        const list = world === 0 ? LEGACY : world === 1 ? SYSTEM : AGENT;
        const word = list[Math.floor(rnd() * list.length)] + (rnd() < 0.2 ? ' · ' : rnd() < 0.5 ? '   ' : '  ');
        s += word;
        for (let i = 0; i < word.length; i++) w.push(world);
      }
      return { s, w: Uint8Array.from(w), off: 0, speed: 1 + (r % 3) };
    };

    const resize = () => {
      const rect = root.getBoundingClientRect();
      W = Math.max(1, Math.round(rect.width));
      H = Math.max(1, Math.round(rect.height));
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      size = W < 480 ? 10 : 12;
      cw = size * 0.6;
      ch = size * 1.6;
      cols = Math.ceil(W / cw) + 1;
      rows = Math.ceil(H / ch) + 1;
      lines = Array.from({ length: rows }, (_, r) => buildRow(r));
      ctx.font = `500 ${size}px 'Geist Mono Variable', ui-monospace, monospace`;
      ctx.textBaseline = 'top';
      draw();
    };

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      const pal = [C.legacy, C.system, C.agent];
      for (let r = 0; r < rows; r++) {
        const L = lines[r];
        const y = r * ch;
        const ny = y / H;
        for (let c = 0; c < cols; c++) {
          const i = (c + L.off) % L.s.length;
          const g = L.s[i];
          if (g === ' ') continue;
          const x = c * cw;
          const nx = x / W;
          // the cloud: noise, with the field thinning towards the seam on the left so the two worlds meet softly
          let v = sample(nx, ny, t) * (0.45 + 0.55 * Math.min(1, nx * 3));
          if (!quiet && fine) {
            const d = Math.hypot(x - px, y - py);
            if (d < 120) v += (1 - d / 120) * 0.6;
          }
          if (v < 0.22) {
            // under the cloud: a faint dot grid keeps the texture
            if ((c + r) % 4 === 0) {
              ctx.globalAlpha = quiet ? 0.08 : 0.14;
              ctx.fillStyle = C.muted;
              ctx.fillText('·', x, y);
            }
            continue;
          }
          const a = Math.min(1, (v - 0.22) * 1.6);
          // dim text everywhere under the cloud; the cores light up in their world's colour, the very brightest in ink
          ctx.globalAlpha = (quiet ? 0.16 : 0.92) * (0.25 + 0.75 * a);
          // quiet (behind text): one muted tone, so nothing in the texture competes with a link
          ctx.fillStyle = quiet ? C.muted : a > 0.88 ? C.ink : a > 0.55 ? pal[L.w[i]] : C.muted;
          ctx.fillText(g, x, y);
        }
      }
      ctx.globalAlpha = 1;
    };

    const step = () => {
      frame++;
      t += 0.08;
      lines.forEach((L) => {
        if (frame % (L.speed + 1) === 0) L.off = (L.off + 1) % L.s.length;
      });
      draw();
    };

    const run = () => {
      window.clearInterval(timer);
      if (visible && !reduced) timer = window.setInterval(step, 83);
    };

    new ResizeObserver(() => resize()).observe(root);
    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      run();
    }).observe(root);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearInterval(timer);
      else run();
    });
    if (!quiet && fine && !reduced) {
      // the field sits under the copy, so listen on its section rather than the canvas
      const host = root.closest('section, footer') ?? root;
      host.addEventListener('pointermove', (e) => {
        const r = root.getBoundingClientRect();
        px = (e as PointerEvent).clientX - r.left;
        py = (e as PointerEvent).clientY - r.top;
      });
      host.addEventListener('pointerleave', () => ((px = -1e4), (py = -1e4)));
    }
    // canvas text needs the mono face loaded, or the first frame draws in the fallback
    document.fonts?.ready.then(resize);
  });
</script>
