---
/**
 * Direction A: a real product screen, ordered-dithered into the page's two colours, read by a
 * scan line (after Builders Table's SCAN.RAW windows). Above the line the screen turns accent:
 * read. The log under it shows statuses only, no invented counts (labelled "example").
 */
interface Props {
  src: string;
  /** source image size, for the aspect ratio before the canvas paints */
  w: number;
  h: number;
  tag: string;
  file: string;
  /** pixel columns of the dither; fewer = chunkier */
  cols?: number;
  log?: string[];
  /** log beside the screen instead of under it (wide hero) */
  side?: boolean;
}
const { src, w, h, tag, file, cols = 240, log = [], side = false } = Astro.props;
---

<figure class:list={['ds m-0', side && 'ds--side']} data-ds data-src={src} data-cols={cols} data-ar={w / h} style={`--ar: ${w} / ${h}`}>
  <div class="ds-bar">
    <span class="ds-tag">{tag}</span>
    <span class="ds-file">{file}</span>
  </div>
  <div class="ds-body">
  <div class="ds-stage a-grain">
    <canvas class="ds-canvas" aria-hidden="true"></canvas>
    <i class="ds-h ds-h--tl" aria-hidden="true"></i><i class="ds-h ds-h--tr" aria-hidden="true"></i><i
      class="ds-h ds-h--bl"
      aria-hidden="true"></i><i class="ds-h ds-h--br" aria-hidden="true"></i>
  </div>
  {
    log.length > 0 && (
      <ol class="ds-log" aria-hidden="true">
        {log.map((l, i) => (
          <li data-at={(i + 1) / (log.length + 1)}>{l}</li>
        ))}
      </ol>
    )
  }
  </div>
  <figcaption class="sr-only">An example product screen being read line by line.</figcaption>
</figure>

<style>
  .ds {
    position: relative;
    border: 1px solid var(--a-rule);
    background: var(--color-page);
  }
  .ds-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--a-rule);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ds-tag {
    padding: 2px 6px;
    background: var(--a-block);
    color: var(--a-on-block);
  }
  .ds-file {
    color: var(--color-muted);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .ds-stage {
    position: relative;
    aspect-ratio: var(--ar);
    margin: 14px;
  }
  .ds-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  /* selection handles at the corners, like a frame picked in a design tool */
  .ds-h {
    position: absolute;
    width: 7px;
    height: 7px;
    background: var(--color-page);
    border: 1px solid var(--color-ink);
  }
  .ds-h--tl { left: -4px; top: -4px; }
  .ds-h--tr { right: -4px; top: -4px; }
  .ds-h--bl { left: -4px; bottom: -4px; }
  .ds-h--br { right: -4px; bottom: -4px; }
  .ds-log {
    margin: 0;
    padding: 10px 14px 14px;
    list-style: none;
    border-top: 1px solid var(--a-rule);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.75;
    white-space: pre;
    color: var(--color-muted);
  }
  .ds--side .ds-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
  }
  .ds--side .ds-log {
    border-top: 0;
    border-left: 1px solid var(--a-rule);
    padding: 18px 18px;
    align-self: stretch;
  }
  @media (max-width: 860px) {
    .ds--side .ds-body {
      grid-template-columns: 1fr;
    }
    .ds--side .ds-log {
      border-left: 0;
      border-top: 1px solid var(--a-rule);
    }
  }
  .ds-log li {
    transition: color 200ms var(--ease-out);
  }
  .ds-log li.is-on {
    color: var(--color-ink);
  }
  .ds-log li.is-on::marker {
    content: '';
  }
</style>

<script>
  // 8×8 Bayer matrix, normalised to 0..1
  const B = [
    0, 32, 8, 40, 2, 34, 10, 42, 48, 16, 56, 24, 50, 18, 58, 26, 12, 44, 4, 36, 14, 46, 6, 38, 60, 28, 52, 20, 62, 30, 54,
    22, 3, 35, 11, 43, 1, 33, 9, 41, 51, 19, 59, 27, 49, 17, 57, 25, 15, 47, 7, 39, 13, 45, 5, 37, 63, 31, 55, 23, 61, 29,
    53, 21,
  ].map((v) => (v + 0.5) / 64);

  const hex = (s: string): [number, number, number] => {
    const m = s.trim().replace('#', '');
    const n = m.length === 3 ? m.split('').map((c) => c + c).join('') : m;
    return [parseInt(n.slice(0, 2), 16), parseInt(n.slice(2, 4), 16), parseInt(n.slice(4, 6), 16)];
  };

  function mount(fig: HTMLElement) {
    const canvas = fig.querySelector<HTMLCanvasElement>('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const logs = Array.from(fig.querySelectorAll<HTMLElement>('.ds-log li'));
    const cols = Number(fig.dataset.cols) || 240;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const img = new Image();
    img.decoding = 'async';
    img.src = fig.dataset.src!;
    let on: Uint8Array;
    let W = 0;
    let H = 0;
    let data: ImageData;
    let colors = { ink: [0, 0, 0], accent: [0, 0, 0] } as Record<string, number[]>;
    let raf = 0;
    let start = 0;

    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      colors = { ink: hex(cs.getPropertyValue('--color-ink')), accent: hex(cs.getPropertyValue('--color-accent')) };
    };

    const build = () => {
      // the frame's aspect can be wider than the screen: crop from the top, full width
      const ar = Number(fig.dataset.ar) || img.naturalWidth / img.naturalHeight;
      W = cols;
      H = Math.round(cols / ar);
      const srcH = Math.min(img.naturalHeight, img.naturalWidth / ar);
      const off = document.createElement('canvas');
      off.width = W;
      off.height = H;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      o.drawImage(img, 0, 0, img.naturalWidth, srcH, 0, 0, W, H);
      const px = o.getImageData(0, 0, W, H).data;
      // product screens are light UIs: the "on" pixels are their dark marks (text, borders, icons),
      // so the screen reads as a line drawing in either theme
      on = new Uint8Array(W * H);
      for (let y = 0; y < H; y++)
        for (let x = 0; x < W; x++) {
          const i = (y * W + x) * 4;
          let l = 1 - (0.2126 * px[i] + 0.7152 * px[i + 1] + 0.0722 * px[i + 2]) / 255;
          // stretch: the grey app background becomes a light dot texture, white cards stay empty,
          // so panels read as shapes and text, borders and the nav read solid
          l = Math.min(1, l * 2.4);
          on[y * W + x] = l > B[(y % 8) * 8 + (x % 8)] ? 1 : 0;
        }
      canvas.width = W;
      canvas.height = H;
      data = ctx.createImageData(W, H);
    };

    const paint = (line: number) => {
      const d = data.data;
      const [ir, ig, ib] = colors.ink;
      const [ar, ag, ab] = colors.accent;
      for (let y = 0; y < H; y++) {
        const read = y < line;
        const isLine = y >= line && y < line + 2;
        for (let x = 0; x < W; x++) {
          const k = (y * W + x) * 4;
          const lit = on[y * W + x];
          if (isLine) {
            d[k] = ir; d[k + 1] = ig; d[k + 2] = ib; d[k + 3] = 255;
          } else if (lit) {
            if (read) { d[k] = ar; d[k + 1] = ag; d[k + 2] = ab; d[k + 3] = 255; }
            else { d[k] = ir; d[k + 1] = ig; d[k + 2] = ib; d[k + 3] = 92; }
          } else d[k + 3] = 0;
        }
      }
      ctx.putImageData(data, 0, 0);
      const p = line / H;
      logs.forEach((li) => li.classList.toggle('is-on', p >= Number(li.dataset.at)));
    };

    const DUR = 4200;
    const HOLD = 1600;
    const loop = (t: number) => {
      if (!start) start = t;
      const e = (t - start) % (DUR + HOLD);
      paint(e < DUR ? Math.floor((e / DUR) * (H + 2)) : H + 2);
      raf = requestAnimationFrame(loop);
    };

    const run = () => {
      cancelAnimationFrame(raf);
      if (reduced) return paint(H + 2);
      start = 0;
      raf = requestAnimationFrame(loop);
    };

    img.onload = () => {
      readColors();
      build();
      paint(reduced ? H + 2 : 0);
      new IntersectionObserver((es) => {
        if (es[0].isIntersecting) run();
        else cancelAnimationFrame(raf);
      }).observe(fig);
      // re-dither when the theme flips (the "on" pixels swap polarity)
      new MutationObserver(() => {
        readColors();
        build();
        if (reduced) paint(H + 2);
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    };
  }
  document.querySelectorAll<HTMLElement>('[data-ds]').forEach(mount);
</script>
