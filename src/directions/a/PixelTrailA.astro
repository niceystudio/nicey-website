---
/**
 * Direction A hero field (27 Nov, after craft.wild.as): crisp pastel cells in slow diagonal bands, and the pointer
 * leaves a trail through them: cells it passes turn accent, the ones right under it hot, then cool back down.
 * Replaces the soft fused wash (PixelFieldA) on the homepage hero; the wash stays on the other heroes.
 *
 * Fills its positioned parent and fades out towards the headline on the left. Decorative (aria-hidden), no pointer
 * events of its own: it listens on the closest <section>, so the links on top keep working.
 * Mouse and pen only. Reduced motion: one still frame, no trail. Engine: src/lib/pixel-scenes.ts.
 */
interface Props {
  seed?: number;
  /** cell size in px */
  cell?: number;
  class?: string;
}
const { seed = 7, cell = 12, class: cls } = Astro.props;
---

<div class:list={['pt', cls]} aria-hidden="true">
  <canvas data-pt data-seed={seed} data-cell={cell}></canvas>
</div>

<style>
  .pt {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .pt canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { mountScene, valueNoise, smooth, cell as drawCell, type Scene } from '../../lib/pixel-scenes';

  interface Trail extends Scene {
    size: number;
    cols: number;
    rows: number;
    heat: Float32Array;
    noise: (x: number, y: number) => number;
    lastDraw: number;
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-pt]').forEach((canvas) => {
    const size = Number(canvas.dataset.cell) || 12;
    mountScene<Trail>(
      canvas,
      {
        host: canvas.closest('section'),
        threshold: 0.05,
        layout(s) {
          s.cols = Math.ceil(s.W / s.size);
          s.rows = Math.ceil(s.H / s.size);
          s.heat = new Float32Array(s.cols * s.rows);
        },
        // the pointer heats a small round brush of cells
        onMove(s) {
          const cx = Math.floor(s.px / s.size), cy = Math.floor(s.py / s.size);
          for (let dy = -2; dy <= 2; dy++)
            for (let dx = -2; dx <= 2; dx++) {
              const x = cx + dx, y = cy + dy, d = Math.hypot(dx, dy);
              if (x < 0 || y < 0 || x >= s.cols || y >= s.rows || d > 2.3) continue;
              const i = y * s.cols + x;
              s.heat[i] = Math.min(1, s.heat[i] + (d < 1 ? 0.9 : 0.45));
            }
        },
        draw(s, c, t) {
          // calm: ~12fps is enough for the slow drift; a live trail gets the full 30
          let warm = false;
          for (let i = 0; i < s.heat.length; i++) if (s.heat[i] > 0.02) { warm = true; break; }
          if (!warm && !s.reduced && t - s.lastDraw < 0.08 && s.lastDraw > 0) return true;
          s.lastDraw = t;
          const { ctx, cols, rows } = s, z = s.size;
          const bands = [c.sage, c.lavender, c.peach, c.butter, c.mauve];
          const drift = s.reduced ? 0 : t * 0.05;
          const from = s.W < 768 ? 0.62 : 0.4;
          ctx.clearRect(0, 0, s.W, s.H);
          for (let y = 0; y < rows; y++)
            for (let x = 0; x < cols; x++) {
              const i = y * cols + x, px = x * z, py = y * z;
              // gone left of ~40% (the headline), full from ~70%; on a phone the copy runs the full width, so later
              const fx = smooth(Math.min(1, Math.max(0, (px / s.W - from) / 0.3)));
              const fy = Math.min(1, py / 48, (s.H - py) / 72);
              const v = s.noise(x * 0.07 + drift, y * 0.07 - x * 0.03) * 0.9 + (x / cols) * 0.25 - (1 - fx) * 0.9 - (1 - Math.max(0, fy)) * 0.6;
              // the trail only shows inside the field, never over the headline
              const h = s.heat[i] * fx;
              if (s.heat[i] > 0.02) s.heat[i] *= 0.92;
              if (v < 0.32 && h < 0.08) continue;
              ctx.fillStyle = h > 0.55 ? c.hot : h > 0.18 ? c.accent : bands[Math.min(4, Math.max(0, Math.floor((v - 0.32) * 12)))];
              drawCell(ctx, px, py, z);
            }
          return true;
        },
      },
      { size, cols: 0, rows: 0, heat: new Float32Array(0), noise: valueNoise(Number(canvas.dataset.seed) || 7), lastDraw: 0 },
    );
  });
</script>
