---
/**
 * Direction A: "When to bring us in" without blocks (Emir, 16 Nov: not every section needs cards).
 * Read like a diagnostic printout: one ruled row per symptom, its code on the left, the evidence,
 * and the real signal as a pixel meter on the right. Same copy and the same real counts as live.
 */
import UnitChart from '../../components/UnitChart.astro';

const rows = [
  {
    code: 'S/01',
    title: 'Your design file and your repo have drifted apart',
    body: 'At Everbreed, 53 variables had drifted between Figma and code, and nobody could tell a rename from a delete.',
    chart: { count: 53, hot: 53, columns: 27, cell: 7, label: '53 cells, one per drifted variable' },
    signal: '53 drifted variables',
  },
  {
    code: 'S/02',
    title: 'The product was built for years without a designer',
    body: 'At QBench, every screen was a developer’s best guess, and each new feature meant relearning decisions nobody wrote down.',
    chart: { count: 11, hot: 11, columns: 11, cell: 15, label: '11 cells, one per outside library the components leaned on' },
    signal: '11 outside libraries behind the components',
  },
  {
    code: 'S/03',
    title: 'The library looks healthy, but a machine can’t use it',
    body: 'At Everbreed, all 302 variables had no scope and no code name. Fine for people, unreadable for a pipeline.',
    chart: { count: 302, columns: 38, cell: 5, label: '302 cells, one per variable, none with a scope' },
    signal: '302 variables · 0 scoped',
  },
  {
    code: 'S/04',
    title: 'Your team is handing design to AI agents',
    body: 'A developer fills the gaps in a Figma file. An agent guesses, and every guess becomes a correction pass.',
    chart: { count: 239, ok: true, columns: 38, cell: 5, label: '239 cells, one per layer an agent built, none flagged' },
    signal: '239 agent-built layers · 0 issues',
  },
];
---

<section aria-labelledby="when-head" class="container-page wa-sec">
  <div class="wa-head">
    <div class="flex flex-col gap-3.5">
      <span class="caption a-path text-ink-2">When to bring us in</span>
      <h2 id="when-head" class="m-0 text-h2 max-w-[17ch]">If one of these sounds like your team, talk to us.</h2>
    </div>
  </div>
  <div>
  <p class="wa-legend m-0" aria-hidden="true">
    <span>code</span><span>symptom</span><span>seen at</span><span>signal</span>
  </p>
  <ol class="wa">
    {
      rows.map((r) => (
        <li class="wa-row">
          <span class="wa-code">{r.code}</span>
          <h3 class="wa-title m-0">{r.title}</h3>
          <p class="wa-body m-0">{r.body}</p>
          <div class="wa-sig">
            <UnitChart {...r.chart} />
            <span class="wa-sig-cap">{r.signal}</span>
          </div>
        </li>
      ))
    }
  </ol>
  </div>
</section>

<style>
  .wa-sec {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: var(--spacing-section);
    padding-bottom: var(--spacing-section);
  }
  .wa-legend,
  .wa-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1.05fr) minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 16px 36px;
  }
  .wa-legend {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .wa {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wa-row {
    position: relative;
    align-items: start;
    padding: 30px 0 32px;
    border-bottom: 1px solid var(--a-rule);
    transition: background-color 200ms var(--ease-out);
  }
  .wa-row::before {
    content: '';
    position: absolute;
    left: -16px;
    top: -1px;
    bottom: -1px;
    width: 3px;
    background: var(--a-block);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .wa-row:hover::before {
      transform: scaleY(1);
    }
    .wa-row:hover .wa-code {
      color: var(--color-accent);
    }
  }
  .wa-code {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--color-ink-2);
    transition: color 200ms var(--ease-out);
  }
  .wa-title {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: 25px;
    line-height: 1.12;
    text-wrap: balance;
  }
  .wa-body {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .wa-sig {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .wa-sig-cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (max-width: 960px) {
    .wa-legend {
      display: none;
    }
    .wa {
      margin-top: 0;
      border-top: 1px solid var(--color-ink);
    }
    .wa-row {
      grid-template-columns: 56px minmax(0, 1fr);
    }
    .wa-body,
    .wa-sig {
      grid-column: 2;
    }
  }
</style>
