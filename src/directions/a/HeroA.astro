---
/**
 * Direction A hero (Select layout). The headline loads like the Supabase Select logotype: pixel capitals printed on
 * blocks, the last line on the accent — then the blocks fade and it rests as plain pixel text (Goran, 25 Nov; the
 * section headings below keep the printed blocks, .h-print). Reduced motion: plain text from the start. Below it one ruled row: the lede on the headline's left edge, the two keys
 * flush with the container's right edge, both sitting on the same bottom line (Emir 19 Nov: text and buttons were
 * not aligned). The "Selected work" strip moved out of the hero into its own band (SelectedA) after the ASCII band.
 */
import { links } from '../../data/links';
import Button from '../../components/ui/Button.astro';
import PixelFieldA from './PixelFieldA.astro';
---

<section class="ha">
  <PixelFieldA mode="drift" fade="left" class="ha-field" />
  <div class="container-page ha-in">
    <h1 class="ha-h m-0">
      <span class="ha-line">Designing</span>
      <span class="ha-line">systems that</span>
      <span class="ha-line ha-line--accent">scale products.</span>
    </h1>
    <div class="ha-aside">
      <p class="ha-lede m-0">
        Send us your Figma file. You get a score per pillar, the top findings and what to fix first. Free, and we never
        edit your file.
      </p>
      <div class="ha-ctas">
        {/* Goran 24 Nov: one action here — Get a free audit is already in the nav */}
        <Button href={links.bookCall} target="_blank" rel="noopener">Book a call</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .ha {
    position: relative;
    overflow: hidden;
    padding-top: var(--spacing-3xl);
    padding-bottom: var(--spacing-2xl);
  }
  /* the pixel field sits on the right half and fades out towards the headline */
  .ha :global(.ha-field) {
    left: 38%;
  }
  @media (max-width: 767px) {
    .ha :global(.ha-field) {
      left: 0;
      opacity: 0.6;
    }
  }
  .ha-in {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
  }
  /* under the headline: the lede, then the one action right below it on the same left edge
     (Emir 24 Nov: the button sat too far from the text at the right edge) */
  .ha-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-lg);
  }
  @media (max-width: 1023px) {
    .ha {
      padding-top: var(--spacing-2xl);
    }
    .ha-in {
      gap: var(--spacing-xl);
    }
  }
  .ha-h {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(36px, 8.4vw, 116px);
    line-height: 1;
    letter-spacing: -0.05em;
  }
  /* premium (27 Nov): sans, sentence case, the last line in the accent */
  .ha-line {
    display: inline-block;
    white-space: nowrap;
    padding-bottom: 0.04em;
    color: var(--color-ink);
  }
  .ha-line--accent {
    color: var(--color-accent);
  }
  .ha-lede {
    max-width: 44ch;
    font-size: var(--text-cta);
    line-height: 1.45;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .ha-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs);
  }
  /* on load: each line rises in softly, one after the other (the printed blocks belong to the terminal look) */
  @media (prefers-reduced-motion: no-preference) {
    .ha-line {
      animation: ha-rise 900ms var(--ease-out) both;
    }
    .ha-line:nth-child(2) {
      animation-delay: 90ms;
    }
    .ha-line:nth-child(3) {
      animation-delay: 180ms;
    }
  }
  @keyframes ha-rise {
    from {
      opacity: 0;
      transform: translateY(0.18em);
    }
  }
</style>
