---
/**
 * Direction A hero (Select layout: headline across, text + CTAs beside it). The headline is set like the Supabase Select logotype:
 * pixel capitals printed on blocks, the last line on the accent. The audit scan visual was removed (Emir 18 Nov: too much noise).
 */
import { links } from '../../data/links';

const proof = ['QBench', 'Everbreed', 'Clerky', 'Omnisafe', 'FLYR'].map((name) => ({ name, href: `#work-${name.toLowerCase()}` }));
---

<section class="ha">
  <div class="container-page ha-meta">
    <nav class="ha-proof" aria-label="Selected work">
      <span class="text-muted">Selected work</span>
      {
        proof.map((p, i) => (
          <a href={p.href}>
            <span class="text-muted">{String(i + 1).padStart(2, '0')}</span>
            {p.name}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="container-page ha-top">
    <h1 class="ha-h m-0">
      <span class="ha-line">Is your design</span>
      <span class="ha-line">system ready</span>
      <span class="ha-line ha-line--accent">for AI agents?</span>
    </h1>
    <div class="ha-aside">
      <p class="ha-lede m-0">
        Send us your Figma file. You get a score per pillar, the top findings and what to fix first. Free, and we never
        edit your file.
      </p>
      <div class="ha-ctas">
        <a href="#audit" class="pill pill-ink pill-lg" aria-keyshortcuts="a">
          Get a free audit<span class="a-key" aria-hidden="true">A</span>
        </a>
        <a href={links.bookCall} class="pill pill-outline pill-lg" aria-keyshortcuts="b">
          Book a call<span class="a-key" aria-hidden="true">B</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ha {
    padding-top: 28px;
    padding-bottom: 56px;
  }
  .ha-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--a-rule);
  }
  .ha-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ha-proof a {
    display: inline-flex;
    gap: 8px;
    color: var(--color-ink);
    text-decoration: none;
    transition: color 160ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .ha-proof a:hover {
      color: var(--color-accent);
    }
  }
  /* Select's top: the headline across, then one row of three — text, keys, the line after */
  .ha-top {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding-top: 64px;
  }
  .ha-aside {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 24px 48px;
    padding-top: 22px;
    border-top: 1px solid var(--a-rule);
  }
  @media (max-width: 1023px) {
    .ha-top {
      padding-top: 40px;
    }
    .ha-aside {
      grid-template-columns: 1fr;
    }
  }
  .ha-h {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: clamp(32px, 7.6vw, 108px);
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }
  .ha-line {
    display: inline-block;
    white-space: nowrap;
    padding: 0.06em 0.14em 0.02em;
    background: var(--color-ink);
    color: var(--color-page);
  }
  .ha-line--accent {
    background: var(--a-block);
    color: var(--a-on-block);
  }
  .ha-lede {
    max-width: 40ch;
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .ha-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* the headline prints line by line on first view */
  @media (prefers-reduced-motion: no-preference) {
    .ha-line {
      animation: ha-print 520ms steps(6, end) both;
    }
    .ha-line:nth-child(2) {
      animation-delay: 140ms;
    }
    .ha-line:nth-child(3) {
      animation-delay: 280ms;
    }
  }
  @keyframes ha-print {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
