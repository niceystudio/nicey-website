---
/**
 * Hero, 27 Nov ("two worlds", after contentarchitecture.dev's split hero and dive; our own motif):
 *
 *   people  cream, left: what we do, in plain words, and the two actions
 *   agents  charcoal, right: the values a legacy product really carries (#6b5fbe, purple-2, btn-new-final…),
 *           scattered. Scroll and the agent world takes the whole screen while the drift collapses: every scattered
 *           value travels to the one token it should have been, duplicates merge, and a clean system is left.
 *           Then the line it all means: "Legacy in. One system out."
 *
 * Desktop with motion: the section is a scroll track and the stage is pinned while it plays (no scroll hijack, the
 * page scrolls normally). Phones and reduced motion: no pin; the agent panel sits under the copy, and reduced motion
 * shows the collapsed system as a still frame. The canvas is decorative; the closing line is real text.
 */
import { links } from '../../data/links';
import Button from '../../components/ui/Button.astro';
---

<section class="ha" aria-labelledby="ha-head" data-ha>
  <div class="ha-stick">
    <div class="ha-people" data-ha-people>
      <p class="caption m-0 ha-eyebrow">Design systems · legacy to agentic</p>
      <h1 id="ha-head" class="ha-h m-0">Design systems people and agents read the same&nbsp;way.</h1>
      <p class="ha-lede m-0">
        We bridge design and engineering. Your legacy UI becomes one system of tokens, components and docs that
        designers, engineers and coding agents all build on.
      </p>
      <div class="ha-ctas">
        <Button href={links.bookCall} target="_blank" rel="noopener">Book a call</Button>
        <Button href="#audit" variant="secondary">Free audit</Button>
      </div>
      <p class="ha-cue caption m-0" aria-hidden="true"><span class="ha-cue-dot"></span>Scroll to consolidate</p>
    </div>
    <div class="ha-agents world-dark" data-ha-agents>
      <canvas class="ha-c" data-ha-canvas aria-hidden="true"></canvas>
      <div class="ha-end" data-ha-end>
        <p class="caption m-0 ha-end-k">What the drift was always trying to be</p>
        <p class="ha-end-h m-0">Legacy in.<br />One system out.</p>
        <p class="ha-end-sub m-0">Dozens of near-duplicate values become a few named tokens, bound in Figma and in code, so a coding agent picks the right one every time.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* the floating header sits over the hero, so the two worlds run to the top edge */
  .ha {
    position: relative;
    margin-top: calc(-1 * var(--head-h));
  }
  .ha-stick {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .ha-people {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-md);
    padding: calc(var(--head-h) + var(--spacing-2xl)) var(--spacing-gutter) var(--spacing-2xl);
  }
  .ha-eyebrow {
    color: var(--color-ink);
    text-transform: uppercase;
  }
  .ha-h {
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(36px, 3.9vw, 56px);
    line-height: 1.04;
    letter-spacing: var(--display-tracking);
    text-transform: var(--display-case);
    color: var(--color-ink);
  }
  .ha-lede {
    max-width: 44ch;
    font-size: var(--text-lede);
    line-height: 1.45;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
  .ha-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2xs);
    margin-top: var(--spacing-xs);
  }
  .ha-cue {
    display: none;
    align-items: center;
    gap: var(--spacing-2xs);
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .ha-cue-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
  }
  /* phones: the table settles at the top of the panel, the closing line holds the bottom */
  .ha-agents {
    position: relative;
    min-height: 700px;
    overflow: hidden;
  }
  .ha-c {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* the closing line: real text, revealed when the system has settled */
  .ha-end {
    position: absolute;
    left: var(--spacing-gutter);
    right: var(--spacing-gutter);
    bottom: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xs);
  }
  .ha-end-k {
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .ha-end-sub {
    max-width: 42ch;
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .ha-end-h {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: var(--display-tracking);
    color: var(--color-ink);
  }

  /* ---------- desktop: pinned split that dives into the agent world ---------- */
  @media (min-width: 1024px) {
    .ha-stick {
      height: 100svh;
      min-height: 640px;
      grid-template-columns: 1fr 1fr;
    }
    .ha-people {
      justify-content: center;
      padding: var(--head-h) var(--spacing-2xl) var(--spacing-xl)
        max(var(--spacing-gutter), calc((100vw - var(--container-page)) / 2 + var(--spacing-gutter)));
    }
    .ha-cue {
      display: inline-flex;
      position: absolute;
      bottom: var(--spacing-lg);
    }
    /* the agent world is a full-width layer, clipped to the right half until the dive opens it */
    .ha-agents {
      position: absolute;
      inset: 0;
      min-height: 0;
      clip-path: inset(0 0 0 calc(50% * (1 - var(--e, 0))));
    }
    .ha-end {
      left: max(var(--spacing-gutter), calc((100vw - var(--container-page)) / 2 + var(--spacing-gutter)));
      right: auto;
      top: 50%;
      bottom: auto;
      max-width: 40%;
      translate: 0 -50%;
      gap: var(--spacing-sm);
    }
    .ha-end-h {
      font-size: clamp(40px, 4.4vw, 64px);
    }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .ha {
      height: 260svh;
    }
    .ha-stick {
      position: sticky;
      top: 0;
    }
    .ha-people {
      opacity: calc(1 - var(--e, 0) * 1.6);
      transform: translateX(calc(var(--e, 0) * -48px));
    }
    .ha-end {
      opacity: var(--f, 0);
      transform: translateY(calc((1 - var(--f, 0)) * 16px));
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 1023px) {
    .ha-end {
      opacity: var(--f, 0);
    }
  }
</style>

<script>
  import { mulberry32 } from '../../lib/pixel-field';

  // what a legacy product carries, and the token each one should have been (index into TOKENS)
  const DRIFT: [string, number][] = [
    ['#6b5fbe', 0], ['purple-2', 0], ['purpleLight2', 0], ['brand/purple/30', 0], ['violet-final', 0], ['#7266c4', 0],
    ['#26251f', 1], ['black-ish', 1], ['text-dark-2', 1], ['#333', 1],
    ['#716e63', 2], ['grey-light-2', 2], ['muted_OLD', 2], ['#8a877c', 2],
    ['margin:13px', 3], ['pad-15', 3], ['gap: 1.1rem', 3], ['spacing-md2', 3],
    ['border-radius:7px', 4], ['rounded-ish', 4], ['r-6', 4],
    ['1px solid #ddd', 5], ['line-light', 5], ['divider-2', 5],
    ['Button_v2_OLD', 6], ['btn-new-final', 6], ['PrimaryBtn', 6], ['CTA-button', 6],
    ['Input_legacy', 7], ['TextField2', 7], ['input-new', 7],
    ['opacity: .4', 8], ['disabled-grey', 8], ['z-index:9999', 9], ['!important', 9], ['zTop', 9],
    ['h2-copy', 10], ['Title_Large', 10], ['font-size:31px', 10],
    ['#c4471f', 11], ['error-red', 11], ['danger2', 11],
  ];
  const TOKENS = [
    'color.accent', 'text/default', 'text/muted', 'space.4', 'radius.panel', 'border/default',
    'Button', 'Input', 'opacity/disabled', 'layer.overlay', 'type.heading.2', 'color.critical',
  ];
  const B = 34; // token row width in characters
  const ROWS = TOKENS.map((t, i) => {
    const num = String(i + 1).padStart(2, '0');
    return { num, name: t, dots: ' ' + '·'.repeat(Math.max(1, B - t.length - 2)) + ' ' };
  });

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desk = window.matchMedia('(min-width: 1024px)');
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (v: number) => (v < 0.5 ? 4 * v * v * v : 1 - Math.pow(-2 * v + 2, 3) / 2);

  document.querySelectorAll<HTMLElement>('[data-ha]').forEach((hero) => {
    const agents = hero.querySelector<HTMLElement>('[data-ha-agents]')!;
    const canvas = hero.querySelector<HTMLCanvasElement>('[data-ha-canvas]')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const cs = getComputedStyle(agents);
    const C = {
      ink: cs.getPropertyValue('--color-ink').trim() || '#f3f0e9',
      ink2: cs.getPropertyValue('--color-ink-2').trim() || '#cbc6b8',
      muted: cs.getPropertyValue('--color-muted').trim() || '#a29e92',
      hot: cs.getPropertyValue('--color-hot').trim() || '#ff8a66',
      accent: cs.getPropertyValue('--color-accent').trim() || '#a79bea',
    };
    const rnd = mulberry32(42);
    const words = DRIFT.map(([text, tok], i) => ({
      text,
      tok,
      u: rnd(), // scattered position, normalised within the visible agent area
      v: 0.08 + rnd() * 0.8,
      rot: (rnd() - 0.5) * 0.7,
      size: 11 + Math.round(rnd() * 7),
      hot: rnd() < 0.3,
      ph: rnd() * Math.PI * 2,
      lead: DRIFT.findIndex(([, t]) => t === tok) === i, // the one that becomes the token row
    }));

    let W = 0, H = 0, time = 0, raf = 0, visible = false, last = 0;
    let state = { e: 0, c: 0, f: 0 };

    const resize = () => {
      const r = agents.getBoundingClientRect();
      W = Math.max(1, Math.round(r.width));
      H = Math.max(1, Math.round(r.height));
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    };

    // scroll → three phases: e (the dive opens the agent world), c (the drift collapses), f (the line appears)
    const measure = () => {
      if (reduced) return { e: 1, c: 1, f: 1 };
      const r = hero.getBoundingClientRect();
      const vh = window.innerHeight;
      if (desk.matches) {
        const p = clamp(-r.top / Math.max(1, r.height - vh));
        return { e: ease(clamp((p - 0.04) / 0.32)), c: ease(clamp((p - 0.26) / 0.46)), f: clamp((p - 0.7) / 0.18) };
      }
      const a = agents.getBoundingClientRect();
      const p = clamp((vh - a.top) / (vh * 0.9 + a.height * 0.4));
      return { e: 1, c: ease(clamp((p - 0.2) / 0.6)), f: clamp((p - 0.75) / 0.25) };
    };

    const draw = () => {
      const { e, c } = state;
      ctx.clearRect(0, 0, W, H);
      // the visible part of the agent world (desktop clips the left half until the dive)
      const left = desk.matches ? (W / 2) * (1 - e) : 0;
      const areaW = W - left;
      // where the system lands: a column of token rows, centred on what's visible, above the closing line
      const fs = Math.max(12, Math.min(15, W / 90));
      const cw = fs * 0.6;
      const rowH = fs * 1.75;
      const tableW = (2 + 2 + B + 2) * cw;
      // desktop: the table settles in the right column, the closing line holds the left; phones: centred, above it
      const tx = desk.matches ? left + areaW * 0.75 - tableW / 2 + areaW * 0.02 : left + (areaW - tableW) / 2;
      const ty = desk.matches
        ? (H - ROWS.length * rowH) / 2 + rowH
        : fs * 6;
      // prompt above the table
      ctx.textBaseline = 'middle';
      if (c > 0.6) {
        ctx.globalAlpha = clamp((c - 0.6) / 0.3);
        ctx.font = `400 ${fs}px 'Geist Mono Variable', ui-monospace, monospace`;
        ctx.fillStyle = C.accent;
        ctx.fillText('~/your-product', tx, ty - rowH * 1.5);
        ctx.fillStyle = C.ink2;
        ctx.fillText(' > nicey consolidate --into tokens', tx + 14 * cw, ty - rowH * 1.5);
      }
      for (const w of words) {
        const drift = desk.matches && !reduced ? Math.sin(time * 0.0006 + w.ph) * 10 * (1 - c) : 0;
        const sx = left + w.u * (areaW - 160) + 20 + drift;
        const sy = w.v * H + Math.cos(time * 0.0005 + w.ph) * 6 * (1 - c);
        const row = ROWS[w.tok];
        const ex = tx + 4 * cw;
        const ey = ty + w.tok * rowH;
        const x = sx + (ex - sx) * c;
        const y = sy + (ey - sy) * c;
        const size = w.size + (fs - w.size) * c;
        // duplicates merge into the lead; past halfway the lead shows the token it became
        let alpha = 1;
        if (!w.lead) alpha = 1 - clamp((c - 0.55) / 0.35);
        if (alpha <= 0.01) continue;
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(w.rot * (1 - c));
        ctx.font = `400 ${size}px 'Geist Mono Variable', ui-monospace, monospace`;
        ctx.globalAlpha = alpha * (0.55 + 0.45 * c);
        const showToken = w.lead && c > 0.5;
        ctx.fillStyle = showToken ? C.ink : w.hot ? C.hot : c > 0.4 ? C.ink2 : C.muted;
        ctx.fillText(showToken ? row.name : w.text, 0, 0);
        ctx.restore();
        if (showToken) {
          // the rest of the row arrives with it: number, leader dots, the bound marker
          const k = clamp((c - 0.75) / 0.25);
          ctx.globalAlpha = k;
          ctx.font = `400 ${fs}px 'Geist Mono Variable', ui-monospace, monospace`;
          ctx.fillStyle = C.muted;
          ctx.fillText(row.num, tx, ey);
          const nameW = ctx.measureText(row.name).width;
          ctx.fillText(row.dots, ex + nameW, ey);
          ctx.fillStyle = C.accent;
          ctx.fillRect(ex + nameW + ctx.measureText(row.dots).width, ey - fs * 0.32, fs * 0.64, fs * 0.64);
        }
      }
      ctx.globalAlpha = 1;
    };

    const apply = () => {
      state = measure();
      hero.style.setProperty('--e', state.e.toFixed(4));
      hero.style.setProperty('--f', state.f.toFixed(4));
      draw();
    };

    // idle float while scattered, at ~30fps, only on screen
    const loop = (ts: number) => {
      raf = 0;
      if (!visible) return;
      if (ts - last > 33) {
        last = ts;
        time = ts;
        if (state.c < 1) draw();
      }
      if (!reduced && state.c < 1) raf = requestAnimationFrame(loop);
    };
    const kick = () => {
      if (!raf && visible && !reduced) raf = requestAnimationFrame(loop);
    };

    new ResizeObserver(() => resize()).observe(agents);
    new IntersectionObserver((es) => {
      visible = es[0].isIntersecting;
      kick();
    }).observe(hero);
    window.addEventListener(
      'scroll',
      () => {
        apply();
        kick();
      },
      { passive: true },
    );
    desk.addEventListener('change', () => (resize(), apply()));
    document.fonts?.ready.then(() => (resize(), apply()));
    apply();
  });
</script>
