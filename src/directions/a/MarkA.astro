---
/**
 * Direction A footer mark: "nicey." drawn in characters. On first view each filled cell starts as a
 * random glyph and settles into a block, left to right: noise resolving into one system.
 */
---

<div class="container-page ma" aria-hidden="true" data-ma>
  <pre class="ma-pre" data-ma-pre></pre>
</div>

<style>
  .ma {
    padding-top: 24px;
    padding-bottom: 48px;
    overflow: hidden;
  }
  .ma-pre {
    margin: 0;
    font-family: var(--font-mono);
    line-height: 1;
    letter-spacing: 0;
    white-space: pre;
    color: var(--color-ink);
  }
  .ma-pre :global(b) {
    font-weight: 400;
    color: var(--color-accent);
  }
  .ma-pre :global(i) {
    font-style: normal;
    color: var(--a-dim);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ma]').forEach(async (root) => {
    const pre = root.querySelector<HTMLElement>('[data-ma-pre]')!;
    await document.fonts.load('400 120px "Geist Pixel"').catch(() => {});
    const COLS = 150;
    const c = document.createElement('canvas');
    const W = 1500;
    const H = 330;
    c.width = W;
    c.height = H;
    const o = c.getContext('2d', { willReadFrequently: true })!;
    o.fillStyle = '#000';
    o.font = '400 300px "Geist Pixel", monospace';
    o.textBaseline = 'alphabetic';
    o.fillText('nicey', 10, 260);
    const wNicey = o.measureText('nicey').width;
    o.fillStyle = '#f00';
    o.fillText('.', 10 + wNicey, 260);
    // a character cell is ~0.6 wide for 1 tall, so fewer rows than columns per pixel
    const rows = Math.round(((COLS * H) / W) * 0.6);
    const px = o.getImageData(0, 0, W, H).data;
    // grid of cells: 0 empty, 1 letter, 2 the accent dot
    const grid: number[][] = [];
    for (let y = 0; y < rows; y++) {
      const row: number[] = [];
      for (let x = 0; x < COLS; x++) {
        const sx = Math.floor(((x + 0.5) * W) / COLS);
        const sy = Math.floor(((y + 0.5) * H) / rows);
        const k = (sy * W + sx) * 4;
        row.push(px[k + 3] > 100 ? (px[k] > 100 ? 2 : 1) : 0);
      }
      grid.push(row);
    }
    let last = COLS;
    while (last > 0 && grid.every((r) => !r[last - 1])) last--;
    const fit = () => {
      const w = root.clientWidth - 2 * parseFloat(getComputedStyle(root).paddingLeft || '0');
      pre.style.fontSize = `${w / (last * 0.6)}px`;
    };
    fit();
    addEventListener('resize', fit);
    const GLYPHS = '01<>[]{}/\\=+*#%';
    const render = (front: number) => {
      pre.innerHTML = grid
        .map((r) =>
          r
            .slice(0, last)
            .map((v, x) => {
              if (!v) return ' ';
              if (x > front) return `<i>${GLYPHS[Math.floor(Math.random() * GLYPHS.length)]}</i>`;
              return v === 2 ? '<b>█</b>' : '█';
            })
            .join(''),
        )
        .join('\n');
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return render(last);
    render(-1);
    let played = false;
    new IntersectionObserver((es) => {
      if (!es[0].isIntersecting || played) return;
      played = true;
      const start = performance.now();
      const DUR = 1600;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / DUR);
        render(Math.floor(p * (last + 4)) - 4);
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.3 }).observe(root);
  });
</script>
