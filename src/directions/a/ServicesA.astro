---
/**
 * Direction A: "What we help with" as one window with file tabs (design-systems.md | product-design.md),
 * the included work as a directory tree, the visual in the right pane. Same copy as live.
 * Live notes below:
 * "What we help with": one service at a time behind a segment control (Emir, 12 Nov: the old two-column
 * layout showed too much at once). Each service is a row in `services` below; add a row and the segment
 * control and its panel appear (e.g. an animation service later). Every panel has the same shape:
 * text on the left (kicker, title, lede, what's included), one visual on a stage on the right.
 * Direction A: the 'Explore …' links are removed (Emir, 20 Nov: no destination pages yet).
 */
import QBenchWork from '../../components/case-study/QBenchWork.astro';

type Visual = 'qbench' | 'phone';
const services: {
  id: string;
  label: string;
  kicker: string;
  lede: string;
  items: string[];
  visual: Visual;
  stage: string;
}[] = [
  {
    id: 'design-systems',
    label: 'Design systems',
    kicker: 'Primary practice',
    lede: 'For products with years of drift, and teams that want their coding agents to build on-system.',
    items: [
      'Audit and consolidation',
      'Token architecture and theming',
      'Component library, Figma to code',
      'AI-ready documentation',
      'Systems partner, monthly',
      'Free audit to start',
    ],
    visual: 'qbench',
    stage: 'bg-lavender',
  },
  {
    id: 'product-design',
    label: 'Product design',
    kicker: 'Alongside',
    lede: 'Complex workflows designed on the system we build, so new screens ship consistent from day one.',
    items: ['Product and UX design', 'Design engineering', 'AI workflows in delivery'],
    visual: 'phone',
    stage: 'bg-peach',
  },
];
---

<section id="services" aria-labelledby="services-head" class="container-page sa-sec">
  <div class="flex flex-col gap-3.5">
    <span class="caption text-ink-2">What we help with</span>
    <h2 id="services-head" class="m-0 text-h2 max-w-[16ch]">Design systems first. Product design alongside.</h2>
  </div>

  <div class="sa-win" data-svc>
    <div class="sa-tabs" role="tablist" aria-label="Services">
      {
        services.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`svc-tab-${s.id}`}
            aria-controls={`svc-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-svc-tab={s.id}
          >
            <span class="sa-tab-n">{String(i + 1).padStart(2, '0')}</span>
            {s.id}.md
            <span class="sa-tab-label">{s.label}</span>
          </button>
        ))
      }
      <span class="sa-tabs-rest" aria-hidden="true">services/</span>
    </div>
    {
      services.map((s, i) => (
        <div class="sa-pane" role="tabpanel" id={`svc-${s.id}`} aria-labelledby={`svc-tab-${s.id}`} data-svc-pane={s.id} hidden={i !== 0}>
          <div class="sa-text">
            <span class="caption text-ink-2">{s.kicker}</span>
            <h3 class="sa-h m-0">{s.label}</h3>
            <p class="m-0 text-body-lg text-pretty text-ink-2">{s.lede}</p>
            <div class="sa-tree" aria-label="What's included">
              <span class="sa-tree-root">included/</span>
              <ul>
                {s.items.map((item, k) => (
                  <li>
                    <span class="sa-branch" aria-hidden="true">{k === s.items.length - 1 ? '└──' : '├──'}</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <figure class:list={['sa-stage a-grain m-0', s.stage]}>
            {s.visual === 'qbench' ? (
              <QBenchWork terminal bare />
            ) : (
              <div class="sa-phone">
                <video muted loop playsinline preload="none" poster="/work/everbreed/mobile-logweight.webp" aria-label="Everbreed student app: logging a weight, a typo caught before it saves" data-svc-video>
                  <source src="/work/everbreed/mobile-logweight.webm" type="video/webm" />
                </video>
              </div>
            )}
          </figure>
        </div>
      ))
    }
  </div>
</section>

<style>
  .sa-sec {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: var(--spacing-section); /* breathing room under the ASCII band (Emir 18 Nov) */
    padding-bottom: var(--spacing-section);
  }
  .sa-win {
    border: 1px solid var(--a-rule);
    background: var(--color-surface);
  }
  .sa-tabs {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--a-rule);
    background: var(--color-page);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sa-tabs button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 18px;
    border: 0;
    border-right: 1px solid var(--a-rule);
    background: transparent;
    color: var(--color-ink-2);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .sa-tab-n {
    color: var(--color-muted);
  }
  .sa-tab-label {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .sa-tabs button[aria-selected='true'] {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: inset 0 2px 0 var(--a-block);
    margin-bottom: -1px;
  }
  @media (hover: hover) and (pointer: fine) {
    .sa-tabs button[aria-selected='false']:hover {
      color: var(--color-ink);
      background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    }
  }
  .sa-tabs-rest {
    margin-left: auto;
    align-self: center;
    padding: 0 16px;
    color: var(--color-muted);
  }
  .sa-pane {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }
  .sa-pane[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .sa-pane {
      grid-template-columns: 1fr;
    }
  }
  .sa-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: 44px 44px 40px;
  }
  .sa-h {
    font-family: var(--font-pixel);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.05;
  }
  .sa-tree {
    width: 100%;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 2;
  }
  .sa-tree-root {
    color: var(--color-accent);
  }
  .sa-tree ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sa-tree li {
    display: flex;
    gap: 10px;
    color: var(--color-ink);
  }
  .sa-branch {
    color: var(--a-dim);
  }
  .sa-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
    padding: 40px;
    border-left: 1px solid var(--a-rule);
    position: relative;
    isolation: isolate;
  }
  @media (max-width: 900px) {
    .sa-stage {
      border-left: 0;
      border-top: 1px solid var(--a-rule);
      min-height: 0;
      padding: 24px;
    }
  }
  .sa-stage > :global(.qw) {
    width: 100%;
  }
  .sa-phone {
    width: 190px; /* smaller so both panes stay at the stage's 520 min-height → no jump when switching tabs (Emir, 20 Nov) */
    aspect-ratio: 393 / 852;
    padding: 7px;
    border-radius: 34px;
    background: var(--color-band);
  }
  .sa-phone video {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 27px;
    object-fit: cover;
    background: #f1f3f5;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-svc]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-svc-tab]'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-pane]'));
    const videos = Array.from(root.querySelectorAll<HTMLVideoElement>('[data-svc-video]'));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // the phone clip plays only while it is on screen
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting && !reduced) {
            v.preload = 'auto';
            v.play().catch(() => {});
          } else v.pause();
        }),
      { threshold: 0.5 },
    );
    const watch = () => videos.forEach((v) => (io.unobserve(v), io.observe(v)));

    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panes.forEach((p, k) => (p.hidden = k !== i));
      if (focus) tabs[i].focus();
      watch();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % n;
        else if (e.key === 'ArrowLeft') to = (i - 1 + n) % n;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = n - 1;
        if (to < 0) return;
        e.preventDefault();
        pick(to, true);
      });
    });
    watch();
  });
</script>
