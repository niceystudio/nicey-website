---
/**
 * Direction A: the drift → system → agents band (after Supabase Select 26). It is the Zero Drift story:
 *   drift   the values a drifted product really carries, flowing in (dim, unordered)
 *   system  the token names they collapse into (real QBench V2 tokens), on the accent block
 *   agents  what a coding agent reads from them, and that it reads them fine
 * It follows the site's own tokens (24 Nov): the block reads --color-accent, so
 * the floating "Change one token" switcher (src/components/ui/TokenSwitcher.astro) re-colours this band with the rest
 * of the site. On each change the agents re-read every row and report "synced". (The scale column of mini screens was
 * removed 25 Nov: the whole site now shows the change.)
 * The band is decorative (aria-hidden); the switcher says in words what changed. Reduced motion: no scrolling.
 */
const drift = ['purple-2', 'purpleLight2', 'brand/purple/30', 'col-7', 'violet-final', '#6b5fbe', '#7266c4', '#665ab8'];
const tokens = [
  'color.accent',
  'border/default',
  'border/primary/default',
  'border/critical/default',
  'text/default',
  'text/placeholder',
  'component/input/surface/default',
  'opacity/disabled',
];
const reads = ['input.md', 'tokens.json', 'Input.fig', 'button.md', 'field.md', 'select.md', 'library.json', 'theme.css'];


const ROWS = 8;
const B = 36;
const glyphs = ['→', '→', '→', '·', '·', '↓', '↑', '·'];
// deterministic, so the server render and the first frame match
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const leftRow = (i: number) => {
  let s = '';
  while (s.length < 150) {
    const r = rnd();
    if (r < 0.16) s += ` ${drift[(i + s.length) % drift.length]} `;
    else s += glyphs[Math.floor(rnd() * glyphs.length)];
  }
  return s;
};
const rightRead = (i: number) => {
  const brackets = ['[[(<{', '{<([[', '(<{[[', '[(<{('];
  const b = brackets[i % brackets.length];
  const close = b.split('').reverse().map((c) => ({ '[': ']', '(': ')', '<': '>', '{': '}' })[c]).join('');
  return ` ${b} ${reads[i % reads.length]} ${close} → `;
};
const data = Array.from({ length: ROWS }, (_, i) => {
  const t = tokens[i % tokens.length];
  const num = String(i + 1).padStart(2, '0');
  const fill = Math.max(1, B - num.length - 2 - t.length - 2);
  return { left: leftRow(i), block: `${num}  ${t}${' '.padEnd(fill, '·')}■`, read: rightRead(i) };
});
---

<section class="ab" aria-hidden="true" data-ab>
  <div class="ab-stage a-grain">
    <div class="ab-labels">
      <span>drift</span><span>system</span><span>agents</span>
    </div>
    <div class="ab-grid">
      <div class="ab-rows">
        {
          data.map((r, i) => (
            <div class="ab-row" data-speed={1 + (i % 3)}>
              <span class="ab-l"><span data-l>{r.left}</span></span>
              <span class:list={['ab-b', i === 0 && 'is-reading']} data-b>{r.block}</span>
              <span class="ab-r">
                {r.read}
                <span class="ab-ok" data-ok>ok</span>
                <span data-r>{' →·→→ ·→ → ·→→→ · →→ ·→ →→· → ·→→ →· → ·→→ ·→ →→ · →→·→ → ·→→ →· →→ ·→'}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* the band's colour and corners are the site's: change the token and this follows */
  .ab {
    --ab-accent: var(--color-accent);
    --ab-on: var(--color-on-accent);
    position: relative;
    width: 100%;
    border-block: 1px solid var(--a-rule);
  }
  /* ---------- the band ---------- */
  .ab-stage {
    overflow: hidden;
    padding: var(--spacing-sm) 0 var(--spacing-md);
    background: color-mix(in srgb, var(--color-page) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    line-height: 1.55;
    white-space: pre;
    user-select: none;
  }
  .ab-labels,
  .ab-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) auto minmax(0, 1fr);
  }
  .ab-labels {
    margin-bottom: var(--spacing-xs);
    font-size: var(--text-caption-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .ab-labels span:first-child {
    text-align: right;
    padding-right: var(--spacing-sm);
  }
  /* the middle label sits over the block: same 36ch box as the block, in the band's own mono size */
  .ab-labels span:nth-child(2) {
    width: calc(36ch * 15 / 11);
    padding-left: 0.5ch;
  }
  .ab-labels span:nth-child(3) {
    padding-left: var(--spacing-sm);
  }
  /* the left run hugs the block: it overflows towards the page edge, not into the block */
  .ab-l {
    display: flex;
    justify-content: flex-end;
    overflow: hidden;
    color: var(--a-dim);
  }
  .ab-l > span {
    flex: none;
  }
  .ab-b {
    width: 36ch;
    padding: 0 0.5ch;
    background: var(--ab-accent);
    color: var(--ab-on);
    transition:
      background-color 240ms var(--ease-out),
      color 240ms var(--ease-out);
  }
  .ab-b.is-reading {
    background: var(--color-ink);
    color: var(--color-page);
  }
  .ab-r {
    overflow: hidden;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
  }
  .ab-ok {
    color: var(--color-ink);
    transition: color 200ms var(--ease-out);
  }
  .ab-ok.is-synced {
    color: var(--ab-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .ab *,
    .ab *::before {
      transition: none !important;
    }
  }

  @media (max-width: 720px) {
    .ab-stage {
      font-size: var(--text-caption);
    }
    .ab-labels span:nth-child(2) {
      width: calc(36ch * 12 / 11);
    }
  }
</style>

<script>
  import { CHANGE_EVENT } from '../../data/token-presets';
  document.querySelectorAll<HTMLElement>('[data-ab]').forEach((band) => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rows = Array.from(band.querySelectorAll<HTMLElement>('.ab-row')).map((row) => ({
      l: row.querySelector<HTMLElement>('[data-l]')!,
      r: row.querySelector<HTMLElement>('[data-r]')!,
      b: row.querySelector<HTMLElement>('[data-b]')!,
      ok: row.querySelector<HTMLElement>('[data-ok]')!,
      speed: Number(row.dataset.speed) || 1,
    }));
    let tick = 0;
    let reading = 0;
    let sweep = -1; // row the post-change sweep is on; -1 when idle
    let timer = 0;

    const setReading = (i: number) => {
      rows[reading].b.classList.remove('is-reading');
      reading = i;
      rows[reading].b.classList.add('is-reading');
    };

    // values flow right, into the block and out the other side as something an agent can read
    const step = () => {
      tick++;
      rows.forEach((x) => {
        if (tick % x.speed) return;
        const l = x.l.textContent ?? '';
        x.l.textContent = l.slice(-1) + l.slice(0, -1);
        const r = x.r.textContent ?? '';
        x.r.textContent = r.slice(-1) + r.slice(0, -1);
      });
      if (sweep >= 0) {
        // after a change the agents re-read every row, fast, and each one comes back synced
        if (tick % 2 === 0) {
          setReading(sweep);
          rows[sweep].ok.textContent = 'synced';
          rows[sweep].ok.classList.add('is-synced');
          sweep++;
          if (sweep === rows.length) {
            sweep = -1;
            window.setTimeout(() => rows.forEach((x) => ((x.ok.textContent = 'ok'), x.ok.classList.remove('is-synced'))), 2200);
          }
        }
      } else if (tick % 14 === 0) setReading((reading + 1) % rows.length);
    };

    // a token changed anywhere on the site: the agents re-read every row
    window.addEventListener(CHANGE_EVENT, () => {
      if (reduced) {
        rows.forEach((x) => ((x.ok.textContent = 'synced'), x.ok.classList.add('is-synced')));
        window.setTimeout(() => rows.forEach((x) => ((x.ok.textContent = 'ok'), x.ok.classList.remove('is-synced'))), 2200);
        return;
      }
      sweep = 0;
    });

    if (reduced) return;
    new IntersectionObserver((es) => {
      window.clearInterval(timer);
      if (es[0].isIntersecting) timer = window.setInterval(step, 90);
    }).observe(band);
  });
</script>
