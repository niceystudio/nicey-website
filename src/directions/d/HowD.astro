---
/**
 * Direction D: Zero Drift as five tabs over one stage. The step heading in condensed capitals, the three
 * parts in columns, the real figure in the pixel face. It walks through the steps on its own until you
 * pick one. Same copy and figures as live.
 */
import { steps, markerBg } from '../../data/zero-drift';
import Words from './Words.astro';

const figs: Record<string, { n: string; seen: string; note: string }> = {
  drift: { n: '53', seen: 'Seen at Everbreed', note: 'variables had drifted between the Figma file and the repo, with no IDs to tell a rename from a delete.' },
  audit: { n: '12/52', seen: 'Seen at Clerky', note: 'components had no description an agent could read. All 315 semantic and component tokens already did.' },
  system: { n: '1,071→0', seen: 'Seen at QBench', note: 'references to 11 outside libraries, brought down to zero across 141 components.' },
  context: { n: '1 rule', seen: 'Seen at Everbreed', note: 'in every agent file: “Report the gap. Don’t invent the value.”' },
  proof: { n: '0 T1', seen: 'Seen at Clerky', note: 'defects: the gate for the pilot on the Documents App, and the model held at pilot scale.' },
};
---

<section id="how" aria-labelledby="how-head" class="container-page ho" data-ho>
  <div class="ho-head">
    <span class="d-kicker">Zero Drift · how we work</span>
    <h2 id="how-head" class="ho-h d-display m-0" data-m="h2 · how we work · 5 steps">
      <Words text="From drift to a system that holds." pixel={['system']} />
    </h2>
    <p class="ho-lede m-0">Five steps. Each one starts with a problem you can see in your product and ends with something you can hold.</p>
  </div>
  <div class="ho-tabs" role="tablist" aria-label="Steps">
    {
      steps.map((s, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-ho-tab={i} id={`step-${s.id}`}>
          <i class:list={['ho-dot', markerBg[s.marker]]} aria-hidden="true" />
          <span class="ho-tab-n">{s.num}</span>
          {s.name}
          <span class="ho-bar" aria-hidden="true"><span /></span>
        </button>
      ))
    }
  </div>
  {
    steps.map((s, i) => {
      const f = figs[s.id];
      return (
        <div class="ho-pane" role="tabpanel" hidden={i !== 0} data-ho-pane={i} data-m={`article · step ${s.num} · ${s.name.toLowerCase()}`}>
          <div class="ho-main">
            <h3 class="ho-ph d-display m-0">{s.heading}</h3>
            <div class="ho-cols">
              <div>
                <span>You’re seeing</span>
                <p class="m-0">{s.seeing}</p>
              </div>
              <div>
                <span>We do</span>
                <p class="m-0">{s.weDo}</p>
              </div>
              <div>
                <span>You get</span>
                <p class="m-0 ho-get">{s.youGet}</p>
              </div>
            </div>
          </div>
          <aside class="ho-fig">
            <span class="ho-seen">{f.seen}</span>
            <p class="ho-n m-0">{f.n}</p>
            <p class="ho-note m-0">{f.note}</p>
          </aside>
        </div>
      );
    })
  }
</section>

<style>
  .ho {
    padding-block: var(--spacing-section);
  }
  .ho-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: 56px;
    text-align: center;
  }
  .ho-h {
    max-width: 14ch;
    font-size: clamp(48px, 7vw, 108px);
  }
  .ho-lede {
    max-width: 44ch;
    color: var(--color-ink-2);
  }
  .ho-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
    margin-bottom: 4px;
  }
  @media (max-width: 760px) {
    .ho-tabs {
      grid-template-columns: repeat(5, minmax(120px, 1fr));
      overflow-x: auto;
    }
  }
  .ho-tabs button {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 16px;
    border: 0;
    border-radius: 6px 6px 0 0;
    background: var(--color-surface);
    color: var(--color-ink-2);
    font-weight: 600;
    font-size: 15px;
    text-align: left;
    cursor: pointer;
    scroll-margin-top: 110px;
  }
  .ho-dot {
    width: 10px;
    height: 10px;
  }
  .ho-tab-n {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 11px;
    color: var(--color-muted);
  }
  .ho-tabs button[aria-selected='true'] {
    background: var(--d-band);
    color: var(--d-on-band);
  }
  .ho-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    overflow: hidden;
  }
  .ho-bar span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .ho-tabs button[aria-selected='true'] .ho-bar span {
    animation: ho-fill var(--ho-dur, 5200ms) linear forwards;
  }
  [data-ho].is-held .ho-bar span {
    animation: none !important;
    transform: scaleX(1);
  }
  @keyframes ho-fill {
    to {
      transform: scaleX(1);
    }
  }
  .ho-pane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    border-radius: 0 0 6px 6px;
    background: var(--d-band);
    color: var(--d-on-band);
  }
  .ho-pane[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .ho-pane {
      grid-template-columns: 1fr;
    }
  }
  .ho-main {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 40px;
  }
  .ho-ph {
    max-width: 18ch;
    font-size: clamp(40px, 4.6vw, 68px);
  }
  .ho-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 700px) {
    .ho-cols {
      grid-template-columns: 1fr;
    }
  }
  .ho-cols span {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--d-on-band-2);
  }
  .ho-cols p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--d-on-band-2);
  }
  .ho-cols .ho-get {
    color: var(--d-on-band);
    font-weight: 500;
  }
  .ho-fig {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    padding: 40px 32px;
    border-left: 1px solid color-mix(in srgb, var(--d-on-band) 14%, transparent);
  }
  .ho-seen {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-hot);
  }
  .ho-n {
    font-family: var(--font-pixel);
    font-size: 64px;
    line-height: 1;
    color: var(--color-accent);
  }
  .ho-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--d-on-band-2);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ho]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ho-tab]'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-ho-pane]'));
    const DUR = 5200;
    let cur = 0;
    let timer = 0;
    const show = (i: number) => {
      cur = i;
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      panes.forEach((p, k) => (p.hidden = k !== i));
    };
    const hold = () => {
      root.classList.add('is-held');
      window.clearInterval(timer);
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => (hold(), show(i))));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return hold();
    new IntersectionObserver((es) => {
      window.clearInterval(timer);
      if (es[0].isIntersecting && !root.classList.contains('is-held'))
        timer = window.setInterval(() => show((cur + 1) % tabs.length), DUR);
    }, { threshold: 0.3 }).observe(root);
  });
</script>
