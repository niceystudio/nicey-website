---
/**
 * Direction D: "When to bring us in" on the dark band (after Instantly's "We only do what we're best at"):
 * the four signs as a big list on the right, the evidence for the one you point at in a card on the left.
 * Words a machine reads are in the pixel face. Same copy and counts as live.
 */
import Words from './Words.astro';

const signs = [
  { t: 'Your design file and your repo have drifted apart', px: ['repo'], seen: 'Seen at Everbreed', fig: '53', cap: 'drifted variables', body: 'At Everbreed, 53 variables had drifted between Figma and code, and nobody could tell a rename from a delete.' },
  { t: 'The product was built for years without a designer', px: ['designer'], seen: 'Seen at QBench', fig: '11', cap: 'outside libraries behind the components', body: 'At QBench, every screen was a developer’s best guess, and each new feature meant relearning decisions nobody wrote down.' },
  { t: 'The library looks healthy, but a machine can’t use it', px: ['machine'], seen: 'Seen at Everbreed', fig: '302 · 0', cap: 'variables · scoped', body: 'At Everbreed, all 302 variables had no scope and no code name. Fine for people, unreadable for a pipeline.' },
  { t: 'Your team is handing design to AI agents', px: ['ai', 'agents'], seen: 'Every team, soon', fig: '239 · 0', cap: 'agent-built layers · issues', body: 'A developer fills the gaps in a Figma file. An agent guesses, and every guess becomes a correction pass.' },
];
---

<section aria-labelledby="when-head" class="d-band wd" data-wd>
  <div class="container-page">
    <div class="wd-head">
      <span class="d-kicker">When to bring us in</span>
      <h2 id="when-head" class="wd-h d-display m-0" data-m="h2 · when to bring us in">
        <Words text="If one of these sounds like your team, talk to us." />
      </h2>
    </div>
    <div class="wd-body">
      <div class="wd-cards" data-m="aside · evidence for the selected sign">
        {
          signs.map((s, i) => (
            <article class="wd-card" data-wd-card={i} hidden={i !== 0}>
              <span class="wd-seen">{s.seen}</span>
              <p class="wd-fig m-0">{s.fig}</p>
              <span class="wd-cap">{s.cap}</span>
              <p class="wd-body-p m-0">{s.body}</p>
            </article>
          ))
        }
      </div>
      <ol class="wd-list" data-m="ol · 4 signs">
        {
          signs.map((s, i) => (
            <li>
              <button type="button" data-wd-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span class="wd-n">0{i + 1}</span>
                <span class="wd-t">
                  <Words text={s.t} pixel={s.px} />
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .wd {
    padding-block: var(--spacing-section);
  }
  .wd-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: 72px;
    text-align: center;
  }
  .wd-h {
    max-width: 14ch;
    font-size: clamp(48px, 7vw, 108px);
  }
  .wd-body {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 40px 64px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .wd-body {
      grid-template-columns: 1fr;
    }
    .wd-cards {
      order: 2;
    }
  }
  .wd-cards {
    position: sticky;
    top: 110px;
  }
  .wd-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--d-on-band) 8%, transparent);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .wd-seen {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-hot);
  }
  .wd-fig {
    font-family: var(--font-pixel);
    font-size: 72px;
    line-height: 1;
  }
  .wd-cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }
  .wd-body-p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-ink-2);
  }
  .wd-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wd-list button {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 8px;
    width: 100%;
    padding: 14px 0;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    color: color-mix(in srgb, var(--d-on-band) 34%, transparent);
    text-align: left;
    cursor: pointer;
    transition: color 200ms var(--ease-out);
  }
  .wd-n {
    padding-top: 0.6em;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .wd-t {
    font-size: clamp(28px, 3.2vw, 46px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .wd-list button[aria-pressed='true'] {
    color: var(--d-on-band);
  }
  .wd-list button[aria-pressed='true'] .wd-n {
    color: var(--color-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-wd]').forEach((root) => {
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-wd-i]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-wd-card]'));
    let cur = 0;
    let timer = 0;
    let took = false;
    const show = (i: number) => {
      cur = i;
      btns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
      cards.forEach((c, k) => (c.hidden = k !== i));
    };
    btns.forEach((b, i) => {
      const take = () => {
        took = true;
        window.clearInterval(timer);
        show(i);
      };
      b.addEventListener('click', take);
      b.addEventListener('focus', take);
      b.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && take());
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver((es) => {
      window.clearInterval(timer);
      if (es[0].isIntersecting && !took) timer = window.setInterval(() => show((cur + 1) % btns.length), 3200);
    }).observe(root);
  });
</script>
