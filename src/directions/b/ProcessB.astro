---
/**
 * Direction B: the free audit as a printed report. Three pages typeset on paper (Score, Drift map,
 * Fix first) lying on a dithered light, the four steps as a numbered column, then the self-check band
 * as live. Marked "example"; scores, grades and days stay [gaps].
 */
import CopyPrompt from '../../components/CopyPrompt.astro';
import SelfCheckRun from '../../components/SelfCheckRun.astro';
import DitherField from './DitherField.astro';
import { links } from '../../data/links';

const pillars = ['Figma inspect', 'Agentic readiness', 'Conventions', 'Component API', 'Zero drift'];
const steps = [
  { n: '01', title: 'Share your Figma file', time: '[time]' },
  { n: '02', title: 'Get the report', time: '[days]' },
  { n: '03', title: 'Talk it through', time: '[call length]' },
  { n: '04', title: 'Build, pilot, roll out', time: 'Set in the proposal' },
];
---

<section id="audit" aria-labelledby="start-head" class="container-page pb2">
  <div class="pb2-head">
    <span class="b-kicker">What working with us looks like</span>
    <h2 id="start-head" class="m-0 text-h2">It starts with <em>a free audit.</em></h2>
    <a href={links.startAudit} class="pill pill-ink pill-lg">Get a free audit</a>
  </div>

  <div class="pb2-spread">
    <figure class="pb2-desk m-0" aria-label="Example audit report: three pages">
      <DitherField color="--color-accent" x={0.5} y={1.1} cell={3} power={0.8} />
      <div class="pb2-pages">
        <article class="pb2-page pb2-page--1">
          <header><span>nicey.</span><span>Audit · p. 1</span></header>
          <h3>Score</h3>
          <ul>{pillars.map((p) => <li><span>{p}</span><span>[score]</span></li>)}</ul>
          <footer>Grade <b>[grade]</b></footer>
        </article>
        <article class="pb2-page pb2-page--2">
          <header><span>nicey.</span><span>Audit · p. 2</span></header>
          <h3>Drift map</h3>
          <ul>
            <li><span>color.accent</span><span>≠ purple-2</span></li>
            <li><span>border/default</span><span>= border/default</span></li>
            <li><span>text/default</span><span>≠ col-7</span></li>
            <li><span>opacity/disabled</span><span>≠ violet-final</span></li>
          </ul>
          <footer>Figma · code</footer>
        </article>
        <article class="pb2-page pb2-page--3">
          <header><span>nicey.</span><span>Audit · p. 3</span></header>
          <h3>Fix first</h3>
          <ol>{pillars.map((p) => <li><span>{p}</span><span>[days]</span></li>)}</ol>
          <footer>Each sized in days</footer>
        </article>
      </div>
      <figcaption class="pb2-ex">Example report</figcaption>
    </figure>

    <div class="pb2-side">
      <p class="pb2-holds m-0">
        <em>Score</em>, a grade and a score per pillar. <em>Drift map</em>, where design and code disagree. <em
          >Fix first</em
        >, top findings, each sized in days.
      </p>
      <ol class="pb2-steps">
        {
          steps.map((s) => (
            <li>
              <span class="pb2-n">{s.n}</span>
              <span class="pb2-t">{s.title}</span>
              <span class="pb2-time">{s.time}</span>
            </li>
          ))
        }
      </ol>
      <span class="pb2-ro">Read-only. Your Figma file, the repo only if you share it. Free.</span>
    </div>
  </div>

  <div class="pb2-band">
    <div class="flex flex-col items-start gap-3">
      <span class="pb2-band-k">Or start on your own</span>
      <p class="pb2-band-p m-0">
        Not ready to share your file? Let your agent run our seven checks, then bring the results to a call.
      </p>
      <CopyPrompt />
    </div>
    <SelfCheckRun />
  </div>
</section>

<style>
  .pb2 {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding-bottom: var(--spacing-section);
  }
  .pb2-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-align: center;
  }
  .pb2-spread {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 40px 64px;
    align-items: center;
  }
  @media (max-width: 960px) {
    .pb2-spread {
      grid-template-columns: 1fr;
    }
  }
  .pb2-desk {
    position: relative;
    overflow: hidden;
    aspect-ratio: 6 / 5;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .pb2-pages {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .pb2-page {
    position: absolute;
    width: 46%;
    aspect-ratio: 210 / 297;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 4% 4.4%;
    border-radius: 3px;
    background: #f6f2e8;
    color: #26251f;
    box-shadow: 0 30px 50px -24px rgba(0, 0, 0, 0.6), 0 1px 0 rgba(0, 0, 0, 0.08);
    font-size: clamp(8px, 0.95vw, 12px);
    transition: transform 400ms var(--ease-out);
  }
  .pb2-page--1 {
    left: 6%;
    top: 14%;
    transform: rotate(-6deg);
  }
  .pb2-page--2 {
    left: 27%;
    top: 8%;
    z-index: 2;
    transform: rotate(1deg);
  }
  .pb2-page--3 {
    left: 49%;
    top: 15%;
    transform: rotate(7deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .pb2-desk:hover .pb2-page--1 {
      transform: rotate(-9deg) translateX(-4%);
    }
    .pb2-desk:hover .pb2-page--3 {
      transform: rotate(10deg) translateX(4%);
    }
  }
  .pb2-page header,
  .pb2-page footer {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.8em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #716e63;
  }
  .pb2-page header span:first-child {
    font-family: var(--font-serif);
    font-size: 1.5em;
    letter-spacing: 0;
    text-transform: none;
    color: #26251f;
  }
  .pb2-page footer {
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid rgba(38, 37, 31, 0.15);
  }
  .pb2-page footer b {
    font-weight: 400;
    color: #26251f;
  }
  .pb2-page h3 {
    margin: 4px 0 2px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2.6em;
    line-height: 1;
  }
  .pb2-page ul,
  .pb2-page ol {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .pb2-page li {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 0.45em;
    border-bottom: 1px dotted rgba(38, 37, 31, 0.25);
  }
  .pb2-page li span:last-child {
    color: #6b5fbe;
  }
  .pb2-ex {
    position: absolute;
    left: 16px;
    bottom: 14px;
    z-index: 3;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .pb2-side {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pb2-holds {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.3;
    color: var(--color-ink-2);
  }
  .pb2-holds em {
    font-style: italic;
    color: var(--color-ink);
  }
  .pb2-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line-strong);
  }
  .pb2-steps li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .pb2-n {
    font-size: 12px;
    color: var(--color-muted);
  }
  .pb2-t {
    font-family: var(--font-serif);
    font-size: 22px;
  }
  .pb2-time {
    font-size: 12px;
    color: var(--color-ink-2);
  }
  .pb2-ro {
    font-size: 12px;
    color: var(--color-muted);
  }
  .pb2-band {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 32px 48px;
    align-items: center;
    padding: 40px;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  @media (max-width: 900px) {
    .pb2-band {
      grid-template-columns: 1fr;
      padding: 24px;
    }
  }
  .pb2-band-k {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .pb2-band-p {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.2;
  }
</style>
