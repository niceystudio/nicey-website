---
/**
 * Direction B: "What we help with" as an editorial contents page. The two practices are big serif
 * entries you pick from (the tab list); the visual sits on a dithered light. Same copy as live.
 * Live notes below:
 * "What we help with": one service at a time behind a segment control (Emir, 12 Nov: the old two-column
 * layout showed too much at once). Each service is a row in `services` below; add a row and the segment
 * control and its panel appear (e.g. an animation service later). Every panel has the same shape:
 * text on the left (kicker, title, lede, what's included, link), one visual on a stage on the right.
 */
import QBenchWork from '../../components/case-study/QBenchWork.astro';
import DitherField from './DitherField.astro';
import { links } from '../../data/links';

type Visual = 'qbench' | 'phone';
const services: {
  id: string;
  label: string;
  kicker: string;
  lede: string;
  items: string[];
  link: { href: string; label: string };
  visual: Visual;
  stage: string;
}[] = [
  {
    id: 'design-systems',
    label: 'Design systems',
    kicker: 'Primary practice',
    lede: 'For products with years of drift, and teams that want their coding agents to build on-system.',
    items: [
      'Audit and consolidation',
      'Token architecture and theming',
      'Component library, Figma to code',
      'AI-ready documentation',
      'Systems partner, monthly',
      'Free audit to start',
    ],
    link: { href: links.exploreDesignSystems, label: 'Explore design systems' },
    visual: 'qbench',
    stage: 'bg-lavender',
  },
  {
    id: 'product-design',
    label: 'Product design',
    kicker: 'Alongside',
    lede: 'Complex workflows designed on the system we build, so new screens ship consistent from day one.',
    items: ['Product and UX design', 'Design engineering', 'AI workflows in delivery'],
    link: { href: links.exploreProductDesign, label: 'Explore product design' },
    visual: 'phone',
    stage: 'bg-peach',
  },
];
---

<section id="services" aria-labelledby="services-head" class="container-page sb">
  <div class="sb-head">
    <span class="b-kicker">What we help with</span>
    <h2 id="services-head" class="m-0 text-h2">Design systems first. <em>Product design alongside.</em></h2>
  </div>
  <div class="sb-body" data-svc>
    <div class="sb-index" role="tablist" aria-label="Services" aria-orientation="vertical">
      {
        services.map((s, i) => (
          <button type="button" role="tab" id={`svc-tab-${s.id}`} aria-controls={`svc-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-svc-tab={s.id}>
            <span class="sb-index-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="sb-index-name">{s.label}</span>
            <span class="sb-index-k">{s.kicker}</span>
          </button>
        ))
      }
    </div>
    <div class="sb-panes">
      {
        services.map((s, i) => (
          <div class="sb-pane" role="tabpanel" id={`svc-${s.id}`} aria-labelledby={`svc-tab-${s.id}`} data-svc-pane={s.id} hidden={i !== 0}>
            <figure class="sb-stage m-0">
              <DitherField x={0.5} y={1.1} cell={3} power={0.9} />
              <div class="sb-stage-in">
                {s.visual === 'qbench' ? (
                  <QBenchWork terminal bare />
                ) : (
                  <div class="sb-phone">
                    <video muted loop playsinline preload="none" poster="/work/everbreed/mobile-logweight.jpg" aria-label="Everbreed student app: logging a weight, a typo caught before it saves" data-svc-video>
                      <source src="/work/everbreed/mobile-logweight.webm" type="video/webm" />
                    </video>
                  </div>
                )}
              </div>
            </figure>
            <div class="sb-text">
              <p class="sb-lede m-0">{s.lede}</p>
              <div>
                <span class="sb-inc-k">What's included</span>
                <ul class="sb-inc">
                  {s.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <a href={s.link.href} class="sb-link">
                {s.link.label} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sb {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-bottom: var(--spacing-section);
  }
  .sb-head {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: none;
  }
  .sb-body {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 40px 64px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .sb-body {
      grid-template-columns: 1fr;
    }
  }
  .sb-index {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line-strong);
  }
  .sb-index button {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 4px 6px;
    padding: 22px 0 24px;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: var(--color-muted);
    transition: color 200ms var(--ease-out);
  }
  .sb-index-n {
    grid-row: span 2;
    padding-top: 10px;
    font-size: 12px;
  }
  .sb-index-name {
    font-family: var(--font-serif);
    font-size: 46px;
    line-height: 1;
    letter-spacing: -0.015em;
  }
  .sb-index-k {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .sb-index button[aria-selected='true'] {
    color: var(--color-ink);
  }
  .sb-index button[aria-selected='true'] .sb-index-name {
    font-style: italic;
  }
  .sb-index button[aria-selected='true'] .sb-index-n {
    color: var(--color-accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .sb-index button[aria-selected='false']:hover {
      color: var(--color-ink-2);
    }
  }
  .sb-pane {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .sb-pane[hidden] {
    display: none;
  }
  .sb-stage {
    position: relative;
    overflow: hidden;
    min-height: 460px;
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .sb-stage-in {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 460px;
    padding: 40px;
  }
  .sb-stage-in > :global(.qw) {
    width: 100%;
    max-width: 560px;
  }
  .sb-phone {
    width: 220px;
    aspect-ratio: 393 / 852;
    padding: 7px;
    border-radius: 34px;
    background: var(--color-band);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }
  .sb-phone video {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 27px;
    object-fit: cover;
    background: #f1f3f5;
  }
  .sb-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px 48px;
  }
  @media (max-width: 700px) {
    .sb-text {
      grid-template-columns: 1fr;
    }
  }
  .sb-lede {
    font-family: var(--font-serif);
    font-size: 26px;
    line-height: 1.2;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .sb-inc-k {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .sb-inc {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 2;
  }
  .sb-inc li::before {
    content: '—';
    margin-right: 10px;
    color: var(--color-muted);
  }
  .sb-link {
    grid-column: 1 / -1;
    justify-self: start;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    color: var(--color-ink);
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-svc]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-svc-tab]'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-pane]'));
    const videos = Array.from(root.querySelectorAll<HTMLVideoElement>('[data-svc-video]'));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // the phone clip plays only while it is on screen
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting && !reduced) {
            v.preload = 'auto';
            v.play().catch(() => {});
          } else v.pause();
        }),
      { threshold: 0.5 },
    );
    const watch = () => videos.forEach((v) => (io.unobserve(v), io.observe(v)));

    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panes.forEach((p, k) => (p.hidden = k !== i));
      if (focus) tabs[i].focus();
      watch();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % n;
        else if (e.key === 'ArrowLeft') to = (i - 1 + n) % n;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = n - 1;
        if (to < 0) return;
        e.preventDefault();
        pick(to, true);
      });
    });
    watch();
  });
</script>
