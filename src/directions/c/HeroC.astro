---
/**
 * Direction C hero (after Aston): text on the left, an exploded isometric stack in the middle (what we
 * build: tokens → components → screens → context for agents), and a before/after rail on the right
 * with hairline brackets. Rail figures are the real ones from the case studies. Same copy as live.
 */
import { links } from '../../data/links';

const layers = [
  { name: 'Context for agents', meta: 'what it is · when · never', kind: 'docs' },
  { name: 'Screens', meta: 'built from components', kind: 'screens' },
  { name: 'Components', meta: 'Figma = code props', kind: 'components' },
  { name: 'Tokens', meta: 'one source of truth', kind: 'tokens' },
];
const rail = [
  {
    head: 'Before',
    rows: [
      { k: 'QBench · outside-library references', v: '1,071' },
      { k: 'QBench · variables with a code name', v: '13 / 553' },
      { k: 'Everbreed · hand-written aliases', v: '210' },
    ],
  },
  {
    head: 'After',
    rows: [
      { k: 'QBench · outside-library references', v: '0' },
      { k: 'QBench · variables with a code name', v: '554 / 554' },
      { k: 'Everbreed · hand-written aliases', v: '0, generated' },
    ],
  },
];
const proof = ['QBench', 'Everbreed', 'Clerky', 'Omnisafe', 'FLYR'].map((name) => ({ name, href: `#work-${name.toLowerCase()}` }));
---

<section class="hc">
  <div class="container-page hc-grid">
    <div class="hc-copy">
      <span class="c-kicker"><b>■</b> Free design system audit · read-only</span>
      <h1 class="hc-h m-0">Is your design system <span class="hc-lines">ready for AI agents?</span></h1>
      <p class="hc-lede m-0">
        Send us your Figma file. You get a score per pillar, the top findings and what to fix first. Free, and we never
        edit your file.
      </p>
      <div class="hc-ctas">
        <a href="#audit" class="pill pill-ink pill-lg">Get a free audit</a>
        <a href={links.bookCall} class="hc-arrow" aria-label="Book a call"><span>Book a call</span><i aria-hidden="true">→</i></a>
      </div>
      <p class="hc-then m-0">Then we build systems people and agents read the same way.</p>
    </div>

    <div class="hc-stack" aria-label="What we build, layer by layer">
      <div class="hc-iso">
        {
          layers.map((l, i) => (
            <div class:list={['hc-plate', `hc-plate--${l.kind}`]} style={`--i:${layers.length - 1 - i}`}>
              <span class="hc-plate-grid" aria-hidden="true" />
            </div>
          ))
        }
      </div>
      <ol class="hc-legend">
        {
          layers.map((l, i) => (
            <li style={`--i:${layers.length - 1 - i}`}>
              <span class="hc-legend-n">{String(layers.length - i).padStart(2, '0')}</span>
              <span>{l.name}</span>
              <span class="hc-legend-m">{l.meta}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="hc-rail" aria-label="Before and after, from our case studies">
      {
        rail.map((g) => (
          <div class:list={['hc-rail-g', g.head === 'After' && 'is-after']}>
            <p class="hc-rail-h m-0">{g.head}</p>
            <dl class="m-0">
              {g.rows.map((r) => (
                <div>
                  <dt>{r.k}</dt>
                  <dd>{r.v}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </aside>
  </div>
  <nav class="container-page hc-proof" aria-label="Selected work">
    <span>Selected work</span>
    {
      proof.map((p, i) => (
        <a href={p.href}>
          <span class="hc-proof-n">{String(i + 1).padStart(3, '0')}</span>
          {p.name}
        </a>
      ))
    }
  </nav>
</section>

<style>
  .hc {
    border-bottom: 1px solid var(--c-rule);
  }
  .hc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 0.7fr);
    align-items: center;
    gap: 40px;
    min-height: calc(100vh - 160px);
    padding-top: 56px;
    padding-bottom: 56px;
  }
  @media (max-width: 1100px) {
    .hc-grid {
      grid-template-columns: 1fr;
    }
  }
  .hc-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .hc-h {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(40px, 4.6vw, 68px);
    line-height: 0.98;
    letter-spacing: -0.05em;
    color: var(--color-ink);
  }
  /* the question set in scanlines (Coreline): the same letters, as a machine prints them */
  .hc-lines {
    color: transparent;
    background: repeating-linear-gradient(
      to bottom,
      var(--color-accent) 0 3px,
      transparent 3px 6px
    );
    -webkit-background-clip: text;
    background-clip: text;
  }
  .hc-lede {
    max-width: 38ch;
    font-size: 13px;
    line-height: 1.75;
    color: var(--color-ink-2);
  }
  .hc-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .hc-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-ink);
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hc-arrow span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .hc-arrow i {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--color-ink);
    font-style: normal;
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .hc-arrow:hover i {
      transform: translateX(4px);
    }
  }
  .hc-then {
    font-size: 12px;
    color: var(--color-muted);
  }

  /* exploded isometric stack: four plates, gaps open on load */
  .hc-stack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .hc-iso {
    position: relative;
    width: min(100%, 440px);
    aspect-ratio: 1 / 1.05;
    perspective: 2400px;
  }
  .hc-plate {
    position: absolute;
    left: 14%;
    right: 14%;
    top: 34%;
    aspect-ratio: 1;
    transform: rotateX(58deg) rotateZ(-45deg) translateZ(calc(var(--i) * var(--gap, 64px)));
    transform-style: preserve-3d;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    box-shadow: inset 0 0 0 1px var(--c-rule), 0 0 0 1px var(--color-page);
    transition: transform 900ms var(--ease-out);
  }
  .hc-plate-grid {
    position: absolute;
    inset: 8%;
    background-image:
      linear-gradient(var(--c-rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-rule) 1px, transparent 1px);
    background-size: 12.5% 12.5%;
    opacity: 0.6;
  }
  .hc-plate--tokens .hc-plate-grid {
    background-image: radial-gradient(var(--color-accent) 1.6px, transparent 2px);
    background-size: 10% 10%;
    opacity: 0.9;
  }
  .hc-plate--components .hc-plate-grid {
    background-image:
      linear-gradient(var(--color-accent), var(--color-accent)),
      linear-gradient(var(--c-rule), var(--c-rule)),
      linear-gradient(var(--c-rule), var(--c-rule)),
      linear-gradient(var(--c-rule), var(--c-rule));
    background-size: 40% 14%, 70% 14%, 55% 14%, 30% 30%;
    background-position: 0 0, 0 30%, 0 55%, 100% 100%;
    background-repeat: no-repeat;
    opacity: 1;
  }
  .hc-plate--screens .hc-plate-grid {
    background-image:
      linear-gradient(var(--c-rule), var(--c-rule)),
      linear-gradient(var(--c-rule), var(--c-rule)),
      linear-gradient(var(--c-rule), var(--c-rule));
    background-size: 100% 12%, 28% 80%, 66% 80%;
    background-position: 0 0, 0 100%, 100% 100%;
    background-repeat: no-repeat;
    opacity: 1;
  }
  .hc-plate--docs {
    background: color-mix(in srgb, var(--color-accent) 22%, var(--color-surface));
  }
  .hc-plate--docs .hc-plate-grid {
    background-image: repeating-linear-gradient(to bottom, var(--color-accent) 0 1px, transparent 1px 9%);
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hc-plate {
      animation: hc-explode 1100ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms);
    }
  }
  @keyframes hc-explode {
    from {
      transform: rotateX(58deg) rotateZ(-45deg) translateZ(calc(var(--i) * 6px));
    }
  }
  .hc-legend {
    width: 100%;
    max-width: 440px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-rule);
  }
  .hc-legend li {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--c-rule);
    font-size: 12px;
  }
  .hc-legend-n,
  .hc-legend-m {
    color: var(--color-muted);
  }

  /* before / after rail with hairline brackets (Aston) */
  .hc-rail {
    display: flex;
    flex-direction: column;
    gap: 40px;
    text-align: right;
  }
  .hc-rail-g {
    padding-right: 16px;
    border-right: 1px solid var(--color-ink-2);
  }
  .hc-rail-h {
    margin-bottom: 14px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 30px;
    letter-spacing: -0.04em;
    color: var(--color-ink-2);
  }
  .is-after .hc-rail-h {
    color: var(--color-accent);
  }
  .is-after {
    border-right-color: var(--color-accent);
  }
  .hc-rail dl div {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    padding: 6px 0;
  }
  .hc-rail dt {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .hc-rail dd {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.06em;
  }
  .hc-rail dd::before {
    content: '';
    width: 48px;
    height: 1px;
    background: var(--c-rule);
  }
  @media (max-width: 1100px) {
    .hc-rail {
      text-align: left;
    }
  }

  .hc-proof {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--c-rule);
  }
  .hc-proof > * {
    flex: 1 1 140px;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 16px;
    border-right: 1px solid var(--c-rule);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }
  .hc-proof > span {
    color: var(--color-muted);
  }
  .hc-proof-n {
    color: var(--color-muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .hc-proof a:hover {
      background: var(--c-hl);
    }
  }
</style>
