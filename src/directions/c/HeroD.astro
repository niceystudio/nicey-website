---
/**
 * Direction D hero (after Instantly): a huge faint wordmark behind; left, the lede and the client names in
 * a grid of cells; right, the question in condensed capitals and the CTAs. Under it the HUMAN | MACHINE
 * switch (keys H / M): Machine turns every display word into the pixel face and labels each block with
 * what an agent reads it as. Same copy as live.
 */
import { links } from '../../data/links';
import Words from './Words.astro';

const clients = ['QBench', 'Everbreed', 'Clerky', 'Omnisafe', 'FLYR'];
---

<section class="hd">
  <p class="hd-ghost m-0" aria-hidden="true">nicey<span class="d-m">.</span></p>
  <div class="container-page hd-grid">
    <div class="hd-left">
      <p class="hd-lede m-0" data-m="p · lede">
        Send us your Figma file. You get a score per pillar, the top findings and what to fix first. Free, and we never
        edit your file.
      </p>
      <nav class="hd-clients" aria-label="Selected work" data-m="nav · selected work · 5 links">
        {clients.map((c) => <a href={`#work-${c.toLowerCase()}`}>{c}</a>)}
        <span class="hd-clients-you">+ your team</span>
      </nav>
    </div>
    <div class="hd-right">
      <span class="d-kicker">Free design system audit · read-only</span>
      <h1 class="hd-h d-display m-0" data-m="h1 · the question">
        <Words text="Is your design system ready for AI agents?" pixel={['ai', 'agents']} />
      </h1>
      <div class="hd-ctas">
        <a href="#audit" class="d-btn">Get a free audit <i aria-hidden="true">↗</i></a>
        <a href={links.bookCall} class="d-btn d-btn--ghost">Book a call <i aria-hidden="true">↗</i></a>
      </div>
      <p class="hd-then m-0">Then we build systems people and agents read the same way.</p>
    </div>
  </div>
  <div class="container-page">
    <div class="hd-switch" role="group" aria-label="Read this page as">
      <span class="hd-switch-k">Read this page as</span>
      <button type="button" data-read-btn="human" aria-pressed="true">Human <kbd>H</kbd></button>
      <button type="button" data-read-btn="machine" aria-pressed="false">Machine <kbd>M</kbd></button>
      <span class="hd-switch-note" data-read-note>What people see.</span>
    </div>
  </div>
</section>

<style>
  .hd {
    position: relative;
    overflow: hidden;
    padding-top: 40px;
  }
  .hd-ghost {
    position: absolute;
    left: 50%;
    top: -0.18em;
    transform: translateX(-50%);
    font-family: var(--font-cond);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 34vw;
    line-height: 1;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--color-ink) 5%, transparent);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }
  .hd-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 48px 64px;
    align-items: start;
    padding-top: 72px;
  }
  @media (max-width: 960px) {
    .hd-grid {
      grid-template-columns: 1fr;
    }
    .hd-right {
      order: -1;
    }
  }
  .hd-left {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 8px;
  }
  .hd-lede {
    max-width: 34ch;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.45;
  }
  .hd-clients {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
  }
  .hd-clients > * {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: background-color 160ms var(--ease-out);
  }
  .hd-clients-you {
    font-family: var(--font-mono);
    font-weight: 400 !important;
    font-size: 12px !important;
    color: var(--color-muted) !important;
  }
  @media (hover: hover) and (pointer: fine) {
    .hd-clients a:hover {
      background: var(--color-accent);
      color: var(--color-page);
    }
  }
  .hd-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .hd-h {
    font-size: clamp(56px, 8.4vw, 132px);
  }
  .hd-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hd-then {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }
  .hd-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 64px 0 48px;
    padding: 6px 6px 6px 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hd-switch-k {
    margin-right: 6px;
    color: var(--color-muted);
  }
  .hd-switch button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 8px 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-2);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .hd-switch kbd {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px currentColor;
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.7;
  }
  .hd-switch button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-page);
  }
  .hd-switch button[data-read-btn='machine'][aria-pressed='true'] {
    background: var(--color-accent);
  }
  .hd-switch-note {
    margin-left: auto;
    padding-right: 12px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-muted);
  }
</style>
