---
/**
 * Direction C: "What we help with" in a boxed grid (Rollups): two tab cells across the top, then the
 * practice as a spec table on the left and the visual in a ruled cell on the right. Same copy as live.
 * Live notes below:
 * "What we help with": one service at a time behind a segment control (Emir, 12 Nov: the old two-column
 * layout showed too much at once). Each service is a row in `services` below; add a row and the segment
 * control and its panel appear (e.g. an animation service later). Every panel has the same shape:
 * text on the left (kicker, title, lede, what's included, link), one visual on a stage on the right.
 */
import QBenchWork from '../../components/case-study/QBenchWork.astro';
import { links } from '../../data/links';

type Visual = 'qbench' | 'phone';
const services: {
  id: string;
  label: string;
  kicker: string;
  lede: string;
  items: string[];
  link: { href: string; label: string };
  visual: Visual;
  stage: string;
}[] = [
  {
    id: 'design-systems',
    label: 'Design systems',
    kicker: 'Primary practice',
    lede: 'For products with years of drift, and teams that want their coding agents to build on-system.',
    items: [
      'Audit and consolidation',
      'Token architecture and theming',
      'Component library, Figma to code',
      'AI-ready documentation',
      'Systems partner, monthly',
      'Free audit to start',
    ],
    link: { href: links.exploreDesignSystems, label: 'Explore design systems' },
    visual: 'qbench',
    stage: 'bg-lavender',
  },
  {
    id: 'product-design',
    label: 'Product design',
    kicker: 'Alongside',
    lede: 'Complex workflows designed on the system we build, so new screens ship consistent from day one.',
    items: ['Product and UX design', 'Design engineering', 'AI workflows in delivery'],
    link: { href: links.exploreProductDesign, label: 'Explore product design' },
    visual: 'phone',
    stage: 'bg-peach',
  },
];
---

<section id="services" aria-labelledby="services-head" class="c-sec">
  <div class="container-page">
    <div class="c-sec-head">
      <div class="flex flex-col gap-4">
        <span class="c-kicker"><b>■</b> What we help with</span>
        <h2 id="services-head" class="c-h2">Design systems first. Product design alongside.</h2>
      </div>
    </div>
    <div class="sc" data-svc>
      <div class="sc-tabs" role="tablist" aria-label="Services">
        {
          services.map((s, i) => (
            <button type="button" role="tab" id={`svc-tab-${s.id}`} aria-controls={`svc-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-svc-tab={s.id}>
              <span class="sc-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="sc-name">{s.label}</span>
              <span class="sc-k">{s.kicker}</span>
            </button>
          ))
        }
      </div>
      {
        services.map((s, i) => (
          <div class="sc-pane" role="tabpanel" id={`svc-${s.id}`} aria-labelledby={`svc-tab-${s.id}`} data-svc-pane={s.id} hidden={i !== 0}>
            <div class="sc-spec">
              <p class="sc-lede m-0">{s.lede}</p>
              <table class="sc-table">
                <thead>
                  <tr><th>#</th><th>Included</th></tr>
                </thead>
                <tbody>
                  {s.items.map((item, k) => (
                    <tr>
                      <td>{String(k + 1).padStart(2, '0')}</td>
                      <td>{item}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <a href={s.link.href} class="sc-link">{s.link.label} <span aria-hidden="true">→</span></a>
            </div>
            <figure class="sc-stage m-0">
              <span class="sc-fig" aria-hidden="true">Fig. {String(i + 1).padStart(2, '0')}</span>
              {s.visual === 'qbench' ? (
                <QBenchWork terminal bare />
              ) : (
                <div class="sc-phone">
                  <video muted loop playsinline preload="none" poster="/work/everbreed/mobile-logweight.jpg" aria-label="Everbreed student app: logging a weight, a typo caught before it saves" data-svc-video>
                    <source src="/work/everbreed/mobile-logweight.webm" type="video/webm" />
                  </video>
                </div>
              )}
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sc {
    border: 1px solid var(--c-rule);
  }
  .sc-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-bottom: 1px solid var(--c-rule);
  }
  .sc-tabs button {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: baseline;
    gap: 10px;
    padding: 22px 24px;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    text-align: left;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }
  .sc-tabs button + button {
    border-left: 1px solid var(--c-rule);
  }
  .sc-n,
  .sc-k {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .sc-name {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 26px;
    letter-spacing: -0.04em;
  }
  .sc-tabs button[aria-selected='true'] {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }
  .sc-tabs button[aria-selected='true'] .sc-n {
    color: var(--color-accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .sc-tabs button[aria-selected='false']:hover {
      color: var(--color-ink-2);
      background: color-mix(in srgb, var(--color-surface) 50%, transparent);
    }
  }
  .sc-pane {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  }
  .sc-pane[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .sc-pane {
      grid-template-columns: 1fr;
    }
  }
  .sc-spec {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 32px 28px;
    border-right: 1px solid var(--c-rule);
  }
  .sc-lede {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }
  .sc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .sc-table th {
    padding: 0 0 8px;
    border-bottom: 1px solid var(--color-ink);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    color: var(--color-muted);
  }
  .sc-table td {
    padding: 9px 0;
    border-bottom: 1px solid var(--c-rule);
  }
  .sc-table td:first-child {
    width: 40px;
    color: var(--color-muted);
  }
  .sc-link {
    align-self: flex-start;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-underline-offset: 5px;
  }
  .sc-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 480px;
    padding: 48px 36px;
    background-image:
      linear-gradient(var(--c-guide, rgba(127, 127, 127, 0.08)) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-guide, rgba(127, 127, 127, 0.08)) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .sc-fig {
    position: absolute;
    left: 14px;
    top: 12px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .sc-stage > :global(.qw) {
    width: 100%;
    max-width: 560px;
  }
  .sc-phone {
    width: 220px;
    aspect-ratio: 393 / 852;
    padding: 7px;
    border-radius: 34px;
    background: var(--color-band);
  }
  .sc-phone video {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 27px;
    object-fit: cover;
    background: #f1f3f5;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-svc]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-svc-tab]'));
    const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-pane]'));
    const videos = Array.from(root.querySelectorAll<HTMLVideoElement>('[data-svc-video]'));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // the phone clip plays only while it is on screen
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting && !reduced) {
            v.preload = 'auto';
            v.play().catch(() => {});
          } else v.pause();
        }),
      { threshold: 0.5 },
    );
    const watch = () => videos.forEach((v) => (io.unobserve(v), io.observe(v)));

    const pick = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panes.forEach((p, k) => (p.hidden = k !== i));
      if (focus) tabs[i].focus();
      watch();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % n;
        else if (e.key === 'ArrowLeft') to = (i - 1 + n) % n;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = n - 1;
        if (to < 0) return;
        e.preventDefault();
        pick(to, true);
      });
    });
    watch();
  });
</script>
