---
/**
 * Direction C — "Spec sheet". Homepage only, same copy and order as live.
 * New: hero (text · exploded stack · before/after rail), When (spec sheets), Services (boxed grid),
 * Work (client sheets), How we work (ruled timeline), free audit (drawing + spec table), footer mark.
 * Restyled by c.css: header, FAQ, closing band, footer links. The column grid shows behind everything.
 */
import './c.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MachineView from '../../components/case-study/MachineView.astro';
import DirectionSwitch from '../DirectionSwitch.astro';
import HeroC from './HeroC.astro';
import WhenC from './WhenC.astro';
import ServicesC from './ServicesC.astro';
import WorkC from './WorkC.astro';
import HowC from './HowC.astro';
import ProcessC from './ProcessC.astro';
import MarkC from './MarkC.astro';
import { homeMarkdown } from '../../lib/home-markdown';

const markdown = await homeMarkdown(Astro.site ?? new URL('https://nicey-website.vercel.app'));
---

<Base title="Nicey · Direction C (review)" description="Design direction C for review: spec sheet." noindex markdownHref="/index.md">
  <div class="dir-c">
    <div class="c-guides" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <Header />
    <main id="main" tabindex="-1" data-human>
      <HeroC />
      <WhenC />
      <ServicesC />
      <WorkC />
      <HowC />
      <ProcessC />
      <Faq />
    </main>
    <Footer />
    <MachineView markdown={markdown} mdHref="/index.md" what="homepage" />
    <SiteFooter mdHref="/index.md" />
    <MarkC />
  </div>
  <DirectionSwitch current="c" />
</Base>
