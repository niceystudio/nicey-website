---
/**
 * Direction D: "What we help with" as two cards side by side (Instantly's "Two ways to work with us"):
 * design systems on a dark card with the Figma → Tokens → Agent terminal, product design on a light card
 * with the phone. Same copy as live.
 */
import QBenchWork from '../../components/case-study/QBenchWork.astro';
import { links } from '../../data/links';
import Words from './Words.astro';

const services = [
  {
    id: 'design-systems',
    label: 'Design systems',
    kicker: 'Primary practice',
    lede: 'For products with years of drift, and teams that want their coding agents to build on-system.',
    items: ['Audit and consolidation', 'Token architecture and theming', 'Component library, Figma to code', 'AI-ready documentation', 'Systems partner, monthly', 'Free audit to start'],
    link: { href: links.exploreDesignSystems, label: 'Explore design systems' },
    dark: true,
  },
  {
    id: 'product-design',
    label: 'Product design',
    kicker: 'Alongside',
    lede: 'Complex workflows designed on the system we build, so new screens ship consistent from day one.',
    items: ['Product and UX design', 'Design engineering', 'AI workflows in delivery'],
    link: { href: links.exploreProductDesign, label: 'Explore product design' },
    dark: false,
  },
];
---

<section id="services" aria-labelledby="services-head" class="container-page sd">
  <div class="sd-head">
    <span class="d-kicker">What we help with</span>
    <h2 id="services-head" class="sd-h d-display m-0" data-m="h2 · what we help with">
      <Words text="Design systems first. Product design alongside." />
    </h2>
  </div>
  <div class="sd-cards">
    {
      services.map((s, i) => (
        <article class:list={['sd-card', s.dark && 'd-band']} data-m={`article · ${s.id} · ${s.items.length} items`}>
          <div class="sd-top">
            <span class="sd-path">/{s.id}</span>
            <span class="sd-k">{s.kicker}</span>
          </div>
          <h3 class="sd-name d-display m-0">{s.label}</h3>
          <p class="sd-lede m-0">{s.lede}</p>
          <div class="sd-visual">
            {s.dark ? (
              <QBenchWork terminal bare />
            ) : (
              <div class="sd-phone">
                <video muted loop playsinline autoplay preload="metadata" poster="/work/everbreed/mobile-logweight.jpg" aria-label="Everbreed student app: logging a weight, a typo caught before it saves">
                  <source src="/work/everbreed/mobile-logweight.webm" type="video/webm" />
                </video>
              </div>
            )}
          </div>
          <ul class="sd-items">
            {s.items.map((it) => (
              <li>{it}</li>
            ))}
          </ul>
          <a href={s.link.href} class:list={['d-btn', !s.dark && 'd-btn--ghost']} style="align-self: flex-start">
            {s.link.label} <i aria-hidden="true">↗</i>
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .sd {
    padding-block: var(--spacing-section);
  }
  .sd-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: 64px;
    text-align: center;
  }
  .sd-h {
    max-width: 16ch;
    font-size: clamp(48px, 7vw, 108px);
  }
  .sd-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .sd-cards {
      grid-template-columns: 1fr;
    }
  }
  .sd-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px;
    border-radius: 6px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .sd-card.d-band {
    background: var(--d-band);
  }
  .sd-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-2);
  }
  .sd-k {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .sd-name {
    font-size: clamp(48px, 5.4vw, 80px);
  }
  .sd-lede {
    max-width: 40ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .sd-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
  }
  .sd-visual > :global(.qw) {
    width: 100%;
  }
  .sd-phone {
    width: 190px;
    aspect-ratio: 393 / 852;
    padding: 6px;
    border-radius: 30px;
    background: var(--d-band);
  }
  .sd-phone video {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    object-fit: cover;
    background: #f1f3f5;
  }
  .sd-items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sd-items li {
    padding: 6px 10px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    font-size: 13px;
  }
</style>
