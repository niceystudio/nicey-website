---
/** Direction C: Work as numbered client sheets, three across (Openprest "Selected partners"). Same copy and figures as live. */
import { links } from '../../data/links';

const rows = [
  { name: 'QBench', practice: 'Design system + product', industry: 'LIMS', href: links.work.qbench, fig: '1,071 → 0', cap: 'Outside-library references', d: 'Years without a designer, consolidated into one semantic token system. Plus one status model for eight entry points, compliance steps included, shipped as an MVP.' },
  { name: 'Everbreed', practice: 'Design system + product', industry: 'Agtech', href: links.work.everbreed, fig: '302', cap: 'Variables made machine-readable', d: 'A mature Figma library made machine-readable, so the code config comes from Figma. And the student app built on it, on phone and desktop.' },
  { name: 'Clerky', practice: 'Design system', industry: 'Legal tech', href: links.work.clerky, fig: '0 T1', cap: 'Defects at the pilot gate', d: 'Three-tier tokens, AI-context docs on every component and token, and a zero-T1 defect gate. Validated at pilot scale on the Documents App.' },
  { name: 'Omnisafe', practice: 'Product design', industry: 'Insurance', href: links.work.omnisafe, fig: '16', cap: 'Modules tested before build', d: 'Sixteen modules, tested end to end with real employees before engineering began.' },
  { name: 'FLYR', practice: 'Product design', industry: 'Hospitality', href: links.work.flyr, fig: '[result to collect]', cap: 'One business result', d: 'Group Quotation MVP shipped, so hotels can see whether a group booking makes money.' },
];
---

<section id="work" aria-labelledby="work-head" class="c-sec">
  <div class="container-page">
    <div class="c-sec-head">
      <div class="flex flex-col gap-4">
        <span class="c-kicker"><b>■</b> Work</span>
        <h2 id="work-head" class="c-h2">Systems and products we have built</h2>
      </div>
    </div>
    <ol class="c-sheets" style="--cols: 3">
      {
        rows.map((r, i) => (
          <li id={`work-${r.name.toLowerCase()}`} style="scroll-margin-top: 96px">
            <a href={r.href} class="c-sheet">
              <span class="c-sheet-n">{String(rows.length - i).padStart(3, '0')}</span>
              <dl>
                <div>
                  <dt>Client</dt>
                  <dd class="c-big">{r.name}</dd>
                </div>
                <div>
                  <dt>Practice</dt>
                  <dd>
                    <span class="c-hl">{r.practice}</span>
                  </dd>
                </div>
                <div>
                  <dt>Industry</dt>
                  <dd>{r.industry}</dd>
                </div>
                <div>
                  <dt>Signal</dt>
                  <dd>
                    <span class="c-big">{r.fig}</span>
                    <br />
                    <span class="text-muted">{r.cap}</span>
                  </dd>
                </div>
                <div>
                  <dt>Project</dt>
                  <dd>{r.d}</dd>
                </div>
              </dl>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
