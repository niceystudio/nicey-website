---
const stats = [
  {
    client: 'Everbreed',
    label: 'Variables given IDs, scopes and code names, so code config comes from Figma',
    value: '302',
  },
  {
    client: 'QBench',
    label: 'Entry points brought under one status model, compliance steps included',
    value: '8',
  },
  {
    client: 'Omnisafe',
    label: 'Modules tested end to end with real employees before engineering began',
    value: '16',
  },
  { client: 'Clerky', label: 'T1 defects at the pilot gate on the Documents App', value: '0' },
];
---

<div class="panel-sub grid-4">
  {
    stats.map((s) => (
      <div class="flex min-h-[230px] flex-col justify-between gap-10 px-8 pt-7 pb-8 max-sm:min-h-0">
        <p class="m-0 max-w-[24ch] text-label text-pretty text-ink-2">
          <span class="caption-sm mb-2 block text-muted">{s.client}</span>
          {s.label}
        </p>
        <p class="m-0 -ml-[0.04em] text-stat tabular-nums">{s.value}</p>
      </div>
    ))
  }
</div>
