---
/**
 * The site footer on every page: studio line, navigation, every case study,
 * contact, and the copyright line. Sits below the closing band.
 */
import { links } from '../data/links';
import { publishedCaseStudies, caseHref } from '../data/case-studies';

/* 24 Nov: the footer is Direction A's only. The Human | Machine switch, the animated wordmark and the extra audit
   button were rendered and then hidden with CSS; they are gone (the Machine view still opens with the m key). */
interface Props {
  /** the page's Markdown twin (kept for callers; agents find it through <link rel="alternate"> in the head) */
  mdHref?: string;
  /** kept for callers; every page is Direction A now */
  directionA?: boolean;
}
const year = new Date().getFullYear();
const cols = [
  {
    head: 'Services',
    items: [
      { href: '/#audit', label: 'Free design system audit' },
      { href: '/#services', label: 'What we help with' },
      { href: '/#how', label: 'How we work' },
      { href: '/#faq', label: 'FAQ' },
    ],
  },
  {
    head: 'Case studies',
    items: publishedCaseStudies.map((c) => ({ href: caseHref(c.slug), label: c.linkName })),
  },
];
// contact split by purpose (Emir, 11 Nov; 'Write to us' removed 23 Nov until there is an address). The Markdown twin, llms.txt and the sitemap stay
// discoverable for agents through <link rel="alternate"> in the head and robots.txt, not as footer links.
const contact = [
  { head: 'Start a project', items: [{ href: links.bookCall, label: 'Book a call' }, { href: '/#audit', label: 'Get a free audit' }] },
  { head: 'Follow', items: [{ href: links.linkedin, label: 'LinkedIn' }, { href: links.github, label: 'GitHub' }] },
];
---

<footer class="site-foot border-t border-line">
  <div class="container-page site-foot-grid">
    <div class="flex max-w-[36ch] flex-col gap-4">
      <a
        href={links.home}
        class="text-[22px] leading-none font-semibold tracking-[-0.04em] text-ink no-underline"
        >nicey<span class="text-accent">.</span></a
      >
      <p class="m-0 text-body-sm text-pretty text-ink-2">
        Nicey Studio is a design systems studio for legacy products and teams scaling with agents. We turn drifted UI
        into one system of tokens, components and documentation that designers, engineers and coding agents read the
        same way.
      </p>
    </div>
    <nav aria-label="Footer" class="site-foot-cols">
      {
        cols.map((c) => (
          <div class="flex flex-col gap-3">
            <h2 class="caption-sm m-0 text-ink-2">{c.head}</h2>
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
              {c.items.map((it) => (
                <li>
                  <a href={it.href} class="text-body-sm text-ink no-underline hover:underline">
                    {it.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="flex flex-col gap-6">
        {contact.map((c) => (
          <div class="flex flex-col gap-3">
            <h2 class="caption-sm m-0 text-ink-2">{c.head}</h2>
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
              {c.items.map((it) => (
                <li>
                  <a href={it.href} class="text-body-sm text-ink no-underline hover:underline">
                    {it.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>
  </div>
  <div class="container-page site-foot-base">
    <p class="caption-sm m-0 text-ink-2">© {year} Nicey Studio · Design systems people and agents read the same way</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="#main" class="caption-sm text-ink-2 no-underline hover:underline">Back to top <span class="arr-up" aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    padding-block: var(--spacing-2xl) var(--spacing-lg);
  }
  .site-foot-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .site-foot-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-lg) var(--spacing-lg);
  }
  @media (min-width: 1024px) {
    .site-foot-grid {
      display: grid;
      grid-template-columns: minmax(260px, 1fr) minmax(0, 2.2fr);
      gap: var(--spacing-2xl);
    }
  }
  @media (max-width: 767px) {
    .site-foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .site-foot-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xs);
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }
</style>
