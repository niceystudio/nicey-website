---
/**
 * The site footer on every page: studio line, navigation, every case study,
 * contact, and the copyright line. Sits below the closing band.
 */
import { links } from '../data/links';
import { caseStudies, caseHref } from '../data/case-studies';

interface Props {
  /** the page's Markdown twin; when set, the strip shows the Human / Machine switch */
  mdHref?: string;
}
const { mdHref } = Astro.props;
const year = new Date().getFullYear();
const cols = [
  {
    head: 'Services',
    items: [
      { href: '/#audit', label: 'Free design system audit' },
      { href: '/#services', label: 'Design systems for AI agents' },
      { href: '/#services', label: 'Product design' },
      { href: '/#how', label: 'How we work' },
      { href: '/#faq', label: 'FAQ' },
    ],
  },
  {
    head: 'Case studies',
    items: caseStudies.map((c) => ({ href: caseHref(c.slug), label: c.linkName })),
  },
  {
    head: 'For agents',
    items: [
      ...(mdHref ? [{ href: mdHref, label: 'This page as Markdown' }] : []),
      { href: '/llms.txt', label: 'llms.txt' },
      { href: '/sitemap.xml', label: 'Sitemap' },
    ],
  },
  {
    head: 'Contact',
    items: [
      { href: links.bookCall, label: 'Book a call' },
      { href: links.email, label: 'Email' },
      { href: links.linkedin, label: 'LinkedIn' },
      { href: links.github, label: 'GitHub' },
    ],
  },
];
---

<footer class="site-foot border-t border-line">
  <div class="container-page site-foot-grid">
    <div class="flex max-w-[36ch] flex-col gap-4">
      <a
        href={links.home}
        class="text-[22px] leading-none font-semibold tracking-[-0.04em] text-ink no-underline"
        >nicey<span class="text-accent">.</span></a
      >
      <p class="m-0 text-body-sm text-pretty text-ink-2">
        Nicey Studio is a design systems studio for legacy products and teams scaling with agents. We turn drifted UI
        into one system of tokens, components and documentation that designers, engineers and coding agents read the
        same way.
      </p>
      <div class="flex flex-col items-start gap-2">
        <a href="/#audit" class="pill pill-ink px-[18px] text-body-sm">Get a free audit</a>
        <span class="font-mono text-caption text-ink-2">Free and read-only. Only your Figma file.</span>
      </div>
    </div>
    <nav aria-label="Footer" class="site-foot-cols">
      {
        cols.map((c) => (
          <div class="flex flex-col gap-3">
            <h2 class="caption-sm m-0 text-ink-2">{c.head}</h2>
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
              {c.items.map((it) => (
                <li>
                  <a href={it.href} class="text-body-sm text-ink no-underline hover:underline">
                    {it.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="container-page site-foot-tools" aria-label="Page tools" role="group">
    <div class="sft-row">
      {
        mdHref ? (
          <span class="sft-item">
            <span class="text-ink-2">view:</span>
            <button type="button" data-mv="human" aria-pressed="true">human</button>
            <span aria-hidden="true" class="text-ink-2">|</span>
            <button type="button" data-mv="machine" aria-pressed="false">machine</button>
            <kbd>m</kbd>
          </span>
        ) : null
      }
    </div>
    <p class="sft-note">
      {mdHref ? '// this page reads two ways. Switch to machine to see what an agent reads.' : '// every case study reads two ways. Open one and switch to machine.'}
    </p>
  </div>
  <div class="container-page site-foot-base">
    <p class="caption-sm m-0 text-ink-2">© {year} Nicey Studio · Design systems people and agents read the same way</p>
    <a href="#main" class="caption-sm text-ink-2 no-underline hover:underline">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-foot {
    padding-block: 64px 32px;
  }
  .site-foot-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .site-foot-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 32px;
  }
  @media (min-width: 1024px) {
    .site-foot-grid {
      display: grid;
      grid-template-columns: minmax(260px, 1fr) minmax(0, 2.2fr);
      gap: 64px;
    }
  }
  @media (max-width: 767px) {
    .site-foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .site-foot-tools {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }
  .sft-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
  }
  .sft-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    color: var(--color-ink);
    text-decoration: none;
  }
  a.sft-item:hover {
    text-decoration: underline;
  }
  .sft-item button {
    padding: 2px 6px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--color-ink-2);
    font: inherit;
    cursor: pointer;
  }
  .sft-item button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .sft-item kbd {
    padding: 0 5px;
    border: 1px solid var(--color-line-strong);
    border-radius: 4px;
    color: var(--color-ink-2);
    font: inherit;
    font-size: 0.9em;
  }
  .sft-note {
    margin: 0;
    color: var(--color-ink-2);
  }
  .site-foot-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }
</style>
