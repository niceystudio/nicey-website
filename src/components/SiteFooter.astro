---
/**
 * The site footer on every page: studio line, navigation, every case study,
 * contact, and the copyright line. Sits below the closing band.
 */
import { links } from '../data/links';
import { caseStudies, caseHref } from '../data/case-studies';

interface Props {
  /** the page's Markdown twin; when set, the base line shows the Human / Machine switch (no gesture, no animation — Emir, 12 Nov) */
  mdHref?: string;
}
const { mdHref } = Astro.props;
const year = new Date().getFullYear();
const cols = [
  {
    head: 'Services',
    items: [
      { href: '/#audit', label: 'Free design system audit' },
      { href: '/#services', label: 'Design systems for AI agents' },
      { href: '/#services', label: 'Product design' },
      { href: '/#how', label: 'How we work' },
      { href: '/#faq', label: 'FAQ' },
    ],
  },
  {
    head: 'Case studies',
    items: caseStudies.map((c) => ({ href: caseHref(c.slug), label: c.linkName })),
  },
];
// contact split by purpose (Emir, 11 Nov). The Markdown twin, llms.txt and the sitemap stay
// discoverable for agents through <link rel="alternate"> in the head and robots.txt, not as footer links.
const contact = [
  { head: 'Start a project', items: [{ href: links.bookCall, label: 'Book a call' }, { href: '/#audit', label: 'Get a free audit' }] },
  { head: 'Write to us', items: [{ href: links.email, label: 'Email' }] },
  { head: 'Follow', items: [{ href: links.linkedin, label: 'LinkedIn' }, { href: links.github, label: 'GitHub' }] },
];
---

<footer class="site-foot border-t border-line">
  <div class="container-page site-foot-grid">
    <div class="flex max-w-[36ch] flex-col gap-4">
      <a
        href={links.home}
        class="text-[22px] leading-none font-semibold tracking-[-0.04em] text-ink no-underline"
        >nicey<span class="text-accent">.</span></a
      >
      <p class="m-0 text-body-sm text-pretty text-ink-2">
        Nicey Studio is a design systems studio for legacy products and teams scaling with agents. We turn drifted UI
        into one system of tokens, components and documentation that designers, engineers and coding agents read the
        same way.
      </p>
      <div class="flex flex-col items-start gap-2">
        <a href="/#audit" class="pill pill-ink px-[18px] text-body-sm">Get a free audit</a>
        <span class="font-mono text-caption text-ink-2">Free and read-only. Only your Figma file.</span>
      </div>
    </div>
    <nav aria-label="Footer" class="site-foot-cols">
      {
        cols.map((c) => (
          <div class="flex flex-col gap-3">
            <h2 class="caption-sm m-0 text-ink-2">{c.head}</h2>
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
              {c.items.map((it) => (
                <li>
                  <a href={it.href} class="text-body-sm text-ink no-underline hover:underline">
                    {it.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="flex flex-col gap-6">
        {contact.map((c) => (
          <div class="flex flex-col gap-3">
            <h2 class="caption-sm m-0 text-ink-2">{c.head}</h2>
            <ul class="m-0 flex list-none flex-col gap-2 p-0">
              {c.items.map((it) => (
                <li>
                  <a href={it.href} class="text-body-sm text-ink no-underline hover:underline">
                    {it.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>
  </div>
  <div class="container-page site-foot-base">
    <p class="caption-sm m-0 text-ink-2">© {year} Nicey Studio · Design systems people and agents read the same way</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      {
        mdHref && (
          <div class="view-switch" role="group" aria-label="Read this page as">
            <span class="caption-sm text-ink-2">Read as</span>
            <span class="view-seg">
              <button type="button" data-mv="human" aria-pressed="true">Human</button>
              <button type="button" data-mv="machine" aria-pressed="false">Machine</button>
            </span>
          </div>
        )
      }
      <a href="#main" class="caption-sm text-ink-2 no-underline hover:underline">Back to top <span class="arr-up" aria-hidden="true">↑</span></a>
    </div>
  </div>
  <div class="container-page site-foot-markwrap" aria-hidden="true" data-human>
    <div class="site-foot-markin">
      <p class="site-foot-mark" data-mark>nicey<span class="text-accent">.</span></p>
      <canvas class="site-foot-canvas" data-mark-canvas></canvas>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    padding-block: 64px 32px;
  }
  .site-foot-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .site-foot-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 32px;
  }
  @media (min-width: 1024px) {
    .site-foot-grid {
      display: grid;
      grid-template-columns: minmax(260px, 1fr) minmax(0, 2.2fr);
      gap: 64px;
    }
  }
  @media (max-width: 767px) {
    .site-foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* the closing wordmark: the brand, big, as the last thing on the page.
     The text sets the size; the canvas on top redraws it in brand blocks. */
  .site-foot-markwrap {
    margin-top: 48px;
  }
  /* the canvas sits exactly on the text, inside the page padding */
  .site-foot-markin {
    position: relative;
  }
  .site-foot-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .site-foot-markwrap.is-drawn .site-foot-mark {
    visibility: hidden;
  }
  .site-foot-mark {
    margin: 0;
    padding-bottom: 0.14em; /* room for the y's tail */
    font-size: clamp(80px, 28vw, 400px);
    font-weight: 600;
    line-height: 0.85;
    white-space: nowrap;
    letter-spacing: 0.01em; /* blocks need a visible gap between letters (Emir, 12 Nov) */
    color: var(--color-ink);
    user-select: none;
  }
  /* Human / Machine: a plain two-option switch in the base line. Machine shows the page as an agent reads it. */
  .view-switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .view-seg {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
  }
  .view-seg button {
    min-height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    cursor: pointer;
  }
  .view-seg button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .site-foot-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }
</style>

<script>
  import { LIGHT_PALETTE, DARK_PALETTE } from '../lib/pixel-field';
  // The footer wordmark in brand blocks: scattered pastel blocks fly in and settle into
  // "nicey." left to right, turning ink (the dot turns accent). Drift → one system.
  // After that it stays still; blocks under the cursor flash a pastel and fade back (Emir, 11 Nov).
  document.querySelectorAll<HTMLElement>('.site-foot-markwrap').forEach(async (wrap) => {
    const text = wrap.querySelector<HTMLElement>('[data-mark]');
    const canvas = wrap.querySelector<HTMLCanvasElement>('[data-mark-canvas]');
    const ctx = canvas?.getContext('2d');
    if (!text || !canvas || !ctx) return;
    await document.fonts?.ready;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Cell = { x: number; y: number; dot: boolean; sx: number; sy: number; c: number[]; delay: number; flash: number; fc: number[] };
    let cells: Cell[] = [];
    let size = 8, W = 0, H = 0, dpr = 1, t0 = 0, raf = 0, visible = false, settled = false, played = false;

    const hex = (h: string) => {
      const m = h.trim().match(/^#?([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})/i);
      return m ? [parseInt(m[1], 16), parseInt(m[2], 16), parseInt(m[3], 16)] : [38, 37, 31];
    };
    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v);
    const pastel = () => {
      const dark = document.documentElement.dataset.theme === 'dark' ||
        (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
      const stops = (dark ? DARK_PALETTE : LIGHT_PALETTE).stops.slice(1);
      const s = stops[Math.floor(Math.random() * stops.length)];
      // solid blocks: the palette tint at full strength
      return dark ? [s[0] * 1.6, s[1] * 1.6, s[2] * 1.6] : [s[0] - 20, s[1] - 20, s[2] - 20];
    };

    const build = () => {
      const r = text.getBoundingClientRect();
      W = Math.round(r.width); H = Math.round(r.height);
      if (!W || !H) return;
      dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = W * dpr; canvas.height = H * dpr;
      const cs = getComputedStyle(text);
      const fs = parseFloat(cs.fontSize);
      size = Math.max(5, Math.round(fs / 26));
      // rasterise the wordmark once, then sample it on a grid of blocks
      const off = document.createElement('canvas');
      off.width = W; off.height = H;
      const o = off.getContext('2d')!;
      o.font = `${cs.fontWeight} ${fs}px ${cs.fontFamily}`;
      (o as any).letterSpacing = cs.letterSpacing;
      o.textBaseline = 'alphabetic';
      // match the paragraph's baseline: line-height box, text sits like in the DOM
      const m = o.measureText('nicey.');
      const lh = parseFloat(cs.lineHeight) || fs;
      const base = (lh - (m.fontBoundingBoxAscent + m.fontBoundingBoxDescent)) / 2 + m.fontBoundingBoxAscent;
      o.fillStyle = '#000';
      o.fillText('nicey', 0, base);
      const dotX = o.measureText('nicey').width;
      o.fillStyle = '#f00';
      o.fillText('.', dotX, base);
      const img = o.getImageData(0, 0, W, H).data;
      cells = [];
      for (let y = 0; y + size <= H; y += size)
        for (let x = 0; x + size <= W; x += size) {
          const i = ((y + (size >> 1)) * W + (x + (size >> 1))) * 4;
          if (img[i + 3] < 128) continue;
          const dot = img[i] > 128;
          cells.push({
            x, y, dot,
            sx: (Math.random() - 0.5) * size * 14,
            sy: H * (0.25 + Math.random() * 0.6),
            c: pastel(),
            delay: (x / W) * 700 + Math.random() * 260,
            flash: 0, fc: [0, 0, 0],
          });
        }
      wrap.classList.add('is-drawn');
    };

    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const mix = (a: number[], b: number[], k: number) => a.map((v, i) => Math.round(v + (b[i] - v) * k));

    const draw = (now: number) => {
      const ink = hex(css('--color-ink')), acc = hex(css('--color-accent'));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      let busy = false;
      for (const c of cells) {
        const target = c.dot ? acc : ink;
        let k = played ? Math.min(1, Math.max(0, (now - t0 - c.delay) / 900)) : 1;
        if (k < 1) busy = true;
        const e = ease(k);
        // colour resolves only in the last part of the flight
        let col = mix(c.c, target, Math.max(0, (k - 0.6) / 0.4)); // pastel while flying, ink as it lands
        if (c.flash > 0) { col = mix(target, c.fc, c.flash); c.flash = Math.max(0, c.flash - 0.02); busy = true; }
        ctx.globalAlpha = Math.min(1, k * 3);
        ctx.fillStyle = `rgb(${col[0]},${col[1]},${col[2]})`;
        ctx.fillRect(c.x + c.sx * (1 - e), c.y + c.sy * (1 - e), size - 1, size - 1);
      }
      ctx.globalAlpha = 1;
      if (!busy) settled = true;
    };

    // draw only while something moves: the entrance, or blocks fading back after a hover
    const loop = (now: number) => {
      if (!visible) { raf = 0; return; }
      settled = false;
      draw(now);
      raf = settled ? 0 : requestAnimationFrame(loop);
    };
    const kick = () => { if (visible && !raf) raf = requestAnimationFrame(loop); };
    // hover: the blocks under the cursor light up in a pastel, then settle back to ink
    wrap.addEventListener('pointermove', (e) => {
      if (reduced || !cells.length) return;
      const r = canvas.getBoundingClientRect();
      const x = e.clientX - r.left, y = e.clientY - r.top, reach = size * 1.6;
      let hit = false;
      for (const c of cells) {
        const dx = c.x + size / 2 - x, dy = c.y + size / 2 - y;
        if (dx * dx + dy * dy < reach * reach && c.flash < 0.6) { c.flash = 1; c.fc = pastel(); hit = true; }
      }
      if (hit) kick();
    });

    build();
    if (!cells.length) return;
    if (reduced) { draw(performance.now()); return; }
    played = false;
    draw(performance.now()); // settled frame until it scrolls in
    ctx.clearRect(0, 0, W, H);
    const io = new IntersectionObserver((es) => {
      visible = es.some((e) => e.isIntersecting);
      if (visible && !played) { played = true; settled = false; t0 = performance.now(); }
      if (visible) kick();
    }, { threshold: 0.2 });
    io.observe(wrap);
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { build(); draw(performance.now()); }, 150); });
    // theme switch: redraw with the new ink and palette
    new MutationObserver(() => { cells.forEach((c) => (c.c = pastel())); draw(performance.now()); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  });
</script>
