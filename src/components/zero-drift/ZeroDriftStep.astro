---
/**
 * One Zero Drift step in the v3 layout: caption, h3, illustration,
 * the three-part dl, and the figure block with its hot "Seen at" caption.
 * Shared by the static list (as <li>) and the story tabs (as a tabpanel).
 */
import type { HTMLAttributes } from 'astro/types';
import UnitChart from '../UnitChart.astro';
import { markerBg, type Step } from '../../data/zero-drift';

type Props = HTMLAttributes<'div'> & {
  step: Step;
  as?: 'li' | 'div';
};

const { step, as: Tag = 'li', class: className, ...rest } = Astro.props;

const found = [
  { name: 'purple-2', bg: 'bg-found-1', tilt: '-rotate-2' },
  { name: 'purpleLight2', bg: 'bg-found-2', tilt: 'rotate-[1.5deg]' },
  { name: 'brand/purple/30', bg: 'bg-found-3', tilt: '' },
  { name: 'col-7', bg: 'bg-found-4', tilt: '-rotate-1' },
  { name: 'violet-final', bg: 'bg-found-5', tilt: 'rotate-2' },
];
const pillars = [
  { name: 'Figma inspect', marker: markerBg.sage },
  { name: 'Agentic readiness', marker: markerBg.lavender },
  { name: 'Conventions', marker: markerBg.peach },
  { name: 'Component API', marker: markerBg.butter },
  { name: 'Zero drift', marker: markerBg.mauve },
];
---

<Tag class:list={['zd-step', className]} {...rest}>
  <span class="caption flex items-center gap-2 text-ink-2"
    ><i aria-hidden="true" class:list={['marker', markerBg[step.marker]]}></i>{step.num} · {step.name}</span
  >
  <h3 class="m-0 text-h3-step">{step.heading}</h3>

  {
    step.id === 'drift' && (
      <div aria-hidden="true" class="flex flex-wrap gap-2">
        {found.map((f) => (
          <span class:list={['chip', f.tilt]}>
            <i class:list={['block size-2.5 rounded-swatch', f.bg]} />
            {f.name}
          </span>
        ))}
        <span class="inline-flex items-center px-2.5 py-[7px] font-mono text-caption text-ink-2">+ 6 more</span>
      </div>
    )
  }
  {
    step.id === 'audit' && (
      <ul aria-label="Audit pillars" class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2.5 p-0 text-body-sm">
        {pillars.map((p) => (
          <li class="flex items-center gap-2">
            <i aria-hidden="true" class:list={['marker', p.marker]} />
            {p.name}
          </li>
        ))}
      </ul>
    )
  }
  {
    step.id === 'system' && (
      <p aria-hidden="true" class="m-0 flex flex-wrap items-center gap-2.5 font-mono text-code text-muted">
        <span class="chip text-code">violet.500</span>→<span class="chip text-code">color.accent</span>→
        <span class="chip text-code">Button/primary/bg</span>
      </p>
    )
  }
  {
    step.id === 'context' && (
      <pre
        aria-hidden="true"
        class="m-0 rounded-code border border-line bg-page px-[18px] py-4 font-mono text-code whitespace-pre-wrap text-ink-2"
        set:text={'## For agents\nIf a state is missing here, it does not exist. Ask, do not add.'}
      />
    )
  }
  {
    step.id === 'proof' && (
      <p class="m-0 flex items-center gap-2.5 text-body-sm font-medium">
        <i aria-hidden="true" class="marker bg-ink" />
        Pilot surface passed the defect gate
      </p>
    )
  }

  <dl class="zd-dl">
    <div><dt class="caption-sm text-ink-2">You’re seeing</dt><dd>{step.seeing}</dd></div>
    <div><dt class="caption-sm text-ink-2">We do</dt><dd>{step.weDo}</dd></div>
    <div><dt class="caption-sm text-ink-2">You get</dt><dd class="font-medium">{step.youGet}</dd></div>
  </dl>

  {
    step.id === 'drift' && (
      <div class="zd-fig-row">
        <p class="zd-fig">53</p>
        <p class="zd-fig-note">
          <span class="caption-sm mb-1 block text-hot">Seen at Everbreed</span>
          variables had drifted between the Figma file and the repo, with no IDs to tell a rename from a
          delete.
        </p>
      </div>
    )
  }
  {
    step.id === 'audit' && (
      <div class="zd-fig-row zd-fig-row--units">
        <p class="zd-fig flex items-baseline gap-[0.16em]">
          12<span class="text-[0.3em] tracking-[-0.02em] text-muted">of 52</span>
        </p>
        <div class="flex flex-[1_1_260px] flex-col gap-3">
          <UnitChart
            count={52}
            hot={12}
            columns={26}
            cell={8}
            label="52 cells, 12 marked: components without a description"
          />
          <p class="zd-fig-note">
            <span class="caption-sm mb-1 block text-hot">Seen at Clerky</span>
            components had no description an agent could read. All 315 semantic and component tokens
            already did.
          </p>
        </div>
      </div>
    )
  }
  {
    step.id === 'system' && (
      <div class="zd-fig-row">
        <p class="zd-fig whitespace-nowrap">
          1,071 <span class="text-muted">→</span> 0
        </p>
        <p class="zd-fig-note">
          <span class="caption-sm mb-1 block text-hot">Seen at QBench</span>
          references to 11 outside libraries, brought down to zero across 141 components.
        </p>
      </div>
    )
  }
  {
    step.id === 'context' && (
      <div class="flex flex-col gap-2 border-t border-line pt-6">
        <span class="caption-sm text-hot">Seen at Everbreed · the one rule in every agent file</span>
        <p class="m-0 font-mono text-quote">Report the gap. Don’t invent the value.</p>
      </div>
    )
  }
  {
    step.id === 'proof' && (
      <div class="zd-fig-row">
        <p class="zd-fig">0</p>
        <p class="zd-fig-note">
          <span class="caption-sm mb-1 block text-hot">Seen at Clerky</span>
          T1 defects: the gate for the pilot on the Documents App, and the model held at pilot scale.
        </p>
      </div>
    )
  }
</Tag>

<style>
  .zd-step {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: var(--spacing-cell);
    scroll-margin-top: 24px;
    container-type: inline-size;
  }
  .zd-dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }
  .zd-dl > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .zd-dl dd {
    margin: 0;
    font-size: var(--text-body);
    line-height: 1.5;
  }
  .zd-fig-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    column-gap: 28px;
    row-gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }
  .zd-fig-row--units {
    row-gap: 16px;
  }
  .zd-fig {
    margin: 0 0 0 -0.04em;
    /* stays inside the cell at 320px: "1,071 → 0" never wraps */
    font-size: min(var(--text-figure-step), 19cqi);
    line-height: var(--text-figure-step--line-height);
    letter-spacing: var(--text-figure-step--letter-spacing);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .zd-fig-note {
    flex: 1 1 260px;
    margin: 0;
    max-width: 40ch;
    font-size: var(--text-body-sm);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }
</style>
