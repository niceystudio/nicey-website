---
/**
 * Zero Drift, interactive story: Story v2's behaviour in v3's design.
 * APG tabs: arrow keys move between tabs, Home/End jump to the ends,
 * roving tabindex, aria-controls. The arrow buttons (back / forward) step through.
 */
import ZeroDriftIntro from './ZeroDriftIntro.astro';
import ZeroDriftStep from './ZeroDriftStep.astro';
import { markerBg, steps } from '../../data/zero-drift';
---

<section
  id="how"
  aria-labelledby="how-head"
  class="container-page flex flex-wrap items-start gap-x-[72px] gap-y-12 pb-section"
>
  <ZeroDriftIntro />
  <div class="panel story flex min-w-0 flex-[999_1_560px] flex-col" data-story>
    <div class="story-tabs" role="tablist" aria-label="Zero Drift steps">
      {
        steps.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${s.id}`}
            aria-controls={`step-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="story-tab"
          >
            <span class="flex items-center gap-2 font-mono text-caption text-ink-2">
              <i aria-hidden="true" class:list={['marker', markerBg[s.marker]]} />
              {s.num}
            </span>
            <span class="story-tab-name">{s.name}</span>
          </button>
        ))
      }
    </div>
    <div class="story-panels">
      {
        steps.map((s, i) => (
          <ZeroDriftStep
            as="div"
            step={s}
            id={`step-${s.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${s.id}`}
            tabindex="0"
            hidden={i !== 0}
            class="story-panel"
          />
        ))
      }
    </div>
    <div class="story-controls">
      <!-- arrow buttons like the case-study steps: back on the left, forward on the right (Emir, 12 Nov) -->
      <button type="button" class="story-btn" data-prev aria-disabled="true" aria-label="Previous step"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9H4M8 4.5 3.5 9 8 13.5" /></svg></button>
      <button type="button" class="story-btn story-btn--next" data-next aria-label="Next step"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 4.5 14.5 9 10 13.5" /></svg></button>
    </div>
  </div>
</section>

<style>
  .story-tabs {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .story-tabs::-webkit-scrollbar {
    display: none;
  }
  .story-tab {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-height: 44px;
    padding: 18px 20px 16px;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
    scroll-snap-align: start;
  }
  .story-tab-name {
    font-size: var(--text-body-sm);
    line-height: 1.3;
  }
  .story-tab::after {
    content: '';
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 0;
    height: 2px;
    background: transparent;
  }
  .story-tab[aria-selected='true'] .story-tab-name {
    font-weight: 500;
  }
  .story-tab[aria-selected='true']::after {
    background: var(--color-ink);
  }
  @media (hover: hover) {
    .story-tab[aria-selected='false']:hover {
      background: var(--color-surface-hover);
    }
  }
  /* mobile: tabs scroll, the next one peeks past the edge */
  @media (max-width: 639px) {
    .story-tab {
      flex: 0 0 auto;
      min-width: 112px;
    }
  }

  /* the panels are ZeroDriftStep roots, outside this component's scope */
  .story :global(.story-panel[hidden]) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .story :global(.story-panel) {
      transition: opacity 180ms ease;
    }
  }
  .story :global(.story-panel.is-entering) {
    opacity: 0;
  }

  .story-controls {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 16px var(--spacing-cell);
  }
  .story-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: transform 160ms var(--ease-out), background-color 200ms var(--ease-out);
  }
  .story-btn:active:not([aria-disabled='true']) {
    transform: scale(0.94);
  }
  .story-btn--next {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .story-btn:not(.story-btn--next):not([aria-disabled='true']):hover {
      background: var(--color-surface-hover);
    }
  }
  .story-btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: default;
  }
</style>

<script>
  function mountStory(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? ''));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;

    function select(i: number, focus: boolean) {
      const n = Math.max(0, Math.min(tabs.length - 1, i));
      if (n !== current) {
        tabs.forEach((t, k) => {
          const on = k === n;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
        });
        panels.forEach((p, k) => {
          if (!p) return;
          p.hidden = k !== n;
        });
        const panel = panels[n];
        if (panel && !reduced.matches) {
          // short opacity crossfade in; none under reduced motion
          panel.classList.add('is-entering');
          void panel.offsetWidth; // commit opacity 0 so the transition runs
          panel.classList.remove('is-entering');
        }
        current = n;
      }
      tabs[n].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduced.matches ? 'auto' : 'smooth' });
      if (focus) tabs[n].focus();
      prev?.setAttribute('aria-disabled', String(n === 0));
      next?.setAttribute('aria-disabled', String(n === tabs.length - 1));
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, false));
      t.addEventListener('keydown', (e) => {
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') to = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = tabs.length - 1;
        if (to < 0) return;
        e.preventDefault();
        select(to, true);
      });
    });
    prev?.addEventListener('click', () => {
      if (prev.getAttribute('aria-disabled') !== 'true') select(current - 1, false);
    });
    next?.addEventListener('click', () => {
      if (next.getAttribute('aria-disabled') !== 'true') select(current + 1, false);
    });

    // deep link: /story#step-system opens that step
    const fromHash = panels.findIndex((p) => p && `#${p.id}` === location.hash);
    if (fromHash > 0) select(fromHash, false);
  }

  document.querySelectorAll<HTMLElement>('[data-story]').forEach(mountStory);
</script>
