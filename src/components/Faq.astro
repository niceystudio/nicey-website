---
import Gaps from './case-study/Gaps.astro';
/** The FAQ. Homepage by default; case studies pass their own questions and heading. */
interface Props {
  items?: { q: string; a: string }[];
  caption?: string;
  heading?: string;
  id?: string;
}
const homeFaqs = [
  {
    q: 'What does the free audit need from us?',
    a: 'Your Figma file. Read access to the repo is optional; with it, we also compare your Figma tokens against the compiled CSS and source code.',
  },
  {
    q: 'Do we need to rename everything first?',
    a: 'No. Renaming is risky and IDs are cheap. Each token gets an ID that survives renames, a scope and a code name, and Figma stays the source of truth.',
  },
  {
    q: 'What does “AI-ready” actually mean?',
    a: 'Four checks you can run today: components have descriptions, components bind to semantic tokens rather than primitives, inputs declare their icon and action slots, and tokens have descriptions.',
  },
  {
    q: 'We have a live product with legacy code. Can you still help?',
    a: 'That is most of our work. We migrate in slices, so the product keeps shipping while the system replaces what was there.',
  },
  {
    q: 'Won’t this slow our team down?',
    a: 'We start with one real surface from your roadmap as the pilot, so the first thing the system produces is something you were going to ship anyway.',
  },
  {
    q: 'How does this work with our coding agents?',
    a: 'Every token and component gets a context file your agents read. The pilot can be built by your team’s agent, and it has to pass the same defect gate.',
  },
  {
    q: 'Who maintains the system after you leave?',
    a: 'Your team, with the documentation and review cadence we set up. Or we stay on as your systems partner on a monthly retainer.',
  },
];
const { items = homeFaqs, caption = 'Questions', heading = 'Before you book a call', id = 'faq' } = Astro.props;
const faqs = items;
---

<section id={id}
  aria-labelledby={`${id}-head`}
  class="container-page flex flex-wrap items-start gap-x-[72px] gap-y-10 pb-section"
>
  <div class="flex flex-[1_1_300px] flex-col gap-3.5">
    <span class="caption text-ink-2">{caption}</span>
    <h2 id={`${id}-head`} class="m-0 text-h2">{heading}</h2>
  </div>
  <div class="panel flex min-w-0 flex-[999_1_560px] flex-col">
    {
      faqs.map((f, i) => (
        <details class="faq" open={i === 0}>
          <summary>
            <span class="font-mono text-caption font-medium text-muted">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="flex-1">{f.q}</span>
            <span class="faq-ind" aria-hidden="true" />
          </summary>
          <p class="m-0 max-w-[60ch] pb-7 pl-9 text-body leading-[1.6] text-pretty text-ink-2"><Gaps text={f.a} /></p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    padding: 0 32px;
  }
  .faq summary {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 76px;
    padding-block: 12px;
    font-size: var(--text-faq);
    line-height: var(--text-faq--line-height);
    letter-spacing: var(--text-faq--letter-spacing);
    font-weight: 500;
  }
  /* the row is the target: let the ring wrap the whole summary */
  .faq summary:focus-visible {
    margin-inline: -24px;
    padding-inline: 24px;
  }
  .faq-ind {
    font-family: var(--font-mono);
    font-size: 18px;
    line-height: 1;
    color: var(--color-ink-2);
  }
  .faq-ind::before {
    content: '+';
  }
  .faq[open] .faq-ind::before {
    content: '\2212';
  }
  @media (max-width: 479px) {
    .faq {
      padding: 0 20px;
    }
    .faq summary {
      gap: 12px;
    }
    .faq p {
      padding-left: 0;
    }
    .faq summary:focus-visible {
      margin-inline: -16px;
      padding-inline: 16px;
    }
  }
</style>
