---
/**
 * QBench status workflows hero: wherever the change starts, the same steps run.
 * The source cycles every few seconds (or on click); the steps light one after another.
 * Surfaces and step order are from the QBench Figma (fields → signature / PIN → comment).
 */
const sources = ['Order detail page', 'Test list page', 'Publishing a report', 'Automations', 'API'];
const steps = [
  { k: 'Move', v: 'In progress → Completed' },
  { k: 'Page 1', v: 'Required fields' },
  { k: 'Page 2', v: 'E-signature · PIN · Comment' },
  { k: 'Done', v: 'Recorded in history' },
];
---

<div class="sh" data-sh>
  <div class="sh-card">
    <div class="sh-bar">
      <span class="sh-mono">Status change</span>
      <span class="sh-mono sh-live"><i aria-hidden="true"></i> same steps</span>
    </div>
    <div class="sh-stage">
      <div class="sh-src" role="group" aria-label="Where the change starts">
        <span class="sh-k">Starts from</span>
        {
          sources.map((s, i) => (
            <button type="button" class="sh-chip" data-sh-src={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              {s}
            </button>
          ))
        }
      </div>
      <ol class="sh-steps" aria-label="Steps that run">
        {
          steps.map((st, i) => (
            <li style={`--i:${i}`}>
              <span class="sh-dot" aria-hidden="true" />
              <span class="sh-k">{st.k}</span>
              <span class="sh-v">{st.v}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</div>

<style>
  .sh {
    width: 100%;
  }
  .sh-card {
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  .sh-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 8px 18px;
    border-bottom: 1px solid var(--color-line);
  }
  .sh-mono,
  .sh-k {
    font-family: var(--font-mono);
    font-size: var(--text-caption-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
  }
  .sh-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sh-live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .sh-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 28px;
    padding: 24px;
  }
  @media (max-width: 520px) {
    .sh-stage {
      grid-template-columns: 1fr;
    }
  }
  .sh-src {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .sh-chip {
    padding: 8px 12px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink-2);
    font: inherit;
    font-size: var(--text-body-sm);
    cursor: pointer;
    transition: transform 160ms var(--ease-out), background-color 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .sh-chip:active {
    transform: scale(0.97);
  }
  .sh-chip[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-on-ink);
  }
  .sh-steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .sh-steps > li {
    position: relative;
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    column-gap: 14px;
    padding-bottom: 18px;
  }
  .sh-steps > li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 16px;
    bottom: 2px;
    width: 2px;
    background: var(--color-line-strong);
  }
  .sh-dot {
    grid-row: 1 / 3;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    border: 2px solid var(--color-line-strong);
    border-radius: 50%;
    background: var(--color-surface);
    transition: background-color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .sh-steps .sh-k {
    grid-column: 2;
  }
  .sh-v {
    grid-column: 2;
    font-size: var(--text-body);
  }
  .sh-steps > li.is-on .sh-dot {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-sh]').forEach((root) => {
    const chips = root.querySelectorAll<HTMLButtonElement>('[data-sh-src]');
    const steps = root.querySelectorAll<HTMLElement>('.sh-steps > li');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timers: number[] = [];
    let cycle = 0;
    const run = () => {
      timers.forEach(clearTimeout);
      timers = [];
      steps.forEach((s) => s.classList.remove('is-on'));
      if (reduced) {
        steps.forEach((s) => s.classList.add('is-on'));
        return;
      }
      steps.forEach((s, k) => timers.push(window.setTimeout(() => s.classList.add('is-on'), 250 + k * 420)));
    };
    const pick = (i: number) => {
      current = i;
      chips.forEach((c, k) => c.setAttribute('aria-pressed', String(k === i)));
      run();
    };
    chips.forEach((c, i) =>
      c.addEventListener('click', () => {
        clearInterval(cycle);
        pick(i);
      }),
    );
    pick(0);
    if (!reduced) cycle = window.setInterval(() => pick((current + 1) % chips.length), 3200);
  });
</script>
