---
/**
 * QBench "From the work": Input in every state, and what an agent reads for each.
 * People see the fields; the agent never looks at them. It reads the props and
 * the tokens behind the selected state, typed out line by line in the panel.
 * Props are the real V2 Input props; tokens are the ones in the 08 State rules tab.
 */
interface Props {
  /** Figma | Tokens | Agent tabs over the reading panel (idea 3, approved 12 Nov; used on the homepage) */
  tabs?: boolean;
  /** no own lavender stage: the parent (homepage Services) already draws it */
  bare?: boolean;
}
const { tabs = false, bare = false } = Astro.props;

const states = [
  {
    id: 'default',
    name: 'Default',
    read: ['state: "default"', 'content: "filled"', 'hasError: false', '→ the resting field, ready for input'],
  },
  {
    id: 'hover',
    name: 'Hover',
    read: ['state: "hover"', 'content: "filled"', 'hasError: false', '→ same field, pointer over it'],
  },
  {
    id: 'focus',
    name: 'Focus',
    read: ['state: "focus"', 'border: border/primary/default', 'hasError: false', '→ the field taking keyboard input'],
  },
  {
    id: 'disabled',
    name: 'Disabled',
    read: ['state: "disabled"', 'opacity: opacity/disabled · 50%', 'hasError: false', '→ shown, not editable'],
  },
  {
    id: 'error',
    name: 'Error',
    read: ['state: "default"', 'hasError: true', 'border: border/critical/default', '→ show the message, say what to fix'],
  },
];

// the same selected state, as three readers see it. Description and tokens read from the
// QBench V2 Input (795:10188, variants content=filled) on 12 Nov.
const DESC = [
  'Input. Single-line field for entering short text or values.',
  'Use for text and numbers. Not for selecting options — use Select.',
  'Not for showing saved values that cannot be edited — use Field.',
];
const tokensOf: Record<string, Record<string, string>> = {
  default: { border: 'border/default', background: 'component/input/surface/default', text: 'text/default' },
  hover: { border: 'border/hover', background: 'component/input/surface/hover', text: 'text/default' },
  focus: { border: 'border/primary/default', background: 'component/input/surface/default', text: 'text/default' },
  disabled: { border: 'border/default', background: 'component/input/surface/default', opacity: 'opacity/disabled', text: 'text/placeholder' },
  error: { border: 'border/critical/default', background: 'component/input/surface/default', helperText: 'text/critical/default' },
};
const propsOf: Record<string, [string, string][]> = {
  default: [['state', 'default'], ['content', 'filled'], ['hasError', 'false']],
  hover: [['state', 'hover'], ['content', 'filled'], ['hasError', 'false']],
  focus: [['state', 'focus'], ['content', 'filled'], ['hasError', 'false']],
  disabled: [['state', 'disabled'], ['content', 'filled'], ['hasError', 'false']],
  error: [['state', 'default'], ['content', 'filled'], ['hasError', 'true']],
};
const readers = states.map((s) => {
  const props = propsOf[s.id];
  const toks = tokensOf[s.id];
  const meaning = s.read[s.read.length - 1];
  return {
    figma: ['Input', ...props.map(([k, v]) => `  ${k.padEnd(9)} ${v}`)],
    tokens: ['{', ...Object.entries(toks).map(([k, v], i, a) => `  "${k}": "${v}"${i < a.length - 1 ? ',' : ''}`), '}'],
    agent: ['## Input', ...DESC, '', ...props.map(([k, v]) => `${k}: ${v}`), ...Object.entries(toks).map(([k, v]) => `${k}: ${v}`), meaning],
  };
});
const tabList = [
  { id: 'figma', label: 'Figma', who: 'designer · properties panel', src: 'Input.fig' },
  { id: 'tokens', label: 'Tokens', who: 'engineer · tokens', src: 'tokens.json' },
  { id: 'agent', label: 'Agent', who: 'agent · reading', src: 'input.md' },
];
---

<figure class="qw m-0" data-qw data-states={JSON.stringify(states.map((s) => s.read))} data-readers={tabs ? JSON.stringify(readers) : undefined}>
  <div class:list={['qw-stage', bare ? 'qw-stage--bare' : 'bg-lavender']}>
    <div class="qw-states" role="group" aria-label="Input states">
      {
        states.map((s, i) => (
          <button
            type="button"
            class:list={['qw-state', `is-${s.id}`]}
            data-i={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="qw-mono qw-state-n">
              0{i + 1} · {s.name}
            </span>
            <span class="qw-field" aria-hidden="true">
              <span class="qw-label">Batch ID *</span>
              <span class="qw-input">{s.id === 'disabled' ? 'Not editable' : 'B-2026-0142'}</span>
              <span class="qw-help">{s.id === 'error' ? 'Enter a valid batch ID' : 'Printed on the label'}</span>
            </span>
          </button>
        ))
      }
    </div>
    <div class="qw-agent" aria-live="polite" data-md-skip>
      {
        tabs ? (
          <div class="qw-agent-bar qw-tabs-bar">
            <div class="qw-tabs" role="tablist" aria-label="Who is reading">
              {tabList.map((t, i) => (
                <button type="button" role="tab" class="qw-tab" data-tab={t.id} aria-selected={i === 2 ? 'true' : 'false'}>
                  {t.label}
                </button>
              ))}
            </div>
            <span class="qw-agent-src" data-src>
              {tabList[2].src}
            </span>
          </div>
        ) : (
          <div class="qw-agent-bar">
            <span class="qw-dot" aria-hidden="true" />
            <span>agent · reading</span>
            <span class="qw-agent-k">Input</span>
            <span class="qw-agent-src">library.json</span>
          </div>
        )
      }
      <pre class="qw-agent-out" data-out>{tabs ? readers[0].agent.join('\n') : states[0].read.join('\n')}</pre>
    </div>
  </div>
  {
    !bare && (
      <figcaption class="qw-cap">
        <span class="qw-cap-k">Fig 01</span>
        <span>People see five fields. An agent reads five sets of props and tokens, and picks the right one without guessing.</span>
      </figcaption>
    )
  }
</figure>

<style>
  .qw-mono {
    font-family: var(--font-mono);
    font-size: var(--text-caption-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* label and sentence share one baseline, the sentence wraps under itself (case study only) */
  .qw-cap {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 14px;
    font-size: var(--text-body-sm);
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .qw-cap-k {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-caption-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .qw-stage--bare {
    width: 100%;
    padding: 0 !important;
  }
  /* on a phone the five fields go two by two instead of one long column */
  @media (max-width: 600px) {
    .qw-stage--bare .qw-states {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .qw-stage--bare .qw-field {
      padding: 12px;
      font-size: 11px;
    }
  }
  .qw-stage {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 36px;
    border-radius: var(--radius-panel);
    color: #26251f;
  }
  .qw-states {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
  }
  .qw-state {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .qw-state-n {
    color: #4d4a40;
  }
  .qw-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: 10px;
    background: #fff;
    color: #1f2a3d;
    font-size: 12px;
    outline: 2px solid transparent;
    outline-offset: 3px;
  }
  .qw-state[aria-pressed='true'] .qw-field {
    outline-color: #26251f;
  }
  .qw-state[aria-pressed='true'] .qw-state-n {
    color: #26251f;
  }
  /* the lavender stage is dark at night: the state labels go light so they stay readable */
  :global([data-theme='dark']) .qw-state-n {
    color: rgba(243, 240, 233, 0.55);
  }
  :global([data-theme='dark']) .qw-state[aria-pressed='true'] .qw-state-n {
    color: #f3f0e9;
  }
  .qw-state:focus-visible {
    outline: none;
  }
  .qw-state:focus-visible .qw-field {
    outline-color: var(--color-focus);
  }
  @media (prefers-reduced-motion: no-preference) {
    .qw-field {
      transition: outline-color 200ms ease;
    }
  }
  .qw-label {
    font-weight: 600;
  }
  .qw-input {
    padding: 8px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
  }
  .qw-help {
    color: #64748b;
  }
  .is-hover .qw-input {
    border-color: #94a3b8;
    background: #f8fafc;
  }
  .is-focus .qw-input {
    border-color: #244d9e;
    box-shadow: 0 0 0 3px rgba(36, 77, 158, 0.18);
  }
  .is-disabled .qw-field > * {
    opacity: 0.5;
  }
  .is-error .qw-input {
    border-color: #c0392b;
  }
  .is-error .qw-help {
    color: #c0392b;
  }

  .qw-agent {
    border-radius: 12px;
    background: #26251f;
    color: #f3f0e9;
    overflow: hidden;
  }
  .qw-agent-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(243, 240, 233, 0.12);
    font-family: var(--font-mono);
    font-size: 12px;
    color: #b6b1a3;
  }
  .qw-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #cbdac4;
  }
  .qw-agent-k {
    color: #d9d2ef;
  }
  .qw-agent-src {
    margin-left: auto;
  }
  /* the agent reading is the longest of the three: keep the panel that tall on every tab */
  .qw[data-readers] .qw-agent-out {
    min-height: calc(13 * 1.7em + 32px);
  }
  .qw-tabs-bar {
    padding-block: 6px;
  }
  .qw-tabs {
    display: flex;
    gap: 2px;
  }
  .qw-tab {
    min-height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #b6b1a3;
    font: inherit;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out), transform 160ms var(--ease-out);
  }
  .qw-tab:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .qw-tab[aria-selected='false']:hover {
      color: #f3f0e9;
      background: rgba(243, 240, 233, 0.06);
    }
  }
  .qw-tab[aria-selected='true'] {
    background: rgba(243, 240, 233, 0.12);
    color: #f3f0e9;
  }
  .qw-agent-out {
    min-height: calc(4 * 1.7em + 32px);
    margin: 0;
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .qw-agent-out::after {
    content: '▍';
    color: #cbdac4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .qw-agent-out::after {
      animation: qw-blink 1s steps(1) infinite;
    }
  }
  @keyframes qw-blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 600px) {
    .qw-stage {
      padding: 20px;
    }
  }
</style>

<script>
  function mount(root: HTMLElement) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const plain: string[][] = JSON.parse(root.dataset.states ?? '[]');
    // with tabs, each state has three readings and the tab picks one
    const readers: Record<string, string[]>[] | null = root.dataset.readers ? JSON.parse(root.dataset.readers) : null;
    const tabEls = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const srcEl = root.querySelector<HTMLElement>('[data-src]');
    const SRC: Record<string, string> = { figma: 'Input.fig', tokens: 'tokens.json', agent: 'input.md' };
    let tab = 'agent';
    const linesFor = (i: number) => (readers ? readers[i][tab] : plain[i]);
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-i]'));
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    let current = 0;
    let typing = 0;
    let tour = 0;
    let userTook = false;

    function read(i: number) {
      current = i;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.i) === i)));
      window.clearInterval(typing);
      const text = linesFor(i).join('\n');
      if (reduced.matches) {
        out.textContent = text;
        return;
      }
      let n = 0;
      out.textContent = '';
      typing = window.setInterval(() => {
        n += 2;
        out.textContent = text.slice(0, n);
        if (n >= text.length) window.clearInterval(typing);
      }, 16);
    }

    function startTour() {
      window.clearInterval(tour);
      if (reduced.matches || userTook) return;
      tour = window.setInterval(() => read((current + 1) % plain.length), 2600);
    }

    tabEls.forEach((t) => {
      t.addEventListener('click', () => {
        tab = t.dataset.tab!;
        tabEls.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        if (srcEl) srcEl.textContent = SRC[tab];
        userTook = true;
        window.clearInterval(tour);
        read(current);
      });
    });

    buttons.forEach((b) => {
      const i = Number(b.dataset.i);
      const take = () => {
        userTook = true;
        window.clearInterval(tour);
        if (i !== current) read(i);
      };
      b.addEventListener('click', take);
      b.addEventListener('focus', take);
      b.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') take();
      });
    });

    // the tour runs only while the figure is on screen
    new IntersectionObserver(
      (es) => {
        if (es[0].isIntersecting) {
          if (!userTook) read(current);
          startTour();
        } else window.clearInterval(tour);
      },
      { threshold: 0.4 },
    ).observe(root);
  }
  document.querySelectorAll<HTMLElement>('[data-qw]').forEach(mount);
</script>
