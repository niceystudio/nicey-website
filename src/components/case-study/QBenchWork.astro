---
/**
 * QBench "From the work": Input in every state, and what an agent reads for each.
 * People see the fields; the agent never looks at them. It reads the props and
 * the tokens behind the selected state, typed out line by line in the panel.
 * Props are the real V2 Input props; tokens are the ones in the 08 State rules tab.
 */
const states = [
  {
    id: 'default',
    name: 'Default',
    read: ['state: "default"', 'content: "filled"', 'hasError: false', '→ the resting field, ready for input'],
  },
  {
    id: 'hover',
    name: 'Hover',
    read: ['state: "hover"', 'content: "filled"', 'hasError: false', '→ same field, pointer over it'],
  },
  {
    id: 'focus',
    name: 'Focus',
    read: ['state: "focus"', 'border: border/primary/default', 'hasError: false', '→ the field taking keyboard input'],
  },
  {
    id: 'disabled',
    name: 'Disabled',
    read: ['state: "disabled"', 'opacity: opacity/disabled · 50%', 'hasError: false', '→ shown, not editable'],
  },
  {
    id: 'error',
    name: 'Error',
    read: ['state: "default"', 'hasError: true', 'border: border/critical/default', '→ show the message, say what to fix'],
  },
];
---

<figure class="qw m-0" data-qw data-states={JSON.stringify(states.map((s) => s.read))}>
  <div class="qw-stage bg-lavender">
    <div class="qw-states" role="group" aria-label="Input states">
      {
        states.map((s, i) => (
          <button
            type="button"
            class:list={['qw-state', `is-${s.id}`]}
            data-i={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="qw-mono qw-state-n">
              0{i + 1} · {s.name}
            </span>
            <span class="qw-field" aria-hidden="true">
              <span class="qw-label">Batch ID *</span>
              <span class="qw-input">{s.id === 'disabled' ? 'Not editable' : 'B-2026-0142'}</span>
              <span class="qw-help">{s.id === 'error' ? 'Enter a valid batch ID' : 'Printed on the label'}</span>
            </span>
          </button>
        ))
      }
    </div>
    <div class="qw-agent" aria-live="polite">
      <div class="qw-agent-bar">
        <span class="qw-dot" aria-hidden="true"></span>
        <span>agent · reading</span>
        <span class="qw-agent-k">Input</span>
        <span class="qw-agent-src">library.json</span>
      </div>
      <pre class="qw-agent-out" data-out>{states[0].read.join('\n')}</pre>
    </div>
  </div>
  <figcaption class="qw-cap">
    <span class="caption-sm text-muted">Fig 0.1</span> People see five fields. An agent sees five sets of props and
    tokens, and picks the right one without looking.
  </figcaption>
</figure>

<style>
  .qw-mono {
    font-family: var(--font-mono);
    font-size: var(--text-caption-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .qw-cap {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 12px;
    font-size: var(--text-body-sm);
    color: var(--color-ink-2);
  }
  .qw-stage {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 36px;
    border-radius: var(--radius-panel);
    color: #26251f;
  }
  .qw-states {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
  }
  .qw-state {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .qw-state-n {
    color: #4d4a40;
  }
  .qw-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: 10px;
    background: #fff;
    color: #1f2a3d;
    font-size: 12px;
    outline: 2px solid transparent;
    outline-offset: 3px;
  }
  .qw-state[aria-pressed='true'] .qw-field {
    outline-color: #26251f;
  }
  .qw-state[aria-pressed='true'] .qw-state-n {
    color: #26251f;
  }
  .qw-state:focus-visible {
    outline: none;
  }
  .qw-state:focus-visible .qw-field {
    outline-color: var(--color-focus);
  }
  @media (prefers-reduced-motion: no-preference) {
    .qw-field {
      transition: outline-color 200ms ease;
    }
  }
  .qw-label {
    font-weight: 600;
  }
  .qw-input {
    padding: 8px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
  }
  .qw-help {
    color: #64748b;
  }
  .is-hover .qw-input {
    border-color: #94a3b8;
    background: #f8fafc;
  }
  .is-focus .qw-input {
    border-color: #244d9e;
    box-shadow: 0 0 0 3px rgba(36, 77, 158, 0.18);
  }
  .is-disabled .qw-field > * {
    opacity: 0.5;
  }
  .is-error .qw-input {
    border-color: #c0392b;
  }
  .is-error .qw-help {
    color: #c0392b;
  }

  .qw-agent {
    border-radius: 12px;
    background: #26251f;
    color: #f3f0e9;
    overflow: hidden;
  }
  .qw-agent-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(243, 240, 233, 0.12);
    font-family: var(--font-mono);
    font-size: 12px;
    color: #b6b1a3;
  }
  .qw-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #cbdac4;
  }
  .qw-agent-k {
    color: #d9d2ef;
  }
  .qw-agent-src {
    margin-left: auto;
  }
  .qw-agent-out {
    min-height: calc(4 * 1.7em + 32px);
    margin: 0;
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .qw-agent-out::after {
    content: '▍';
    color: #cbdac4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .qw-agent-out::after {
      animation: qw-blink 1s steps(1) infinite;
    }
  }
  @keyframes qw-blink {
    50% {
      opacity: 0;
    }
  }
  @media (max-width: 600px) {
    .qw-stage {
      padding: 20px;
    }
  }
</style>

<script>
  function mount(root: HTMLElement) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const reads: string[][] = JSON.parse(root.dataset.states ?? '[]');
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-i]'));
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    let current = 0;
    let typing = 0;
    let tour = 0;
    let userTook = false;

    function read(i: number) {
      current = i;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.i) === i)));
      window.clearInterval(typing);
      const text = reads[i].join('\n');
      if (reduced.matches) {
        out.textContent = text;
        return;
      }
      let n = 0;
      out.textContent = '';
      typing = window.setInterval(() => {
        n += 2;
        out.textContent = text.slice(0, n);
        if (n >= text.length) window.clearInterval(typing);
      }, 16);
    }

    function startTour() {
      window.clearInterval(tour);
      if (reduced.matches || userTook) return;
      tour = window.setInterval(() => read((current + 1) % reads.length), 2600);
    }

    buttons.forEach((b) => {
      const i = Number(b.dataset.i);
      const take = () => {
        userTook = true;
        window.clearInterval(tour);
        if (i !== current) read(i);
      };
      b.addEventListener('click', take);
      b.addEventListener('focus', take);
      b.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') take();
      });
    });

    // the tour runs only while the figure is on screen
    new IntersectionObserver(
      (es) => {
        if (es[0].isIntersecting) {
          if (!userTook) read(current);
          startTour();
        } else window.clearInterval(tour);
      },
      { threshold: 0.4 },
    ).observe(root);
  }
  document.querySelectorAll<HTMLElement>('[data-qw]').forEach(mount);
</script>
