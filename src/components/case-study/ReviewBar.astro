---
/**
 * Review-only switch between hero text options (?h=a|b|c).
 * Shown in dev, or on any build when the URL carries ?review.
 * Remove it (and the losing options) once Emir picks one.
 */
interface Props {
  options: string[];
}
const { options } = Astro.props;
const dev = import.meta.env.DEV;
---

<div class="rb" data-review-bar hidden={!dev}>
  <span class="rb-k">Hero</span>
  {
    options.map((o, i) => (
      <button type="button" data-v={o} aria-pressed={i === 0 ? 'true' : 'false'}>
        {o.toUpperCase()}
      </button>
    ))
  }
</div>

<style>
  .rb {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: #26251f;
    color: #f3f0e9;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }
  .rb[hidden] {
    display: none;
  }
  .rb-k {
    padding: 0 8px 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #b6b1a3;
  }
  .rb button {
    min-width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .rb button[aria-pressed='true'] {
    background: #f3f0e9;
    color: #26251f;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-review-bar]');
  const params = new URLSearchParams(location.search);
  if (bar) {
    if (params.has('review')) bar.hidden = false;
    const opts = document.querySelectorAll<HTMLElement>('[data-hero-opt]');
    const buttons = bar.querySelectorAll<HTMLButtonElement>('button');
    const show = (v: string) => {
      opts.forEach((o) => (o.hidden = o.dataset.heroOpt !== v));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
    };
    const start = params.get('h');
    if (start && [...opts].some((o) => o.dataset.heroOpt === start)) show(start);
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        show(b.dataset.v!);
        const p = new URLSearchParams(location.search);
        p.set('h', b.dataset.v!);
        history.replaceState(null, '', `?${p.toString()}${location.hash}`);
      }),
    );
  }
</script>
