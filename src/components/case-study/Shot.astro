---
/**
 * A case-study image. The site is light only (27 Nov), so a night version, if any, is never shown.
 */
import type { Shot } from '../../data/case-studies';

interface Props {
  shot: Shot;
  alt: string;
  wide?: boolean;
  eager?: boolean;
}

const { shot, alt, wide = false, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---

<div class:list={['shot', { 'shot--wide': wide, 'shot--themed': !!shot.dark }]}>
  <img
    class="shot-light img-outline"
    src={shot.light}
    alt={alt}
    width={shot.width}
    height={shot.height}
    loading={loading}
    decoding="async"
  />
  {
    shot.dark && (
      <img
        class="shot-dark img-outline"
        src={shot.dark}
        alt={alt}
        width={shot.width}
        height={shot.height}
        loading={loading}
        decoding="async"
      />
    )
  }
</div>

<style>
  .shot {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot--themed .shot-dark {
    display: none;
  }
</style>
