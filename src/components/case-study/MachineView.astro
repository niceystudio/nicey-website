---
/**
 * Machine view of a case study (idea from parallel.ai, applied to the whole page).
 * The switch lives in the footer tool strip (SiteFooter, [data-mv] buttons, key m).
 * Machine hides the designed page and shows the plain Markdown an agent reads,
 * the same text that is served at /work/<slug>.md. State lives in ?view=machine.
 */
interface Props {
  markdown: string;
  mdHref: string;
}
const { markdown, mdHref } = Astro.props;
const words = markdown.split(/\s+/).filter(Boolean).length;
const lines = markdown.split('\n');
const kind = (l: string, i: number, fmEnd: number) =>
  i <= fmEnd ? 'fm' : /^#{1,2} /.test(l) ? 'h' : l.startsWith('> ') ? 'q' : l.startsWith('|') ? 't' : /^(- |\d+\. )/.test(l) ? 'li' : '';
const fmEnd = lines.indexOf('---', 1);
---

<section class="mv" data-mv-page hidden aria-label="This case study as an agent reads it">
  <div class="container-page mv-in">
    <div class="mv-head">
      <span class="mv-get"><b>GET</b> {mdHref}</span>
      <span class="mv-meta">200 · text/markdown · {words.toLocaleString('en')} words</span>
      <span class="mv-actions">
        <button type="button" class="mv-btn" data-mv-copy>Copy</button>
        <a class="mv-btn" href={mdHref}>Open .md</a>
        <button type="button" class="mv-btn mv-btn--ink" data-mv="human">← Human view</button>
      </span>
    </div>
    <p class="mv-lead">
      This is the same case study, as an agent reads it: no layout, no images, only text with structure. We build design
      systems so they read this way too.
    </p>
    <pre class="mv-doc" data-mv-doc><code>{lines.map((l, i) => <span class:list={['mv-l', kind(l, i, fmEnd) && `mv-${kind(l, i, fmEnd)}`]} style={`--i:${Math.min(i, 40)}`}>{l || ' '}{'\n'}</span>)}</code></pre>
    <textarea class="sr-only" data-mv-src aria-hidden="true" tabindex="-1">{markdown}</textarea>
  </div>
</section>

<style>
  .mv[hidden] {
    display: none;
  }
  .mv-in {
    padding-block: 24px 72px;
  }
  .mv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    padding: 14px 18px;
    border: 1px solid var(--color-line-strong);
    border-bottom: 0;
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }
  .mv-get b {
    color: var(--color-accent);
    font-weight: 600;
  }
  .mv-meta {
    color: var(--color-ink-2);
  }
  .mv-actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }
  .mv-btn {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .mv-btn--ink {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-on-ink);
  }
  .mv-lead {
    margin: 0;
    padding: 14px 18px;
    border: 1px solid var(--color-line-strong);
    border-bottom: 0;
    font-size: var(--text-body-sm);
    color: var(--color-ink-2);
  }
  .mv-doc {
    margin: 0;
    padding: 24px 18px 32px;
    border: 1px solid var(--color-line-strong);
    border-radius: 0 0 var(--radius-panel) var(--radius-panel);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .mv-l {
    display: inline;
  }
  .mv-fm {
    color: var(--color-ink-2);
  }
  .mv-h {
    font-weight: 600;
    color: var(--color-accent);
  }
  .mv-q {
    color: var(--color-ink-2);
  }
  .mv-t {
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mv:not([hidden]) .mv-l {
      animation: mv-in 240ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 10ms);
    }
    @keyframes mv-in {
      from {
        opacity: 0;
      }
    }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('[data-mv-page]');
  const human = document.querySelectorAll<HTMLElement>('[data-human]');
  if (page) {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-mv]');
    let view = 'human';
    const set = (v: string, push = true) => {
      view = v;
      const machine = v === 'machine';
      page.hidden = !machine;
      human.forEach((h) => (h.hidden = machine));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mv === v)));
      if (push) {
        const p = new URLSearchParams(location.search);
        if (machine) p.set('view', 'machine');
        else p.delete('view');
        const q = p.toString();
        history.replaceState(null, '', `${location.pathname}${q ? `?${q}` : ''}`);
        window.scrollTo({ top: 0 });
      }
    };
    buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.mv!)));
    if (new URLSearchParams(location.search).get('view') === 'machine') set('machine', false);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'm' || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, select, [contenteditable]')) return;
      set(view === 'machine' ? 'human' : 'machine');
    });

    const copy = page.querySelector<HTMLButtonElement>('[data-mv-copy]');
    const src = page.querySelector<HTMLTextAreaElement>('[data-mv-src]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(src?.value ?? '');
        copy.textContent = 'Copied';
      } catch {
        copy.textContent = 'Copy failed';
      }
      setTimeout(() => (copy.textContent = 'Copy'), 1600);
    });
  }
</script>
