---
/**
 * The case study told slide by slide: each slide of the Figma
 * "Case Study Documentation" file becomes one panel here, as real text
 * (readable by search engines and screen readers, themed day and night).
 */
import type { Chapter } from '../../data/case-studies';
import SectionHead from '../SectionHead.astro';

interface Props {
  chapters: Chapter[];
  /** marker colour class, e.g. 'bg-lavender' */
  marker: string;
  /** homepage-style opener; without it the section keeps its small caption */
  head?: { caption: string; heading: string };
  /** 'scroll': the homepage Zero Drift layout, a sticky rail on the left and every step stacked on the right */
  layout?: 'tabs' | 'scroll';
}
const { chapters, marker, head, layout: mode = 'tabs' } = Astro.props;
const scroll = mode === 'scroll';

// 02 · Model: place each status in a column by its distance from the first one
function layout(edges: { from: string; to: string }[]) {
  const depth = new Map<string, number>();
  depth.set(edges[0].from, 0);
  for (let k = 0; k < edges.length; k++)
    for (const e of edges) if (depth.has(e.from) && !depth.has(e.to)) depth.set(e.to, depth.get(e.from)! + 1);
  const cols = new Map<number, string[]>();
  depth.forEach((d, n) => cols.set(d, [...(cols.get(d) ?? []), n]));
  const W = 560, H = 200, maxD = Math.max(...depth.values());
  const pos = new Map<string, { x: number; y: number }>();
  cols.forEach((names, d) =>
    names.forEach((n, i) => pos.set(n, { x: 70 + (d * (W - 140)) / Math.max(1, maxD), y: (H * (i + 1)) / (names.length + 1) })),
  );
  return { pos, W, H };
}
const slug = (k: string) =>
  'ch-' +
  k
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<section aria-labelledby="chapters-head" class:list={['container-page ch-wrap', scroll && 'ch-wrap--scroll']}>
  {scroll ? (
    <div class="ch-rail">
      <span class="caption text-ink-2">{head?.caption ?? 'What we did'}</span>
      <h2 id="chapters-head" class="m-0 text-h2 text-balance">{head?.heading ?? 'What we did, step by step'}</h2>
      <ol class="ch-rail-list">
        {chapters.map((c) => {
          const [num, ...rest] = c.kicker.split(' · ');
          return (
            <li>
              <a href={`#panel-${slug(c.kicker)}`} data-rail={`panel-${slug(c.kicker)}`}>
                <i aria-hidden="true" class:list={['marker', marker]} />
                <span class="font-mono text-caption text-ink-2">{num}</span>
                {rest.join(' · ')}
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  ) : head ? (
    <SectionHead id="chapters-head" caption={head.caption} class="mb-6" headingClass="max-w-[18ch]">{head.heading}</SectionHead>
  ) : (
    <h2 id="chapters-head" class="caption m-0 text-ink-2">What we did, step by step</h2>
  )}
  <div class:list={['panel chs', scroll && 'chs--scroll']} data-chapters data-layout={mode}>
    {!scroll && <div class="chs-tabs" role="tablist" aria-label="Steps of the work">
      {
        chapters.map((c, i) => {
          const [num, ...rest] = c.kicker.split(' · ');
          return (
            <button
              type="button"
              role="tab"
              id={`tab-${slug(c.kicker)}`}
              aria-controls={`panel-${slug(c.kicker)}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="chs-tab"
            >
              <span class="flex items-center gap-2 font-mono text-caption text-ink-2">
                <i aria-hidden="true" class:list={['marker', marker]} />
                {num}
              </span>
              <span class="chs-tab-name">{rest.join(' · ')}</span>
            </button>
          );
        })
      }
    </div>}
  {
    chapters.map((c, i) => {
      const id = slug(c.kicker);
      const twoCol = c.blocks.length === 2;
      return (
        <div
          id={`panel-${id}`}
          role={scroll ? undefined : 'tabpanel'}
          aria-labelledby={scroll ? id : `tab-${id}`}
          tabindex={scroll ? undefined : '0'}
          hidden={!scroll && i !== 0}
          class="ch"
        >
          <header class="ch-head">
            <span class="caption flex items-center gap-2 text-ink-2">
              <i aria-hidden="true" class:list={['marker', marker]} />
              {c.kicker}
            </span>
            <h3 id={id} class="m-0 max-w-[30ch] text-case-h2 text-balance">
              {c.heading}
            </h3>
            <p class="m-0 max-w-[64ch] text-lede text-pretty text-ink-2">{c.lede}</p>
          </header>

          <div class:list={['ch-body', twoCol && 'ch-body--two']}>
            {c.blocks.map((b) => (
              <div class="ch-block">
                {b.kind === 'stats' && (
                  <ul class="ch-stats">
                    {b.items.map((it) => (
                      <li>
                        <span class="caption-sm text-ink-2">{it.label}</span>
                        <span class="ch-fig">{it.value}</span>
                        {it.seenAt && <span class="caption-sm text-hot">{it.seenAt}</span>}
                        <span class="text-body text-pretty">{it.caption}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {b.kind === 'rows' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <dl class="ch-rows">
                      {b.rows.map((r) => (
                        <div>
                          <dt class="text-body-lg">{r.label}</dt>
                          <dd class="m-0 text-body tabular-nums text-ink-2">{r.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </>
                )}

                {b.kind === 'map' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ul class="ch-map">
                      {b.rows.map((r) => (
                        <li>
                          <code class="ch-code">{r.from}</code>
                          <span aria-hidden="true" class="text-ink-2">
                            →
                          </span>
                          <span class="sr-only">maps to</span>
                          <code class="ch-code ch-code--accent">{r.to}</code>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {b.kind === 'ramp' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ol class="ch-ramp">
                      {b.swatches.map((w) => (
                        <li class:list={[w.feeds && 'ch-ramp--feeds']} data-step={w.step}>
                          <span aria-hidden="true" class="ch-swatch" style={`background:#${w.hex}`} />
                          <span class="text-body-sm tabular-nums">{w.step}</span>
                          <span class="caption-sm text-ink-2">{w.hex}</span>
                        </li>
                      ))}
                    </ol>
                    <p class="m-0 text-body text-ink-2">{b.note}</p>
                  </>
                )}

                {b.kind === 'chain' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ul class="ch-chain">
                      {b.links.map((l) => (
                        <li data-from={l.from.split('/').pop()}>
                          <code class="ch-code">{l.from}</code>
                          <span class="flex items-baseline gap-2">
                            <span aria-hidden="true" class="text-ink-2">
                              ↳
                            </span>
                            <code class="ch-code ch-code--accent">{l.token}</code>
                          </span>
                          <span class="caption-sm text-ink-2">{l.state}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {b.kind === 'docs' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ul class="ch-docs">
                      {b.items.map((d) => (
                        <li>
                          <span class="text-h3-card">{d.name}</span>
                          <div class="flex flex-col gap-1.5">
                            <span class="text-body">{d.purpose}</span>
                            <span class="text-body-sm">
                              <span class="caption-sm text-ink-2">Use for</span> {d.useFor}
                            </span>
                            <span class="text-body-sm">
                              <span class="caption-sm text-ink-2">Not for</span> {d.notFor}{' '}
                              <code class="ch-code ch-code--hot">{d.instead}</code>
                            </span>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {b.kind === 'flow' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ol class="ch-run">
                      {b.steps.map((st, k) => (
                        <li style={`--i:${k}`}>
                          <span class="ch-run-mark" aria-hidden="true">
                            {k === b.steps.length - 1 ? '→' : '✓'}
                          </span>
                          <span class="ch-run-body">
                            <span class="ch-run-name">
                              <span class="ch-run-n">{st.n}</span> {st.name}
                            </span>
                            <span class="ch-run-text">{st.text}</span>
                          </span>
                        </li>
                      ))}
                      <li class="ch-run-cursor" style={`--i:${b.steps.length}`} aria-hidden="true">
                        <span class="ch-run-mark">_</span>
                      </li>
                    </ol>
                  </>
                )}

                {b.kind === 'checks' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <div class="ch-checks">
                      <p class="m-0 flex flex-wrap items-center justify-between gap-2">
                        <span class="text-body-lg">{b.subject}</span>
                        <span class="ch-pass caption-sm">{b.status}</span>
                      </p>
                      <ul>
                        {b.items.map((it) => (
                          <li>
                            <span class="ch-fig-sm">{it.value}</span>
                            <span class="text-body">{it.label}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                )}

                {b.kind === 'surfaces' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ul class="ch-surf">
                      {b.items.map((it, k) => (
                        <li style={`--i:${k}`}>
                          <span class="ch-surf-n font-mono text-caption text-ink-2">{String(k + 1).padStart(2, '0')}</span>
                          <span class="text-body-lg">{it.name}</span>
                          <span class="ch-surf-how caption-sm">{it.how}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {b.kind === 'graph' && (() => {
                  const g = layout(b.edges);
                  return (
                    <div class="ch-graph" data-graph>
                      <div class="flex flex-col gap-3">
                        <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                        <svg viewBox={`0 0 ${g.W} ${g.H}`} class="ch-graph-svg" aria-hidden="true">
                          {b.edges.map((e, k) => {
                            const a = g.pos.get(e.from)!, z = g.pos.get(e.to)!;
                            return <path data-edge={k} class:list={[k === b.edges.length - 2 && 'is-on']} d={`M${a.x + 58} ${a.y} C ${a.x + 120} ${a.y}, ${z.x - 120} ${z.y}, ${z.x - 58} ${z.y}`} />;
                          })}
                          {[...g.pos].map(([n, p]) => (
                            <g>
                              <rect x={p.x - 58} y={p.y - 16} width="116" height="32" rx="16" />
                              <text x={p.x} y={p.y + 4} text-anchor="middle">{n}</text>
                            </g>
                          ))}
                        </svg>
                      </div>
                      <div class="flex flex-col gap-2">
                        <p class="caption-sm m-0 text-ink-2">Pick a move</p>
                        <div role="group" aria-label="Pick a move" class="ch-pick">
                          {b.edges.map((e, k) => (
                            <button type="button" class="press" data-edge-pick={k} data-rules={e.rules.join('|')} aria-pressed={k === b.edges.length - 2 ? 'true' : 'false'}>
                              {e.from} → {e.to}
                            </button>
                          ))}
                        </div>
                        <p class="caption-sm m-0 mt-3 text-ink-2">Rules on this move</p>
                        <ul class="ch-chips" data-graph-rules aria-live="polite">
                          {b.edges[b.edges.length - 2].rules.map((r) => <li>{r}</li>)}
                        </ul>
                      </div>
                    </div>
                  );
                })()}

                {b.kind === 'order' && (
                  <div class="ch-order">
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ol class="ch-order-list">
                      {b.steps.map((st, k) => (
                        <li style={`--i:${k}`}>
                          <span class="ch-order-n" aria-hidden="true">{k + 1}</span>
                          <span class="flex flex-col gap-1">
                            <span class="text-body-lg">{st.name}</span>
                            <span class="text-body-sm text-ink-2">{st.text}</span>
                          </span>
                        </li>
                      ))}
                    </ol>
                  </div>
                )}

                {b.kind === 'everywhere' && (
                  <div class="ch-every" data-every>
                    <div class="flex flex-col gap-2">
                      <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                      <div role="group" aria-label="Pick where the change starts" class="ch-pick">
                        {b.surfaces.map((sf, k) => (
                          <button type="button" class="press" data-every-pick={k} data-note={sf.note} aria-pressed={k === 0 ? 'true' : 'false'}>
                            {sf.name}
                          </button>
                        ))}
                      </div>
                      <p class="m-0 mt-2 text-body text-ink-2" data-every-note aria-live="polite">{b.surfaces[0].note}</p>
                    </div>
                    <div class="ch-modal" data-every-modal aria-hidden="true">
                      <span class="ch-modal-t">Complete required actions</span>
                      <span class="ch-modal-move"><b>In progress</b> → <b>Completed</b></span>
                      <span class="ch-modal-steps"><i class="is-on">1 · Required fields</i><i>2 · Signature</i></span>
                      <span class="ch-modal-body"><span>Turnaround *</span><span>Assigned technician *</span></span>
                      <span class="ch-modal-btn">Next</span>
                    </div>
                  </div>
                )}

                {b.kind === 'bulk' && (
                  <div class="ch-bulk" data-bulk>
                    <div class="flex flex-col gap-2">
                      <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                      <div role="group" aria-label="Pick an outcome" class="ch-pick">
                        {b.outcomes.map((o, k) => (
                          <button type="button" class="press" data-bulk-pick={k} aria-pressed={k === 1 ? 'true' : 'false'}>
                            {o.label}
                          </button>
                        ))}
                      </div>
                    </div>
                    <div class="ch-bulk-stage">
                      {b.outcomes.map((o, k) => (
                        <div class="ch-modal ch-modal--bulk" data-bulk-card={k} hidden={k !== 1}>
                          <span class="ch-bars" data-o={k} aria-hidden="true"><i /><i /></span>
                          <span class="ch-modal-t">{o.title}</span>
                          <span class="text-body-sm">{o.text}</span>
                          <span class="ch-modal-btn">{o.cta}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {b.kind === 'audit' && (
                  <div class="ch-audit" data-audit>
                    <div class="ch-audit-head">
                      <span class="caption-sm text-ink-2">{b.title}</span>
                      <span class="ch-audit-count font-mono text-caption">
                        Scanning <b data-count={b.layers}>{b.layers.toLocaleString('en')}</b> variants
                      </span>
                    </div>
                    <dl class="ch-meters ch-meters--scan">
                      {b.items.map((m, k) => (
                        <div style={`--i:${k}`}>
                          <dt class="text-body">{m.label}</dt>
                          <dd class="m-0 text-body tabular-nums">{m.value}</dd>
                          <span aria-hidden="true" class="ch-meter">
                            <span style={`width:${parseFloat(m.value)}%`} />
                          </span>
                        </div>
                      ))}
                    </dl>
                  </div>
                )}

                {b.kind === 'meters' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <dl class="ch-meters">
                      {b.items.map((m) => (
                        <div>
                          <dt class="text-body">{m.label}</dt>
                          <dd class="m-0 text-body tabular-nums">{m.value}</dd>
                          <span aria-hidden="true" class="ch-meter">
                            <span style={`width:${parseFloat(m.value)}%`} />
                          </span>
                        </div>
                      ))}
                    </dl>
                  </>
                )}

                {b.kind === 'states' && (
                  <div class="ch-live" data-live>
                    <div class="ch-live-demo" data-live-demo data-state="0" aria-hidden="true">
                      <span class="ch-live-label">Batch ID</span>
                      <span class="ch-live-field">BT-2026-0412</span>
                      <span class="ch-live-err">Batch ID already exists</span>
                      <span class="ch-live-btn">Create CAPA</span>
                    </div>
                    <div class="flex flex-col gap-2">
                      <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                      <div role="group" aria-label="Pick a state" class="ch-live-list">
                        {b.rows.map((r, k) => (
                          <button type="button" class="press" data-live-pick={k} aria-pressed={k === 0 ? 'true' : 'false'}>
                            <span class="text-body">{r.state}</span>
                            <code class="ch-code ch-code--accent">{r.token}</code>
                          </button>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                {b.kind === 'compare' && (
                  <table class="ch-table ch-compare">
                    <thead>
                      <tr>
                        <th scope="col" class="caption-sm">
                          <span class="sr-only">Measure</span>
                        </th>
                        <th scope="col" class="caption-sm">
                          Before
                        </th>
                        <th scope="col" class="caption-sm">
                          After
                        </th>
                        <th scope="col" class="caption-sm">
                          <span class="sr-only">What it counts</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {b.rows.map((r) => (
                        <tr>
                          <th scope="row" class="text-body-lg font-normal">
                            {r.label}
                          </th>
                          <td class="ch-before tabular-nums">{r.before}</td>
                          <td class="ch-after tabular-nums">{r.after}</td>
                          <td class="text-body text-ink-2">{r.note}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}

                {b.kind === 'images' && (
                  <div class="ch-images">
                    {b.images.map((im) => (
                      <img src={im.src} alt={im.alt} width={im.width} height={im.height} loading="lazy" decoding="async" />
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>

          {c.proof && (
            <ul class="ch-proof" data-stagger>
              {/* "Seen at …" once, as the row's label; every column is then just number + caption */}
              {c.proof.find((p) => p.seenAt) && (
                <li class="ch-proof-label caption-sm text-hot">{c.proof.find((p) => p.seenAt)!.seenAt}</li>
              )}
              {c.proof.map((p) => (
                <li class="ch-proof-item">
                  <span class="ch-fig">{p.value}</span>
                  <span class="max-w-[36ch] text-body text-pretty">{p.caption}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      );
    })
  }
    {!scroll && <div class="chs-controls">
      <button type="button" class="chs-btn" data-prev aria-disabled="true" aria-label="Previous step"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9H4M8 4.5 3.5 9 8 13.5" /></svg></button>
      <button type="button" class="chs-btn chs-btn--next" data-next aria-label="Next step"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 4.5 14.5 9 10 13.5" /></svg></button>
    </div>}
  </div>
</section>

<script>
  function mountChapters(root: HTMLElement) {
    const isScroll = root.dataset.layout === 'scroll';
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? ''));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;

    function select(i: number, focus: boolean) {
      const n = Math.max(0, Math.min(tabs.length - 1, i));
      if (n !== current) {
        tabs.forEach((t, k) => {
          t.setAttribute('aria-selected', String(k === n));
          t.tabIndex = k === n ? 0 : -1;
        });
        panels.forEach((p, k) => {
          if (p) p.hidden = k !== n;
        });
        const panel = panels[n];
        if (panel && !reduced.matches) {
          panel.classList.add('is-entering');
          void panel.offsetWidth;
          panel.classList.remove('is-entering');
        }
        current = n;
      }
      tabs[n].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduced.matches ? 'auto' : 'smooth' });
      if (focus) tabs[n].focus();
      prev?.setAttribute('aria-disabled', String(n === 0));
      next?.setAttribute('aria-disabled', String(n === tabs.length - 1));
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, false));
      t.addEventListener('keydown', (e) => {
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') to = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = tabs.length - 1;
        if (to < 0) return;
        e.preventDefault();
        select(to, true);
      });
    });
    const fromHash = tabs.findIndex((t) => `#${t.id}` === location.hash);
    if (fromHash > 0) select(fromHash, false);

    // scroll layout: every step is open; the rail marks the one being read
    if (isScroll) {
      const links = document.querySelectorAll<HTMLAnchorElement>('[data-rail]');
      const steps = Array.from(root.querySelectorAll<HTMLElement>('.ch'));
      const mark = (id: string) => links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.rail === id));
      const spy = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && mark((e.target as HTMLElement).id)),
        { rootMargin: '-40% 0px -55% 0px' },
      );
      steps.forEach((st) => spy.observe(st));
      if (steps[0]) mark(steps[0].id);
    }

    prev?.addEventListener('click', () => {
      if (prev.getAttribute('aria-disabled') !== 'true') select(current - 1, false);
    });
    next?.addEventListener('click', () => {
      if (next.getAttribute('aria-disabled') !== 'true') select(current + 1, false);
    });

    // 03 · ramp → chain: pointing at a step lights the button state it feeds
    root.querySelectorAll<HTMLElement>('.ch').forEach((panel) => {
      const chain = panel.querySelectorAll<HTMLElement>('[data-from]');
      if (!chain.length) return;
      panel.querySelectorAll<HTMLElement>('[data-step]').forEach((sw) => {
        sw.tabIndex = 0;
        const on = () => {
          panel.querySelectorAll('[data-step]').forEach((x) => x.classList.toggle('is-on', x === sw));
          chain.forEach((c) => c.classList.toggle('is-lit', c.dataset.from === sw.dataset.step));
        };
        sw.addEventListener('mouseenter', on);
        sw.addEventListener('focus', on);
      });
    });

    // 04 · states: pick a row, the demo shows it
    root.querySelectorAll<HTMLElement>('[data-live]').forEach((live) => {
      const demo = live.querySelector<HTMLElement>('[data-live-demo]');
      const picks = live.querySelectorAll<HTMLButtonElement>('[data-live-pick]');
      picks.forEach((b) =>
        b.addEventListener('click', () => {
          picks.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          if (demo) demo.dataset.state = b.dataset.livePick!;
        }),
      );
    });

    // status · 02 graph: pick a move, its path lights and its rules show
    root.querySelectorAll<HTMLElement>('[data-graph]').forEach((g) => {
      const picks = g.querySelectorAll<HTMLButtonElement>('[data-edge-pick]');
      const paths = g.querySelectorAll<SVGPathElement>('[data-edge]');
      const list = g.querySelector<HTMLElement>('[data-graph-rules]');
      picks.forEach((b) =>
        b.addEventListener('click', () => {
          picks.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          paths.forEach((p) => p.classList.toggle('is-on', p.dataset.edge === b.dataset.edgePick));
          if (list) list.innerHTML = (b.dataset.rules ?? '').split('|').map((r) => `<li>${r}</li>`).join('');
        }),
      );
    });

    // status · 04 everywhere: another surface, the same modal opens again
    root.querySelectorAll<HTMLElement>('[data-every]').forEach((d) => {
      const picks = d.querySelectorAll<HTMLButtonElement>('[data-every-pick]');
      const note = d.querySelector<HTMLElement>('[data-every-note]');
      const modal = d.querySelector<HTMLElement>('[data-every-modal]');
      picks.forEach((b) =>
        b.addEventListener('click', () => {
          picks.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          if (note) note.textContent = b.dataset.note ?? '';
          if (modal && !reduced.matches) {
            modal.classList.remove('is-open');
            void modal.offsetWidth;
            modal.classList.add('is-open');
          }
        }),
      );
    });

    // status · 05 bulk: pick an outcome, its modal shows
    root.querySelectorAll<HTMLElement>('[data-bulk]').forEach((d) => {
      const picks = d.querySelectorAll<HTMLButtonElement>('[data-bulk-pick]');
      const cards = d.querySelectorAll<HTMLElement>('[data-bulk-card]');
      picks.forEach((b) =>
        b.addEventListener('click', () => {
          picks.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          cards.forEach((c) => (c.hidden = c.dataset.bulkCard !== b.dataset.bulkPick));
        }),
      );
    });

    // 01 · audit: count the components up when the panel opens
    const countUp = (panel: HTMLElement | null) => {
      const el = panel?.querySelector<HTMLElement>('[data-count]');
      if (!el || reduced.matches) return;
      const to = Number(el.dataset.count);
      const t0 = performance.now();
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / 1200);
        el.textContent = Math.round(to * (1 - Math.pow(1 - k, 3))).toLocaleString('en');
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    tabs.forEach((t, i) => t.addEventListener('click', () => countUp(panels[i])));
    if (isScroll) {
      root.querySelectorAll<HTMLElement>('.ch').forEach((panel) => {
        const once = new IntersectionObserver((es) => {
          if (es.some((e) => e.isIntersecting)) {
            countUp(panel);
            once.disconnect();
          }
        });
        once.observe(panel);
      });
    }
    next?.addEventListener('click', () => countUp(panels[current]));
    prev?.addEventListener('click', () => countUp(panels[current]));
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) {
        countUp(panels[current]);
        io.disconnect();
      }
    });
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-chapters]').forEach(mountChapters);
</script>

