---
/**
 * The case study told slide by slide: each slide of the Figma
 * "Case Study Documentation" file becomes one panel here, as real text
 * (readable by search engines and screen readers, themed day and night).
 */
import type { Chapter } from '../../data/case-studies';

interface Props {
  chapters: Chapter[];
  /** marker colour class, e.g. 'bg-lavender' */
  marker: string;
}
const { chapters, marker } = Astro.props;
const slug = (k: string) =>
  'ch-' +
  k
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<section aria-labelledby="chapters-head" class="container-page ch-wrap">
  <h2 id="chapters-head" class="caption m-0 text-ink-2">The work, step by step</h2>
  <div class="panel chs" data-chapters>
    <div class="chs-tabs" role="tablist" aria-label="Steps of the work">
      {
        chapters.map((c, i) => {
          const [num, ...rest] = c.kicker.split(' · ');
          return (
            <button
              type="button"
              role="tab"
              id={`tab-${slug(c.kicker)}`}
              aria-controls={`panel-${slug(c.kicker)}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="chs-tab"
            >
              <span class="flex items-center gap-2 font-mono text-caption text-ink-2">
                <i aria-hidden="true" class:list={['marker', marker]} />
                {num}
              </span>
              <span class="chs-tab-name">{rest.join(' · ')}</span>
            </button>
          );
        })
      }
    </div>
  {
    chapters.map((c, i) => {
      const id = slug(c.kicker);
      const twoCol = c.blocks.length === 2;
      return (
        <div
          id={`panel-${id}`}
          role="tabpanel"
          aria-labelledby={`tab-${id}`}
          tabindex="0"
          hidden={i !== 0}
          class="ch"
        >
          <header class="ch-head">
            <span class="caption flex items-center gap-2 text-ink-2">
              <i aria-hidden="true" class:list={['marker', marker]} />
              {c.kicker}
            </span>
            <h3 id={id} class="m-0 max-w-[30ch] text-case-h2 text-balance">
              {c.heading}
            </h3>
            <p class="m-0 max-w-[64ch] text-lede text-pretty text-ink-2">{c.lede}</p>
          </header>

          <div class:list={['ch-body', twoCol && 'ch-body--two']}>
            {c.blocks.map((b) => (
              <div class="ch-block">
                {b.kind === 'stats' && (
                  <ul class="ch-stats">
                    {b.items.map((it) => (
                      <li>
                        <span class="caption-sm text-ink-2">{it.label}</span>
                        <span class="ch-fig">{it.value}</span>
                        {it.seenAt && <span class="caption-sm text-hot">{it.seenAt}</span>}
                        <span class="text-body text-pretty">{it.caption}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {b.kind === 'rows' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <dl class="ch-rows">
                      {b.rows.map((r) => (
                        <div>
                          <dt class="text-body-lg">{r.label}</dt>
                          <dd class="m-0 text-body tabular-nums text-ink-2">{r.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </>
                )}

                {b.kind === 'map' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ul class="ch-map">
                      {b.rows.map((r) => (
                        <li>
                          <code class="ch-code">{r.from}</code>
                          <span aria-hidden="true" class="text-ink-2">
                            →
                          </span>
                          <span class="sr-only">maps to</span>
                          <code class="ch-code ch-code--accent">{r.to}</code>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {b.kind === 'ramp' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ol class="ch-ramp">
                      {b.swatches.map((w) => (
                        <li class:list={[w.feeds && 'ch-ramp--feeds']}>
                          <span aria-hidden="true" class="ch-swatch" style={`background:#${w.hex}`} />
                          <span class="text-body-sm tabular-nums">{w.step}</span>
                          <span class="caption-sm text-ink-2">{w.hex}</span>
                        </li>
                      ))}
                    </ol>
                    <p class="m-0 text-body text-ink-2">{b.note}</p>
                  </>
                )}

                {b.kind === 'chain' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ul class="ch-chain">
                      {b.links.map((l) => (
                        <li>
                          <code class="ch-code">{l.from}</code>
                          <span class="flex items-baseline gap-2">
                            <span aria-hidden="true" class="text-ink-2">
                              ↳
                            </span>
                            <code class="ch-code ch-code--accent">{l.token}</code>
                          </span>
                          <span class="caption-sm text-ink-2">{l.state}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {b.kind === 'docs' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ul class="ch-docs">
                      {b.items.map((d) => (
                        <li>
                          <span class="text-h3-card">{d.name}</span>
                          <div class="flex flex-col gap-1.5">
                            <span class="text-body">{d.purpose}</span>
                            <span class="text-body-sm">
                              <span class="caption-sm text-ink-2">Use for</span> {d.useFor}
                            </span>
                            <span class="text-body-sm">
                              <span class="caption-sm text-ink-2">Not for</span> {d.notFor}{' '}
                              <code class="ch-code ch-code--hot">{d.instead}</code>
                            </span>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                {b.kind === 'flow' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <ol class="ch-flow">
                      {b.steps.map((st) => (
                        <li>
                          <span class="caption-sm text-ink-2">{st.n}</span>
                          <span class="text-body-lg">{st.name}</span>
                          <span class="text-body text-ink-2">{st.text}</span>
                        </li>
                      ))}
                    </ol>
                  </>
                )}

                {b.kind === 'checks' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <div class="ch-checks">
                      <p class="m-0 flex flex-wrap items-center justify-between gap-2">
                        <span class="text-body-lg">{b.subject}</span>
                        <span class="ch-pass caption-sm">{b.status}</span>
                      </p>
                      <ul>
                        {b.items.map((it) => (
                          <li>
                            <span class="ch-fig-sm">{it.value}</span>
                            <span class="text-body">{it.label}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </>
                )}

                {b.kind === 'meters' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <dl class="ch-meters">
                      {b.items.map((m) => (
                        <div>
                          <dt class="text-body">{m.label}</dt>
                          <dd class="m-0 text-body tabular-nums">{m.value}</dd>
                          <span aria-hidden="true" class="ch-meter">
                            <span style={`width:${parseFloat(m.value)}%`} />
                          </span>
                        </div>
                      ))}
                    </dl>
                  </>
                )}

                {b.kind === 'states' && (
                  <>
                    <p class="caption-sm m-0 text-ink-2">{b.title}</p>
                    <table class="ch-table ch-states">
                      <thead>
                        <tr>
                          <th scope="col" class="caption-sm">
                            State
                          </th>
                          <th scope="col" class="caption-sm">
                            Token
                          </th>
                          <th scope="col" class="caption-sm">
                            Example
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {b.rows.map((r) => (
                          <tr>
                            <th scope="row" class="text-body-lg font-normal">
                              {r.state}
                            </th>
                            <td>
                              <code class="ch-code">{r.token}</code>
                            </td>
                            <td class="text-body text-ink-2">{r.example}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </>
                )}

                {b.kind === 'compare' && (
                  <table class="ch-table ch-compare">
                    <thead>
                      <tr>
                        <th scope="col" class="caption-sm">
                          <span class="sr-only">Measure</span>
                        </th>
                        <th scope="col" class="caption-sm">
                          Before
                        </th>
                        <th scope="col" class="caption-sm">
                          After
                        </th>
                        <th scope="col" class="caption-sm">
                          <span class="sr-only">What it counts</span>
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {b.rows.map((r) => (
                        <tr>
                          <th scope="row" class="text-body-lg font-normal">
                            {r.label}
                          </th>
                          <td class="ch-before tabular-nums">{r.before}</td>
                          <td class="ch-after tabular-nums">{r.after}</td>
                          <td class="text-body text-ink-2">{r.note}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}

                {b.kind === 'images' && (
                  <div class="ch-images">
                    {b.images.map((im) => (
                      <img src={im.src} alt={im.alt} width={im.width} height={im.height} loading="lazy" decoding="async" />
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>

          {c.proof && (
            <ul class="ch-proof">
              {c.proof.map((p) => (
                <li>
                  <span class="ch-fig">{p.value}</span>
                  <span class="flex flex-col gap-1">
                    {p.seenAt && <span class="caption-sm text-hot">{p.seenAt}</span>}
                    <span class="text-body text-pretty">{p.caption}</span>
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      );
    })
  }
    <div class="chs-controls">
      <button type="button" class="pill pill-outline chs-btn" data-prev aria-disabled="true">Previous</button>
      <button type="button" class="pill pill-ink chs-btn chs-btn--next" data-next>Next step</button>
    </div>
  </div>
</section>

<script>
  function mountChapters(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? ''));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;

    function select(i: number, focus: boolean) {
      const n = Math.max(0, Math.min(tabs.length - 1, i));
      if (n !== current) {
        tabs.forEach((t, k) => {
          t.setAttribute('aria-selected', String(k === n));
          t.tabIndex = k === n ? 0 : -1;
        });
        panels.forEach((p, k) => {
          if (p) p.hidden = k !== n;
        });
        const panel = panels[n];
        if (panel && !reduced.matches) {
          panel.classList.add('is-entering');
          void panel.offsetWidth;
          panel.classList.remove('is-entering');
        }
        current = n;
      }
      tabs[n].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduced.matches ? 'auto' : 'smooth' });
      if (focus) tabs[n].focus();
      prev?.setAttribute('aria-disabled', String(n === 0));
      next?.setAttribute('aria-disabled', String(n === tabs.length - 1));
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, false));
      t.addEventListener('keydown', (e) => {
        let to = -1;
        if (e.key === 'ArrowRight') to = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') to = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') to = 0;
        else if (e.key === 'End') to = tabs.length - 1;
        if (to < 0) return;
        e.preventDefault();
        select(to, true);
      });
    });
    prev?.addEventListener('click', () => {
      if (prev.getAttribute('aria-disabled') !== 'true') select(current - 1, false);
    });
    next?.addEventListener('click', () => {
      if (next.getAttribute('aria-disabled') !== 'true') select(current + 1, false);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-chapters]').forEach(mountChapters);
</script>

<style>
  .ch-wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 72px;
  }
  @media (max-width: 767px) {
    .ch-wrap {
      padding-top: 56px;
    }
  }
  @media (max-width: 479px) {
    .ch-wrap {
      padding-top: 48px;
    }
  }
  .chs {
    display: flex;
    flex-direction: column;
  }
  .chs-tabs {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .chs-tabs::-webkit-scrollbar {
    display: none;
  }
  .chs-tab {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-height: 44px;
    padding: 18px 20px 16px;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
    scroll-snap-align: start;
  }
  .chs-tab-name {
    font-size: var(--text-body-sm);
    line-height: 1.3;
  }
  .chs-tab::after {
    content: '';
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 0;
    height: 2px;
    background: transparent;
  }
  .chs-tab[aria-selected='true'] .chs-tab-name {
    font-weight: 500;
  }
  .chs-tab[aria-selected='true']::after {
    background: var(--color-ink);
  }
  @media (hover: hover) {
    .chs-tab[aria-selected='false']:hover {
      background: var(--color-surface-hover);
    }
  }
  @media (max-width: 899px) {
    .chs-tab {
      flex: 0 0 auto;
      min-width: 128px;
    }
  }
  .chs-tab:focus-visible,
  .ch:focus-visible {
    outline-offset: -4px;
  }
  .ch {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--color-line);
  }
  .ch[hidden] {
    display: none;
  }
  .ch > * {
    background: var(--color-surface);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ch {
      transition: opacity 220ms ease;
    }
  }
  .ch.is-entering {
    opacity: 0;
  }
  .chs-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 44px;
  }
  .chs-btn {
    padding: 0 18px;
    font-size: var(--text-body-sm);
    cursor: pointer;
  }
  .chs-btn--next {
    padding: 0 22px;
    border: 0;
  }
  .chs-btn.pill-outline {
    background: transparent;
  }
  .chs-btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: default;
  }
  .ch-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px 44px 32px;
  }
  .ch-body {
    display: grid;
    gap: 1px;
    background: var(--color-line);
  }
  .ch-body--two {
    grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr));
  }
  .ch-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 28px 44px 36px;
    background: var(--color-surface);
  }

  .ch-fig {
    font-size: min(var(--text-case-figure), 14cqi);
    line-height: var(--text-case-figure--line-height);
    letter-spacing: var(--text-case-figure--letter-spacing);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ch-fig-sm {
    font-size: var(--text-h3-card);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .ch-stats {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 28px 40px;
  }
  .ch-stats > li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    container-type: inline-size;
  }

  .ch-rows {
    margin: 0;
  }
  .ch-rows > div,
  .ch-meters > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .ch-map,
  .ch-chain,
  .ch-docs,
  .ch-flow,
  .ch-checks ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ch-map > li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .ch-code {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: var(--text-code--line-height);
    overflow-wrap: anywhere;
  }
  .ch-code--accent {
    color: var(--color-accent);
  }
  .ch-code--hot {
    color: var(--color-hot);
  }

  .ch-ramp {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(56px, 1fr));
    gap: 8px;
  }
  .ch-ramp > li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ch-swatch {
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius-swatch);
    border: 1px solid var(--color-line);
  }
  .ch-ramp--feeds .ch-swatch {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .ch-chain > li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .ch-docs > li {
    display: grid;
    grid-template-columns: minmax(120px, 0.6fr) minmax(0, 2fr);
    gap: 8px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line);
  }
  @media (max-width: 560px) {
    .ch-docs > li {
      grid-template-columns: 1fr;
    }
  }

  .ch-flow > li {
    display: grid;
    grid-template-columns: 32px minmax(110px, 0.7fr) minmax(0, 2fr);
    align-items: baseline;
    gap: 6px 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
  }
  @media (max-width: 560px) {
    .ch-flow > li {
      grid-template-columns: 32px 1fr;
    }
    .ch-flow > li > :last-child {
      grid-column: 2;
    }
  }

  .ch-checks {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-code);
  }
  .ch-checks li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 8px 0;
    border-top: 1px solid var(--color-line);
  }
  .ch-pass {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-sage);
    color: var(--color-ink);
  }

  .ch-meters {
    margin: 0;
  }
  .ch-meters > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    row-gap: 8px;
  }
  .ch-meter {
    grid-column: 1 / -1;
    display: block;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--color-cell-quiet);
    overflow: hidden;
  }
  .ch-meter > span {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }

  .ch-table {
    width: 100%;
    border-collapse: collapse;
  }
  .ch-table th,
  .ch-table td {
    padding: 12px 16px 12px 0;
    text-align: left;
    vertical-align: baseline;
    border-bottom: 1px solid var(--color-line);
  }
  .ch-table thead th {
    color: var(--color-ink-2);
    font-weight: 400;
  }
  .ch-before,
  .ch-after {
    white-space: nowrap;
  }
  .ch-before {
    font-size: var(--text-h3-card);
    color: var(--color-ink-2);
  }
  .ch-after {
    font-size: var(--text-h3-card);
    font-weight: 500;
  }
  @media (max-width: 560px) {
    .ch-states thead {
      display: none;
    }
    .ch-states tr {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 12px 0;
      border-bottom: 1px solid var(--color-line);
    }
    .ch-states th,
    .ch-states td {
      border: 0;
      padding: 0;
    }
  }
  @media (max-width: 640px) {
    .ch-compare thead {
      display: none;
    }
    .ch-compare tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 16px;
      padding: 12px 0;
      border-bottom: 1px solid var(--color-line);
    }
    .ch-compare th,
    .ch-compare td {
      border: 0;
      padding: 0;
    }
    .ch-compare th,
    .ch-compare td:last-child {
      grid-column: 1 / -1;
    }
    .ch-before::before {
      content: 'Before ';
      font-family: var(--font-mono);
      font-size: var(--text-caption-sm);
      color: var(--color-ink-2);
    }
    .ch-after::before {
      content: 'After ';
      font-family: var(--font-mono);
      font-size: var(--text-caption-sm);
      color: var(--color-ink-2);
    }
  }

  .ch-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }
  .ch-images img {
