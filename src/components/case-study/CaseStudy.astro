---
/**
 * One case study page: the "Case studies v2" canvas layout (08.x) in v3 house style.
 * Hero band → lead image or audit callout → numbers → Zero Drift steps or a note
 * → what we did → (agentic layer) → working together → what changed → from the work
 * → CTA card and the next case study.
 */
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Gaps from './Gaps.astro';
import Shot from './Shot.astro';
import NamesField from './NamesField.astro';
import QBenchHero from './QBenchHero.astro';
import QBenchWork from './QBenchWork.astro';
import StatusHero from './StatusHero.astro';
import SurfacesField from './SurfacesField.astro';
import TwoSides from './TwoSides.astro';
import Decisions from './Decisions.astro';
import Chapters from './Chapters.astro';
import SectionHead from '../SectionHead.astro';
import MachineView from './MachineView.astro';
import { caseMarkdown } from '../../lib/case-markdown';
import SiteFooter from '../SiteFooter.astro';
import { links } from '../../data/links';
import { caseHref, caseStudies, getCaseStudy, type Band, type CaseStudy } from '../../data/case-studies';

interface Props {
  study: CaseStudy;
}
const { study: s } = Astro.props;
const next = getCaseStudy(s.next);
const prev = caseStudies.find((c) => c.next === s.slug);

// literal class names so Tailwind sees them
const bandBg: Record<Band, string> = {
  lavender: 'bg-lavender',
  sage: 'bg-sage',
  peach: 'bg-peach',
  butter: 'bg-butter',
  mauve: 'bg-mauve',
  stone: 'bg-stone',
};
const band = bandBg[s.band];
const ctaHref = s.cta.action === 'audit' ? '/#audit' : links.bookCall;
const mdHref = `${caseHref(s.slug)}.md`;
const pageUrl = new URL(caseHref(s.slug), Astro.site ?? 'https://nicey-website.vercel.app').href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${s.name}: ${s.statement}`,
  description: s.lede,
  url: pageUrl,
  about: s.kicker.replace('Case study · ', '').split(' · '),
  author: { '@type': 'Organization', name: 'Nicey Studio', url: new URL('/', pageUrl).href },
  mainEntityOfPage: pageUrl,
};
const markdown = caseMarkdown(s, new URL(caseHref(s.slug), Astro.site ?? 'https://nicey-website.vercel.app').href);
---

<Base title={`${s.linkName} case study · Nicey`} description={s.lede} markdownHref={mdHref} jsonLd={jsonLd}>
  <Header variant="case" />
  <main id="main" tabindex="-1" class="cs" data-human>
    <section aria-labelledby="cs-title" class={band}>
      <div class="container-page cs-hero">
        <div class:list={['cs-hero-top', s.heroVisual && 'cs-hero-top--visual']}>
          <div class="cs-hero-copy">
            <span class="caption text-ink-2">{s.kicker}</span>
            <p class="m-0 text-case-name">{s.name}</p>
            <h1 id="cs-title" class="m-0 max-w-[22ch] text-case-h1 text-balance">{s.statement}</h1>
            <p class="m-0 max-w-[52ch] text-body-lg text-pretty text-ink-2"><Gaps text={s.lede} /></p>
          </div>
          {s.heroVisual && (
            <div class="cs-hero-visual">
              {s.heroContext && <p class="cs-hero-context">{s.heroContext}</p>}
              {s.heroVisual === 'qbench-build' ? <QBenchHero /> : <StatusHero />}
            </div>
          )}
        </div>
        <dl class="cs-facts">
          {
            s.facts.map((f) => (
              <div>
                <dt class="caption-sm text-ink-2">{f.term}</dt>
                <dd class="m-0 text-body">
                  <Gaps text={f.detail} />
                </dd>
              </div>
            ))
          }
        </dl>
        {s.who && <p class="m-0 text-body-sm text-ink-2"><Gaps text={s.who} /></p>}
      </div>
    </section>

    {
      !s.lead ? null : s.lead.kind === 'image' ? (
        <section aria-label="Project image" class="container-page cs-lead">
          {s.lead.src ? (
            <Shot shot={s.lead.src} alt={s.lead.alt ?? ''} wide eager />
          ) : (
            <div class="placeholder cs-shot cs-shot--wide">{s.lead.placeholder}</div>
          )}
        </section>
      ) : (
        <section aria-labelledby="audit-head" class="container-page cs-lead">
          <div class="cs-audit bg-band text-on-band">
            <div class="flex max-w-[60ch] flex-col gap-1.5">
              <h2 id="audit-head" class="m-0 text-h3-card">
                {s.lead.heading}
              </h2>
              <p class="m-0 text-body text-on-band-2">{s.lead.text}</p>
            </div>
            <a href="/#audit" class="pill bg-on-band px-[22px] text-body text-band">
              {s.lead.cta}
            </a>
          </div>
        </section>
      )
    }

    <section aria-labelledby="numbers-head" class="container-page cs-block cs-block--md">
      {s.heads?.proof ? (
        <SectionHead id="numbers-head" caption={s.heads.proof.caption} class="mb-12" headingClass="max-w-[18ch]">{s.heads.proof.heading}</SectionHead>
      ) : (
        <h2 id="numbers-head" class:list={['caption m-0 mb-5 text-ink-2', s.proofViz && 'sr-only']}>{s.numbersHeading}</h2>
      )}
      <div class:list={['panel-wrap', s.proofViz && 'panel flex flex-col']}>
        {s.proofViz === 'names' && <NamesField />}
        {s.proofViz === 'surfaces' && <SurfacesField />}
        {!s.proofViz && <ul class:list={['panel', s.numbers.length === 4 ? 'grid-4' : 'grid-3']}>
          {
            s.numbers.map((n) => (
              <li class="cs-num">
                <span class="cs-num-fig">{n.value}</span>
                <span class="text-body-sm text-ink-2">{n.label}</span>
                <span class="cs-num-meaning">{n.meaning}</span>
              </li>
            ))
          }
        </ul>}
      </div>
    </section>

    {
      s.note && (
        <section aria-labelledby="note-head" class="container-page cs-block cs-block--md">
          <div class="panel">
            <div class="cs-note">
              <h2 id="note-head" class="caption m-0 text-ink-2">
                {s.note.heading}
              </h2>
              <p class="m-0 flex-[1_1_420px] text-cta">{s.note.text}</p>
            </div>
          </div>
        </section>
      )
    }

    {s.chapters && <Chapters chapters={s.chapters} marker={band} head={s.heads?.chapters} />}

    {s.decisions && <Decisions heading={s.decisions.heading} head={s.heads?.decisions} items={s.decisions.items} />}

    {!s.chapters && <section aria-labelledby="did-head" class="container-page cs-block cs-split">
      <h2 id="did-head" class="cs-split-head m-0 text-case-h2">What we did</h2>
      <ol class="cs-split-body cs-did">
        {
          s.did.map((d, i) => (
            <li>
              <span class="caption-sm pt-[5px] text-ink-2">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-lede">{d}</span>
            </li>
          ))
        }
      </ol>
    </section>}

    {
      s.agentic && (
        <section aria-labelledby="agentic-head" class="container-page cs-block">
          <div class="cs-agentic bg-band text-on-band">
            <div class="flex flex-col gap-2.5">
              <span class="caption text-on-band-2">{s.agentic.kicker}</span>
              <h2 id="agentic-head" class="m-0 max-w-[26ch] text-case-h2">
                {s.agentic.heading}
              </h2>
            </div>
            <ol class="cs-agentic-list" data-stagger>
              {s.agentic.items.map((it) => (
                <li>
                  <span class="font-mono text-caption text-on-band-accent">{it.label}</span>
                  <span class="text-cta">{it.text}</span>
                </li>
              ))}
            </ol>
            <p class="m-0 max-w-[64ch] text-cta text-on-band-2">{s.agentic.footnote}</p>
          </div>
        </section>
      )
    }

    {
      [
        { id: 'together-head', heading: 'Working together', ...s.together },
        { id: 'changed-head', heading: 'What changed for the team', ...s.changed },
      ].map((b) => (
        <section aria-labelledby={b.id} class="container-page cs-block cs-split">
          <h2 id={b.id} class="cs-split-head m-0 text-case-h2">
            {b.heading}
          </h2>
          <div class="cs-split-body flex flex-col gap-4">
            <p class="m-0 text-lede text-pretty">
              <Gaps text={b.text} />
            </p>
            <p class="cs-collect">
              <span class="caption-sm mb-1.5 block text-ink-2">{b.collect.label}</span>
              {b.collect.text}
            </p>
          </div>
        </section>
      ))
    }

    <section aria-labelledby="work-head" class="container-page cs-block flex flex-col gap-5">
      {s.heads?.work ? (
        <SectionHead id="work-head" caption={s.heads.work.caption} class="mb-7" headingClass="max-w-[18ch]">{s.heads.work.heading}</SectionHead>
      ) : (
        <h2 id="work-head" class="m-0 text-case-h2">{s.workHeading ?? 'From the work'}</h2>
      )}
      {s.workVisual === 'qbench' ? (
        <QBenchWork />
      ) : s.workVisual === 'qbench-status' ? (
        <TwoSides />
      ) : (
      <div class:list={['cs-figs', s.work.length === 2 && 'cs-figs--two']}>
          {
            s.work.map((w, i) => (
              <figure class="m-0 flex flex-col gap-3">
                {w.src ? (
                  <Shot shot={w.src} alt={w.alt ?? ''} />
                ) : (
                  <div class="placeholder cs-shot">{w.placeholder}</div>
                )}
                <figcaption class="flex flex-col gap-1 text-body-sm text-ink-2">
                  <span class="caption-sm text-muted">Fig 0.{i + 1}</span>
                  {w.caption}
                </figcaption>
              </figure>
            ))
          }
        </div>
      )}
    </section>
  </main>

  <section aria-label="Next steps" class="container-page cs-foot" data-human>
    <div class:list={['cs-cta', band]}>
      <div class="cs-cta-copy">
        {s.cta.action === 'audit' && <span class="caption text-ink-2">Free audit · read-only</span>}
        <p class="m-0 text-case-cta">{s.cta.heading}</p>
        <p class="m-0 text-cta text-ink-2">{s.cta.text}</p>
        {s.cta.action === 'audit' && (
          <ul class="cs-cta-gets">
            <li>A score per pillar</li>
            <li>The top findings</li>
            <li>What to fix first</li>
          </ul>
        )}
      </div>
      <div class="cs-cta-act">
        <a href={ctaHref} class="pill pill-ink pill-lg">{s.cta.label}</a>
        {s.cta.action === 'audit' ? (
          <span class="text-body-sm text-ink-2">Only your Figma file. The repo is optional.</span>
        ) : null}
        {s.cta.action === 'audit' && (
          <a href={links.bookCall} class="text-body-sm text-ink underline-offset-4 hover:underline">or book a call →</a>
        )}
      </div>
    </div>
    <a href={caseHref(next.slug)} class="cs-next">
      <span class="cs-next-copy">
        <span class="caption text-ink-2">Next case study</span>
        <span class="cs-next-name">{next.linkName}</span>
        <span class="max-w-[48ch] text-body-lg text-pretty text-ink-2">{next.statement}</span>
      </span>
      <span class="cs-next-side" aria-hidden="true">
        <span class="cs-next-arrow">→</span>
      </span>
    </a>
    <nav aria-label="More case studies" class="cs-more">
      {prev ? (
        <a href={caseHref(prev.slug)} class="cs-more-link">
          <span aria-hidden="true">←</span> Previous: {prev.linkName}
        </a>
      ) : <span />}
      <a href="/#work" class="cs-more-link">All case studies</a>
    </nav>
  </section>
  <MachineView markdown={markdown} mdHref={mdHref} />
  <SiteFooter mdHref={mdHref} />
</Base>

<script>
  // agentic cards: hold them until the list scrolls in, then let the CSS stagger play once
  const lists = document.querySelectorAll<HTMLElement>('[data-stagger]');
  if (lists.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.remove('is-waiting');
          io.unobserve(e.target);
        }),
      { threshold: 0.25 },
    );
    lists.forEach((l) => {
      if (l.getBoundingClientRect().top < innerHeight) return;
      l.classList.add('is-waiting');
      io.observe(l);
    });
  }
</script>

<style>
  /* same rhythm as the home page: --spacing-section between sections (128 / 96 / 72),
     48px from a section heading to its container */
  .cs,
  .cs-foot {
    --cs-lg: var(--spacing-section);
    --cs-md: var(--spacing-section);
    --cs-sm: 48px;
    --cs-head: 48px;
  }

  .cs-hero {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: var(--cs-lg) 56px;
  }
  .cs-hero-top {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .cs-hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }
  @media (min-width: 1100px) {
    .cs-hero-top--visual {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 56px;
    }
  }
  .cs-hero-opt {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cs-hero-opt[hidden] {
    display: none;
  }
  .cs-hero-result {
    font-size: var(--text-lede);
    line-height: 1.35;
    font-weight: 500;
  }
  .cs-hero-points {
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-line-strong);
  }
  .cs-hero-points > div {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .cs-hero-points dt {
    padding-top: 3px;
  }
  @media (max-width: 479px) {
    .cs-hero-points > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
  .cs-hero-context {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .cs-facts {
    margin: 8px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line-strong);
  }
  .cs-facts > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cs-lead {
    padding-top: var(--cs-sm);
  }
  .cs-block {
    padding-top: var(--cs-lg);
  }
  .cs-block--md {
    padding-top: var(--cs-md);
  }

  /* dashed = not collected yet */
  .cs-shot {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    padding: 16px;
    border-radius: var(--radius-panel);
    text-align: center;
  }
  .cs-shot--wide {
    aspect-ratio: 16 / 8;
  }

  .cs-audit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 28px 32px;
    border-radius: var(--radius-panel);
    /* the accent ring is under 3:1 on the band */
    --color-focus: var(--color-on-band);
  }

  .cs-num {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    container-type: inline-size;
  }
  .cs-num-fig {
    /* stays on one line in the narrowest cell: "1,071 → 0", "302 / 302" */
    font-size: min(var(--text-case-figure), 19cqi);
    line-height: var(--text-case-figure--line-height);
    letter-spacing: var(--text-case-figure--letter-spacing);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cs-num-meaning {
    padding-top: 10px;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-body);
    line-height: 1.45;
    font-weight: 500;
  }

  .cs-steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .cs-step {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-size: var(--text-label);
    line-height: var(--text-label--line-height);
  }
  .cs-step--open {
    padding: 7px 13px;
    background: transparent;
    border: 1px dashed var(--color-ink);
    color: var(--color-ink);
  }

  .cs-note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    padding: 24px 28px;
  }

  .cs-split {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
  }
  .cs-split-head {
    flex: 1 1 260px;
  }
  .cs-split-body {
    flex: 999 1 560px;
    min-width: 0;
  }
  .cs-did {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line-strong);
  }
  .cs-did > li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .cs-agentic {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 40px;
    border-radius: var(--radius-panel);
  }
  .cs-agentic-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
    gap: 12px;
  }
  .cs-agentic-list > li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border-radius: var(--radius-code);
    background: color-mix(in srgb, var(--color-on-band) 8%, transparent);
  }
  /* group entrance once, when the cards scroll in: 50ms apart, never blocks reading */
  @media (prefers-reduced-motion: no-preference) {
    .cs-agentic-list.is-waiting > li {
      opacity: 0;
      transform: translateY(8px);
    }
    .cs-agentic-list > li {
      transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out);
    }
    .cs-agentic-list > li:nth-child(2) { transition-delay: 50ms; }
    .cs-agentic-list > li:nth-child(3) { transition-delay: 100ms; }
    .cs-agentic-list > li:nth-child(4) { transition-delay: 150ms; }
    .cs-agentic-list > li:nth-child(5) { transition-delay: 200ms; }
  }

  .cs-collect {
    margin: 0;
    padding: 18px 20px;
    border: 1px dashed var(--color-dashed);
    border-radius: var(--radius-panel);
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .cs-figs.cs-figs--two {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .cs-figs.cs-figs--two {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 2fr);
      align-items: start;
    }
  }
  .cs-figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }

  .cs-foot {
    padding-block: var(--cs-lg);
  }
  .cs-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 40px;
    border-radius: var(--radius-panel);
  }
  .cs-cta-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 46ch;
  }
  .cs-cta-gets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .cs-cta-gets > li {
    padding: 6px 12px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-body-sm);
  }
  .cs-cta-gets > li::before {
    content: '✓ ';
    color: var(--color-accent);
  }
  .cs-cta-act {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  /* the next case study is a second path, not a second card: an open row between two lines */
  .cs-next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    margin-top: 56px;
    padding-block: 32px;
    border-top: 1px solid var(--color-line-strong);
    border-bottom: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    text-decoration: none;
  }
  .cs-next-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .cs-next-name {
    width: fit-content;
    font-size: clamp(32px, 4.4vw, 60px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
    transition: text-decoration-color 200ms var(--ease-out);
  }
  .cs-next-side {
    flex: none;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .cs-more {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 18px;
  }
  .cs-more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    color: var(--color-ink-2);
    font-size: var(--text-body-sm);
    text-decoration: none;
    transition: color 200ms var(--ease-out);
  }
  .cs-more-link span {
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .cs-more-link:hover {
