---
/**
 * The homepage fork: two practices with equal weight, each leading to its
 * own page. Copy lives in data/practices.ts.
 */
import SectionHead from './SectionHead.astro';
import { practices } from '../data/practices';
import { markerBg } from '../data/zero-drift';
---

<section id="services" aria-labelledby="services-head" class="container-page flex flex-col gap-12 pb-section">
  <!-- draft heading: replaces "Design systems first. Product design alongside." -->
  <SectionHead id="services-head" caption="What we help with" headingClass="max-w-heading">
    Two practices. One system underneath.
  </SectionHead>
  <div class="panel flex flex-wrap">
    {
      practices.map((p, i) => (
        <article class="svc">
          <span class="caption flex items-center gap-2 text-ink-2">
            <i aria-hidden="true" class:list={['marker', markerBg[p.marker]]} />
            {String(i + 1).padStart(2, '0')} · Practice
          </span>
          <h3 class="m-0 text-h3">{p.name}</h3>
          <p class="m-0 max-w-copy text-body-lg text-pretty text-ink-2">{p.pitch}</p>
          <ul class="svc-list">
            {p.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a href={p.href} class="svc-link mt-auto">
            Explore {p.name.toLowerCase()} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  .svc {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: var(--spacing-cell);
  }
  .svc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }
  .svc-list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: var(--text-body);
  }
  .svc-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 44px;
    font-size: var(--text-body-lg);
    font-weight: 500;
    color: var(--color-ink);
    text-underline-offset: 4px;
  }
  .svc-link span {
    display: inline-block;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .svc-link span {
      transition: transform var(--duration-fast) var(--ease-out);
    }
    .svc-link:hover span {
      transform: translateX(4px);
    }
  }
</style>
