---
import { links } from '../data/links';
---

<footer class="closing bg-band text-on-band">
  <div class="container-page flex flex-col items-start gap-6 py-section">
    <span class="caption text-on-band-2">Free audit · read-only</span>
    <h2 class="m-0 max-w-[12ch] text-h1">Send us the system you have.</h2>
    <p class="m-0 text-sub text-on-band-2">We will show you the one you should.</p>
    <div class="mt-4 flex flex-wrap gap-2.5">
      <a href="#audit" class="pill pill-lg bg-on-band text-band">Get a free audit</a>
      <a href={links.bookCall} class="pill pill-lg border border-on-band px-[23px] py-[15px] text-on-band"
        >Book a call</a
      >
    </div>
  </div>
</footer>

<style>
  /* the accent ring is under 3:1 on the day band, so the ring turns cream here */
  .closing {
    --color-focus: var(--color-on-band);
  }
</style>
