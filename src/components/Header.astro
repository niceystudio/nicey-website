---
import { links } from '../data/links';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** 'case': the case study nav from canvas 08.x (← All work, Free audit) */
  variant?: 'home' | 'case';
}
const { variant = 'home' } = Astro.props;

const nav =
  variant === 'case'
    ? [{ href: '/#work', label: '← All work' }]
    : [
        { href: '/#work', label: 'Work' },
        { href: links.productDesign, label: 'Product design' },
        { href: links.agenticDesignSystems, label: 'Agentic design systems' },
        { href: '/#how', label: 'How we work' },
      ];
// a practice page marks its own nav item
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => !href.includes('#') && href === path;
const audit = variant === 'case' ? '/#audit' : '#audit';
---

<a href="#main" class="skip-link pill pill-ink">Skip to content</a>
<header class="border-b border-line">
  <nav
    aria-label="Main"
    class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4"
  >
    <a
      href={links.home}
      class="wordmark text-ink no-underline"
      >nicey<span class="text-accent">.</span></a
    >
    <div class="flex flex-wrap items-center gap-x-1 gap-y-1 text-body-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <div class="ml-3 flex items-center gap-2">
        <a href={audit} class="pill pill-ink">Free audit</a>
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<style>
  .wordmark {
    font-size: var(--text-h4);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    text-decoration: none;
  }
  /* the page you're on: a quiet filled pill */
  .nav-link[aria-current='page'] {
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  @media (hover: hover) {
    .nav-link:not([aria-current='page']):hover {
      background: var(--color-surface-hover);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .nav-link {
      transition: background-color var(--duration-fast) var(--ease-out);
    }
  }
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 50;
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
  }
</style>
