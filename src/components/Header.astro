---
import { links } from '../data/links';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** 'case': pages other than the homepage, so section links point back to it */
  variant?: 'home' | 'case';
}
const { variant = 'home' } = Astro.props;

// one menu on every page (Emir, 11 Nov); on other pages the links go back to the homepage sections
const base = variant === 'case' ? '/' : '';
const nav = [
  { href: `${base}#services`, label: 'Design systems' },
  { href: `${base}#services`, label: 'Product design' },
  { href: `${base}#work`, label: 'Work' },
  { href: `${base}#how`, label: 'How we work' },
];
const audit = variant === 'case' ? '/#audit' : '#audit';
---

<a href="#main" class="skip-link pill pill-ink px-[18px] text-label">Skip to content</a>
<header class="border-b border-line">
  <nav
    aria-label="Main"
    class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4"
  >
    <a
      href={links.home}
      class="text-[22px] leading-none font-semibold tracking-[-0.04em] text-ink no-underline"
      >nicey<span class="text-accent">.</span></a
    >
    <div class="flex flex-wrap items-center gap-x-6 gap-y-1 text-body-sm">
      {
        nav.map((item) => (
          <a href={item.href} class="py-3 text-ink no-underline">
            {item.label}
          </a>
        ))
      }
      <div class="flex items-center gap-2">
        <a href={audit} class="pill pill-ink px-[18px] py-3">Free audit</a>
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 50;
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
  }
</style>
