---
import { links } from '../data/links';
import ThemeToggle from './ThemeToggle.astro';
import Button from './ui/Button.astro';

interface Props {
  /** 'case': pages other than the homepage, so section links point back to it */
  variant?: 'home' | 'case';
  /** where "home" is: '/' on the site; can be overridden */
  home?: string;
}
const { variant = 'home', home = '/' } = Astro.props;

// one menu on every page (Emir, 11 Nov); on other pages the links go back to the homepage sections
const base = variant === 'case' ? home : '';
// nav A (Emir, 13 Nov), plain since 16 Nov: no numbers, no reading line (it didn't work on the case pages).
// Goran 27 Nov: the two service pages lead the menu, then the homepage sections.
const nav = [
  { label: 'Design systems', href: links.exploreDesignSystems },
  { label: 'Product design', href: links.exploreProductDesign },
  ...[
    { id: 'work', label: 'Work' },
    { id: 'how', label: 'How we work' },
    { id: 'faq', label: 'FAQ' },
  ].map((n) => ({ label: n.label, href: `${base}#${n.id}` })),
];
const path = Astro.url.pathname.replace(/\/$/, '');
const current = (href: string) => (href.startsWith('/') && path === href ? 'page' : undefined);
const audit = variant === 'case' ? `${home}#audit` : '#audit';
---

<a href="#main" class="skip-link pill pill-ink px-[18px] text-label">Skip to content</a>
<!-- 27 Nov ("two worlds", after contentarchitecture.dev): one floating capsule from the agent world, over both
     worlds: wordmark, links, Free audit and the theme. .world-dark remaps the tokens inside it, so the button and the
     toggle restyle themselves. A thin dither ring frames it. -->
<header class="site-head" data-site-head>
  <div class="cap-ring">
    <nav aria-label="Main" class="cap world-dark">
      <a href={home === '/' ? links.home : home} class="cap-mark hit no-underline">nicey<span class="cap-dot">.</span></a>
      <div class="head-row head-links">
        {
          nav.map((item) => (
            <a href={item.href} class="head-link" aria-current={current(item.href)}>
              {item.label}
            </a>
          ))
        }
      </div>
      <div class="cap-end">
        <Button href={audit} size="sm">Free audit</Button>
        <span class="head-row"><ThemeToggle /></span>
        <button
          type="button"
          class="menu-btn head-compact"
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label="Menu"
          data-menu-btn
        >
          <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
        </button>
      </div>
    </nav>
    <div id="site-menu" class="menu-panel world-dark" data-menu hidden>
      <ul class="m-0 flex list-none flex-col p-0">
        {
          nav.map((item) => (
            <li class="border-b border-line">
              <a href={item.href} class="menu-link text-ink no-underline" aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center justify-between pt-4">
        <span class="caption text-ink-2">Theme</span>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 50;
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: none;
  }
  /* floats on top while you scroll; the bar itself is transparent and lets clicks through, only the capsule takes them */
  .site-head {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--head-h);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: var(--spacing-sm) var(--spacing-gutter) 0;
    pointer-events: none;
  }
  .cap-ring {
    position: relative;
    pointer-events: auto;
    padding: 3px;
    border-radius: calc(var(--radius-code) + 3px);
    /* the dither ring: a 2px checker of two near-blacks */
    background: repeating-conic-gradient(#3b3a34 0 25%, #151512 0 50%) 0 0 / 3px 3px;
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.45);
    max-width: 100%;
  }
  .cap {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: 6px 6px 6px var(--spacing-sm);
    border-radius: var(--radius-code);
    background: var(--color-page);
  }
  .cap-mark {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-ink);
    margin-right: var(--spacing-xs);
  }
  .cap-dot {
    color: var(--color-accent);
  }
  .cap-end {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: var(--spacing-2xs);
  }
  .cap-end :global(.theme-toggle) {
    border-color: transparent;
    width: 40px;
    height: 40px;
  }
  .head-links {
    align-items: center;
    gap: 2px;
  }
  .head-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--spacing-xs);
    border-radius: var(--radius-chip);
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    transition:
      color 160ms var(--ease-out),
      background-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .head-link:hover {
      color: var(--color-ink);
      background: var(--color-surface-hover);
    }
  }
  .head-link[aria-current='page'] {
    color: var(--color-ink);
    background: var(--color-surface-hover);
  }
  .head-link:active {
    transform: scale(var(--scale-press));
  }
  .head-link:focus-visible,
  .cap-mark:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }
  .head-row {
    display: none;
  }
  .head-compact {
    display: inline-flex;
  }
  @media (min-width: 1100px) {
    .head-row {
      display: flex;
    }
    .head-compact {
      display: none !important;
    }
    .menu-panel {
      display: none !important;
    }
  }
  .menu-btn {
    flex-shrink: 0; /* 320: it was squeezed to 18px next to A's wider Free audit (20 Nov review) */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: var(--radius-chip);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .menu-icon {
    position: relative;
    width: 16px;
    height: 10px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 200ms var(--ease-out); /* transform only: it animated `top` (20 Nov motion review) */
  }
  .menu-icon span:first-child {
    top: 0;
  }
  .menu-icon span:last-child {
    top: calc(100% - 1.5px);
  }
  /* open: the two lines turn into an x */
  /* the 10px icon: lines at 0 and 8.5px, each moves 4.25px to the middle, then turns */
  .menu-btn[aria-expanded='true'] .menu-icon span:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-icon span:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }
  .menu-panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    padding: var(--spacing-xs) var(--spacing-md) var(--spacing-md);
    border-radius: var(--radius-code);
    background: var(--color-page);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.45);
  }
  .menu-panel:not([hidden]) {
    animation: menu-in 200ms var(--ease-out) both;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-panel:not([hidden]) {
      animation-name: menu-fade;
    }
    @keyframes menu-fade {
      from {
        opacity: 0;
      }
    }
    .menu-icon span {
      transition: none;
    }
  }
  .menu-link {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-xs);
    padding-block: var(--spacing-sm);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-site-head]').forEach((head) => {
    const btn = head.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const panel = head.querySelector<HTMLElement>('[data-menu]');
    if (!btn || !panel) return;
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      panel.hidden = !open;
    };
    btn.addEventListener('click', () => set(panel.hasAttribute('hidden')));
    // close on a link, on Esc, on a tap outside, and when the window grows past the phone layout
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        set(false);
        btn.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !head.contains(e.target as Node)) set(false);
    });
    matchMedia('(min-width: 1100px)').addEventListener('change', (m) => m.matches && set(false));
  });

</script>
