---
import SectionHead from './SectionHead.astro';
import type { WorkRow } from '../data/work';

interface Props {
  rows: WorkRow[];
  caption?: string;
  heading?: string;
}
const { rows, caption = 'Work', heading = 'Systems and products we have built' } = Astro.props;
---

<section id="work" aria-labelledby="work-head" class="container-page flex flex-col gap-12 pb-section">
  <SectionHead id="work-head" caption={caption}>{heading}</SectionHead>
  <ul class="panel flex flex-col">
    {
      rows.map((r) => (
        <li>
          <a href={r.href} class="work-row">
            <span class="work-name flex flex-col gap-2.5">
              <span class="text-h3">{r.name}</span>
              <span class="caption text-ink-2">{r.meta}</span>
            </span>
            <span class="work-fig flex flex-col gap-2">
              {r.figure ? (
                <span class="text-h3 whitespace-nowrap tabular-nums">
                  {r.figure.value}
                  {r.figure.to && (
                    <>
                      {' '}
                      <span class="text-muted">→</span> {r.figure.to}
                    </>
                  )}
                </span>
              ) : (
                <span class="placeholder self-start px-3 py-2">[result to collect]</span>
              )}
              <span class:list={['caption', r.figure ? 'text-hot' : 'text-muted']}>{r.caption}</span>
            </span>
            <span class="work-desc max-w-copy text-body text-pretty text-ink-2">{r.description}</span>
            <span class="work-arr" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 16px 40px;
    padding: 36px var(--spacing-cell);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
  }
  .work-name {
    flex: 1 1 220px;
  }
  .work-fig {
    flex: 0 1 220px;
  }
  .work-desc {
    flex: 1 1 300px;
  }
  .work-arr {
    flex: 0 0 auto;
    font-size: var(--text-h4);
    line-height: 1;
    color: var(--color-ink);
  }
  @media (hover: hover) {
    .work-row:hover {
      background: var(--color-surface-hover);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .work-row {
      transition: background-color var(--duration-fast) var(--ease-out);
    }
    .work-arr {
      transition: transform var(--duration-fast) var(--ease-out);
    }
    .work-row:hover .work-arr {
      transform: translateX(4px);
    }
  }
  @media (max-width: 479px) {
    .work-row {
      padding-block: 28px;
    }
  }
</style>
