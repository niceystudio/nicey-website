---
/**
 * "Copy prompt for your agent" (idea 2 from the 11 Nov research, Clerk; placed in the free-audit section, 12 Nov).
 * 24 Nov (Emir): a secondary button (pill-outline) instead of the dashed chip.
 * One click puts a prompt on the clipboard that points the visitor's own coding agent at /ai-ready.md.
 */
import { aiReadyPrompt } from '../lib/ai-ready';

import { SITE } from '../lib/site';
interface Props {
  /** Show the /ai-ready.md link next to the button (Direction A hides it — Emir, 20 Nov). */
  showFile?: boolean;
}
const { showFile = true } = Astro.props;
const prompt = aiReadyPrompt((Astro.site ?? SITE));
---

<div class="cp">
  <button type="button" class="cp-btn pill pill-outline pill-lg" data-copy-prompt={prompt}>
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
      ><rect x="5" y="5" width="9" height="9" rx="2"></rect><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"></path></svg
    >
    <span data-copy-label>Copy prompt for your agent</span>
  </button>
  {/* hidden in A, but it comes back if copying fails: the way to recover (20 Nov review) */}
  <a href="/ai-ready.md" class="hit cp-file" hidden={!showFile} data-copy-file>/ai-ready.md</a>
  <span class="sr-only" aria-live="polite" data-copy-live></span>
</div>

<style>
  .cp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }
  /* the site's secondary button (pill-outline, same size as Get a free audit), with the copy icon (Emir 24 Nov) */
  .cp-btn {
    cursor: pointer;
  }
  .cp-btn.is-done {
    border-color: var(--color-ink);
  }
  .cp-file {
    color: var(--color-ink-2);
    text-underline-offset: 3px;
  }
</style>

<script>
  import { track } from '../lib/track';

  document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
    const live = btn.parentElement?.querySelector<HTMLElement>('[data-copy-live]');
    let t = 0;
    btn.addEventListener('click', async () => {
      let ok = true;
      try {
        await navigator.clipboard.writeText(btn.dataset.copyPrompt ?? '');
      } catch {
        ok = false;
      }
      label.textContent = ok ? 'Copied. Paste it into your agent' : "Couldn't copy. Open the prompt file instead";
      if (live) live.textContent = label.textContent;
      btn.classList.toggle('is-done', ok);
      clearTimeout(t);
      // failure: show the file link and keep the message until the next click
      if (!ok) {
        btn.parentElement?.querySelector<HTMLElement>('[data-copy-file]')?.removeAttribute('hidden');
        return;
      }
      track('prompt_copied');
      t = window.setTimeout(() => {
        label.textContent = 'Copy prompt for your agent';
        btn.classList.remove('is-done');
      }, 2200);
    });
  });
</script>
