---
import StatRow from './StatRow.astro';

const NOTE_BEFORE =
  'Years without a designer. Every screen was a developer’s best guess, built on eleven libraries.';
const NOTE_AFTER = 'One semantic token system, and zero outside references left across 141 components.';
const READOUT_BEFORE = '11 libraries · 141 components';
const READOUT_AFTER = '0 outside libraries · 141 components';
---

<section aria-labelledby="proof-label" class="container-page pb-section">
  <div class="panel panel-wrap flex flex-col">
    <div class="proof-hero" data-proof>
      <div class="proof-copy">
        <span class="caption flex items-center gap-2 text-hot"
          ><i aria-hidden="true" class="block size-[7px] rounded-full bg-hot"></i>QBench · Design system</span
        >
        <p class="proof-figure" aria-hidden="true" data-figure>1,071</p>
        <p class="sr-only" aria-live="polite" data-figure-live>1,071</p>
        <h2 id="proof-label" class="m-0 mt-6 text-title">references to outside libraries</h2>
        <p
          class="proof-note m-0 mt-3 min-h-[3.2em] max-w-[34ch] text-pretty text-ink-2"
          data-note
          data-before={NOTE_BEFORE}
          data-after={NOTE_AFTER}
        >
          {NOTE_BEFORE}
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3 pt-9">
          <div role="group" aria-label="Show state" class="seg">
            <button type="button" data-state="0" aria-pressed="true">Before</button>
            <button type="button" data-state="1" aria-pressed="false">After</button>
          </div>
          <span
            class="caption text-muted tabular-nums"
            data-readout
            data-before={READOUT_BEFORE}
            data-after={READOUT_AFTER}>{READOUT_BEFORE}</span
          >
        </div>
      </div>
      <div class="proof-field-col">
        <div class="proof-field" data-field>
          <canvas
            role="img"
            aria-label="1,071 cells, one per outside-library reference, resolving into a block of 141 components on one token system"
          ></canvas>
          <span class="block-label" aria-hidden="true" data-block-label
            >141 components<br /><span class="text-muted">one semantic token system</span></span
          >
        </div>
      </div>
    </div>
    <StatRow />
  </div>
</section>

<style>
  .proof-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
  }
  .proof-copy {
    flex: 1 1 380px;
    min-width: 0;
    padding: var(--spacing-cell-lg) var(--spacing-cell-lg) var(--spacing-cell);
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }
  .proof-figure {
    margin: 32px 0 0 -0.05em;
    /* never wider than the column, even at 320px */
    font-size: min(var(--text-display-figure), 36cqi);
    line-height: var(--text-display-figure--line-height);
    letter-spacing: var(--text-display-figure--letter-spacing);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  @media (prefers-reduced-motion: no-preference) {
    .proof-note {
      transition: opacity 0.2s ease;
    }
  }

  .seg {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
  }
  .seg button {
    position: relative;
    min-height: 38px;
    padding: 0 18px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink-2);
    font-size: var(--text-label);
    font-weight: 500;
    cursor: pointer;
  }
  /* 44px hit area without changing the drawn control */
  .seg button::before {
    content: '';
    position: absolute;
    inset: -3px 0;
  }
  .seg button[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .proof-hero .seg button:focus-visible {
    outline-offset: 2px;
  }

  .proof-field-col {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
  }
  .proof-field {
    position: relative;
    flex: 1;
    min-height: 420px;
    padding: 72px 40px 0 0;
  }
  .proof-field canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .block-label {
    position: absolute;
    left: 0;
    bottom: 0;
    font-family: var(--font-mono);
    font-size: var(--text-caption-sm);
    line-height: 1.5;
    white-space: nowrap;
    color: var(--color-ink-2);
    opacity: 0;
    pointer-events: none;
  }
  .block-label:global(.is-shown) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .block-label:global(.is-shown) {
      transition: opacity 0.4s ease;
    }
  }

  /* stacked: the field moves under the copy */
  @container panel (max-width: 899.98px) {
    .proof-field {
      min-height: 0;
      height: clamp(260px, 60cqi, 380px);
      padding: 8px var(--spacing-gutter) 0;
    }
  }
</style>

<script>
  import { mountProofField } from '../lib/proof-field';
  document.querySelectorAll<HTMLElement>('[data-proof]').forEach(mountProofField);
</script>
