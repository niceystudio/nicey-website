---
/**
 * "Change the style", floating bottom right on every page (24 Nov; styles 25 Nov). Pick one of three styles and the
 * whole site follows: a style overrides a handful of tokens from src/styles/global.css on :root (display face, accent,
 * corners), so every component, every page and /brand change at once and no component is edited — the point of an
 * agent-ready system.
 *
 * Styles: src/data/token-presets.ts. The panel logs the change the way an agent would report it: the command, one row
 * per token edited (from → to), and the count. The choice is remembered in this browser (localStorage) and applied
 * before first paint by Base.astro, so pages don't flash the default. After a change it fires `nicey:tokens` on window
 * (the homepage band re-reads its rows on it) and says what changed in a live region.
 * Keyboard: the button opens the panel and focus moves into it; Escape or the close button returns focus.
 */
import { styles } from '../../data/token-presets';
---

<div class="ts" data-ts>
  <div class="ts-panel" id="ts-panel" role="dialog" aria-modal="false" aria-labelledby="ts-title" hidden data-ts-panel>
    <div class="ts-head">
      <p id="ts-title" class="ts-title m-0">Change the style</p>
      <button type="button" class="ts-close" aria-label="Close" data-ts-close>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" /></svg>
      </button>
    </div>
    <p class="ts-lede m-0">Three styles, one system. Each is a few token edits. No component changes.</p>

    <div class="ts-cards" role="group" aria-label="Style">
      {
        styles.map((s, i) => (
          <button
            type="button"
            class="ts-card"
            style={`--f:${s.font.stack};--sw-l:${s.accent.light};--r:${s.radius.pill};--rc:${s.radius.code}`}
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-style={s.id}
          >
            <span class="ts-card-view" aria-hidden="true">
              <span class="ts-card-aa">Aa</span>
              <span class="ts-card-bar" />
            </span>
            <span class="ts-card-name">{s.label}</span>
            <span class="ts-card-note">{s.note}</span>
          </button>
        ))
      }
    </div>

    <!-- the agent's report of the last change; written by the script below -->
    <div class="term ts-log" aria-hidden="true">
      <pre class="term-body" data-ts-log></pre>
    </div>

    <div class="ts-foot">
      <button type="button" class="ts-reset" data-ts-reset>Reset</button>
      <span class="ts-note">Remembered in this browser</span>
    </div>
    <p class="sr-only" aria-live="polite" data-ts-live></p>
  </div>

  <button type="button" class="ts-btn" aria-expanded="false" aria-controls="ts-panel" data-ts-open>
    <span class="ts-icon" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span class="ts-btn-label">Change the style</span>
  </button>
</div>

<style>
  .ts {
    position: fixed;
    right: var(--spacing-md);
    bottom: var(--spacing-md);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--spacing-xs);
  }
  /* ---------- the button ---------- */
  .ts-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    min-height: 48px;
    padding: 0 var(--spacing-sm) 0 14px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
    box-shadow: var(--shadow-window);
    cursor: pointer;
    transition:
      border-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .ts-btn:active {
    transform: scale(var(--scale-press));
  }
  @media (hover: hover) and (pointer: fine) {
    .ts-btn:hover {
      border-color: var(--color-ink);
    }
  }
  /* a 2×2 of system pieces: the accent and the corners of the live style */
  .ts-icon {
    display: grid;
    grid-template-columns: repeat(2, 8px);
    gap: 3px;
  }
  .ts-icon i {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-swatch);
    background: var(--color-ink);
  }
  .ts-icon i:first-child {
    background: var(--color-accent);
  }
  @media (max-width: 639px) {
    .ts {
      right: var(--spacing-sm);
      bottom: var(--spacing-sm);
    }
    /* phone: the icon alone, still a 48px target; the label stays for screen readers */
    .ts-btn {
      width: 48px;
      padding: 0;
      justify-content: center;
    }
    .ts-btn-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* ---------- the panel ---------- */
  .ts-panel {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    width: min(380px, calc(100vw - 2 * var(--spacing-sm)));
    max-height: calc(100dvh - 48px - 3 * var(--spacing-md));
    overflow-y: auto;
    padding: var(--spacing-md);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: var(--shadow-window);
  }
  .ts-panel[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ts-panel:not([hidden]) {
      animation: ts-in 180ms var(--ease-out);
    }
  }
  @keyframes ts-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .ts-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xs);
  }
  .ts-title {
    font-family: var(--font-display);
    font-size: var(--text-h3-card);
    line-height: 1.1;
  }
  .ts-close {
    display: grid;
    place-items: center;
    width: var(--hit-min);
    height: var(--hit-min);
    margin-right: calc(-1 * var(--spacing-xs));
    border: 0;
    background: transparent;
    color: var(--color-ink-2);
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) {
    .ts-close:hover {
      color: var(--color-ink);
    }
  }
  .ts-lede {
    font-size: var(--text-body-sm);
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  /* three cards: each previews its own face, accent and corner, whatever style is live */
  .ts-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-2xs);
  }
  .ts-card {
    --sw: var(--sw-l);
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--spacing-3xs);
    padding-bottom: var(--spacing-2xs);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-code);
    background: transparent;
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
    transition:
      border-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .ts-card:active {
    transform: scale(var(--scale-press));
  }
  .ts-card[aria-pressed='true'] {
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .ts-card[aria-pressed='false']:hover {
      border-color: var(--color-ink-2);
    }
  }
  .ts-card-view {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--spacing-2xs);
    height: 72px;
    margin-bottom: var(--spacing-3xs);
    padding: var(--spacing-2xs);
    border-radius: min(var(--rc), 8px);
    background: var(--color-page);
  }
  .ts-card-aa {
    font-family: var(--f);
    font-size: 28px;
    line-height: 1;
  }
  .ts-card-bar {
    width: 32px;
    height: 10px;
    border-radius: var(--r);
    background: var(--sw);
  }
  .ts-card-name {
    padding-inline: var(--spacing-3xs);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 500;
  }
  .ts-card-note {
    padding-inline: var(--spacing-3xs);
    font-family: var(--font-mono);
    font-size: var(--text-caption-sm);
    line-height: 1.35;
    color: var(--color-muted);
  }
  /* the agent's report: the shared terminal window, flat inside the panel, tall enough that it never resizes */
  .ts-log {
    flex: none;
    box-shadow: none;
  }
  .ts-log .term-body {
    min-height: calc(6 * 1.6em + 2 * var(--spacing-xs));
    padding: var(--spacing-xs);
    font-size: var(--text-caption-sm);
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* rows are written by the script, so they are styled from outside the component's scope */
  .ts-log :global(.ts-l) {
    display: grid;
    grid-template-columns: 2ch 13ch minmax(0, 1fr);
  }
  .ts-log :global(.ts-l > :first-child:last-child) {
    grid-column: 1 / -1;
  }
  .ts-log :global(.ts-dim) {
    color: var(--color-term-muted);
  }
  .ts-log :global(.ts-acc) {
    color: var(--color-term-accent);
  }
  .ts-log :global(.ts-ok) {
    color: var(--color-term-ok);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ts-log :global(.ts-l) {
      animation: ts-line 200ms var(--ease-out);
    }
  }
  @keyframes ts-line {
    from {
      opacity: 0;
      transform: translateY(2px);
    }
  }
  .ts-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xs);
    padding-top: var(--spacing-2xs);
    border-top: 1px solid var(--color-rule);
  }
  .ts-reset {
    min-height: var(--hit-min);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .ts-note {
    font-family: var(--font-mono);
    font-size: var(--text-caption-sm);
    color: var(--color-muted);
  }
  @media print {
    .ts {
      display: none;
    }
  }
</style>

<script>
  import { styles, styleById, overrideCss, edits, STORAGE_KEY, CHANGE_EVENT } from '../../data/token-presets';

  const root = document.querySelector<HTMLElement>('[data-ts]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('[data-ts-panel]')!;
    const open = root.querySelector<HTMLButtonElement>('[data-ts-open]')!;
    const close = root.querySelector<HTMLButtonElement>('[data-ts-close]')!;
    const live = root.querySelector<HTMLElement>('[data-ts-live]')!;
    const log = root.querySelector<HTMLElement>('[data-ts-log]')!;
    const cards = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-style]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const read = (): string => {
      try {
        return styleById(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}').style).id;
      } catch {
        return styles[0].id;
      }
    };
    let state = read();

    const styleEl = () => {
      let el = document.getElementById('token-override') as HTMLStyleElement | null;
      if (!el) {
        el = document.createElement('style');
        el.id = 'token-override';
        document.head.appendChild(el);
      }
      return el;
    };
    const paint = () => cards.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.style === state)));

    // ---------- the log: what an agent would report ----------
    // a line is plain text, or mark + token + value in three columns
    type Line = { text: string; tone?: 'dim' | 'ok' } | { mark: string; key: string; value: string };
    let timers: number[] = [];
    const span = (text: string, cls = '') => Object.assign(document.createElement('span'), { textContent: text, className: cls });
    const write = (lines: Line[]) => {
      timers.forEach((t) => window.clearTimeout(t));
      timers = [];
      log.textContent = '';
      log.classList.toggle('term-cursor', !reduced);
      lines.forEach((line, i) => {
        const add = () => {
          const row = span('', 'ts-l');
          if ('text' in line) {
            if (line.tone) row.classList.add(`ts-${line.tone}`);
            row.append(span(line.text));
          } else row.append(span(line.mark, 'ts-acc'), span(line.key), span(line.value));
          log.append(row);
          if (i === lines.length - 1) log.classList.remove('term-cursor');
        };
        if (reduced) add();
        else timers.push(window.setTimeout(add, i * 110));
      });
    };
    // the five radius tokens move together: one row, the distinct values in order
    const list = (xs: string[]) => Array.from(new Set(xs)).join(' / ');
    const status = () => {
      const s = styleById(state);
      write([
        { text: '$ nicey status' },
        { mark: ' ', key: 'style', value: s.id + (s.id === styles[0].id ? ' (shipped)' : '') },
        { mark: ' ', key: 'font.display', value: s.font.name },
        { mark: ' ', key: 'color.accent', value: s.accent.light },
        { mark: ' ', key: 'radius.*', value: list(Object.values(s.radius)) },
        { text: 'pick a style to see the edit', tone: 'dim' },
      ]);
    };
    const report = (fromId: string, toId: string) => {
      const to = styleById(toId);
      const all = edits(styleById(fromId), to);
      const radius = all.filter((e) => e.token.startsWith('radius.'));
      const rows: Line[] = all
        .filter((e) => !e.token.startsWith('radius.'))
        .map((e) => ({ mark: '~', key: e.token, value: `${e.from} → ${e.to}` }));
      if (radius.length)
        rows.push({
          mark: '~',
          key: `radius.* ×${radius.length}`,
          value: `${list(radius.map((e) => e.from))} → ${list(radius.map((e) => e.to))}`,
        });
      write([
        { text: `$ nicey apply ${to.id}` },
        ...rows,
        { text: `✓ ${all.length} tokens edited · 0 components touched`, tone: 'ok' },
        { text: 'every page re-read the system', tone: 'dim' },
      ]);
      return all.length;
    };

    const apply = (next: string) => {
      if (next === state) return;
      const prev = state;
      state = next;
      styleEl().textContent = overrideCss(state);
      try {
        if (state === styles[0].id) localStorage.removeItem(STORAGE_KEY);
        else localStorage.setItem(STORAGE_KEY, JSON.stringify({ style: state }));
      } catch {}
      paint();
      const n = report(prev, state);
      const s = styleById(state);
      live.textContent = `${s.label} style: ${s.font.name} headlines, ${n} tokens edited, no components touched. Every page updated.`;
      window.dispatchEvent(new CustomEvent(CHANGE_EVENT, { detail: { style: state } }));
    };

    const setOpen = (on: boolean, focus = true) => {
      panel.hidden = !on;
      open.setAttribute('aria-expanded', String(on));
      if (on && focus) (cards.find((b) => b.getAttribute('aria-pressed') === 'true') ?? cards[0]).focus();
      if (!on && focus) open.focus();
    };

    paint();
    status();
    open.addEventListener('click', () => setOpen(panel.hasAttribute('hidden')));
    close.addEventListener('click', () => setOpen(false));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hasAttribute('hidden')) {
        e.preventDefault();
        setOpen(false);
      }
    });
    document.addEventListener('pointerdown', (e) => {
      if (!panel.hasAttribute('hidden') && !root.contains(e.target as Node)) setOpen(false, false);
    });
    cards.forEach((b) => b.addEventListener('click', () => apply(b.dataset.style!)));
    root.querySelector('[data-ts-reset]')!.addEventListener('click', () => apply(styles[0].id));
  }
</script>
